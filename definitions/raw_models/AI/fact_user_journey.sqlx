config {
    type: 'table',
    name: "fact_user_journey",
    description: `last 30 days | PIC: tu.dang; schedule: 0h00 daily; model type: table
    Source:
        ${source.silver}.monitoring_prd_collector_user_stats_*`,
    columns: {

            },
tags: ['2h00']
    ,bigquery: {
        partitionBy: "date(first_occurrence_time)"
    },
}



WITH numbered_events AS (
  SELECT 
    created_date,
    created_time, 
    event, 
    customer_id, 
    platform,
    session,
    ROW_NUMBER() OVER(PARTITION BY customer_id, session ORDER BY created_time) as event_sequence 
  FROM ${ref(`fact_user_event_tracking`)}
  WHERE 
--   created_date = "2024-10-20" AND 
  session IS NOT NULL AND event not IN ( 'CUSTOMER_OPEN_APP', 'LOGIN') and customer_id > 0
),

event_changes AS (
  SELECT 
    *,
    LAG(event) OVER (
      PARTITION BY session
      ORDER BY event_sequence
    ) as previous_event,
    CASE 
      WHEN event != LAG(event) OVER (
        PARTITION BY session 
        ORDER BY event_sequence
      ) 
      OR LAG(event) OVER (
        PARTITION BY session
        ORDER BY event_sequence
      ) IS NULL 
      THEN 1 
      ELSE 0 
    END as is_new_event
  FROM numbered_events
),

event_groups AS (
  SELECT 
    *,
    SUM(is_new_event) OVER (
      PARTITION BY session
      ORDER BY event_sequence
    ) as event_group
  FROM event_changes
),

deduplicated_flow AS (
  SELECT 
    customer_id,
    session,
    event,
    MIN(created_time) as first_occurrence_time,
    MAX(created_time) as last_occurrence_time,
    COUNT(*) as occurrences_in_sequence,
    MIN(event_sequence) as first_sequence_number,
    event_group
  FROM event_groups
  GROUP BY 
    customer_id,
    session,
    event,
    event_group
),

-- Add row numbers to identify first actions per session
numbered_flow AS (
  SELECT 
    *,
    ROW_NUMBER() OVER (
      PARTITION BY session 
      ORDER BY first_sequence_number
    ) as clean_step_number
  FROM deduplicated_flow
),

-- Skip initial generic events
cleaned_first_actions AS (
  SELECT 
    customer_id,
    session,
    event,
    first_occurrence_time,
    last_occurrence_time,
    occurrences_in_sequence,
    first_sequence_number,
    event_group,
    -- Adjust the step number to skip the initial generic events
    CASE 
      WHEN clean_step_number = 1 
      AND event IN ('SKU_IMPRESSION', 'PAGE_VIEW')
      THEN NULL  -- We'll filter these out
      ELSE ROW_NUMBER() OVER(PARTITION BY customer_id, session ORDER BY clean_step_number) 
    END as adjusted_step_number
  FROM numbered_flow
),

-- Final clean paths
final_paths AS (
  SELECT 
    customer_id,
    session,
    event,
    first_occurrence_time,
    last_occurrence_time,
    occurrences_in_sequence as times_repeated,
    -- Recalculate step numbers to be consecutive after removing initial events
    ROW_NUMBER() OVER (
      PARTITION BY session 
      ORDER BY first_sequence_number
    ) as clean_step_number
  FROM cleaned_first_actions
  WHERE adjusted_step_number IS NOT NULL  -- Remove the skipped initial events
)

-- Generate final output with clean paths
SELECT 
  customer_id,
  session,
  event,
  first_occurrence_time,
  last_occurrence_time,
  times_repeated,
  clean_step_number,
  STRING_AGG(event, ' > ') OVER (
    PARTITION BY session 
    ORDER BY clean_step_number
    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
  ) as clean_path_so_far,
  lead(event) over(partition by session, customer_id order by clean_step_number) as following_by_event
FROM final_paths
-- ORDER BY 
--   session, 
--   clean_step_number