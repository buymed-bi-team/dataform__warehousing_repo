config {
    type: "table",
    description: "Result of Dynamic Segment",
    tags: ["custom_1h_past10", "CUSTOMER_SEGMENT", "0h30"]
}

SELECT
    segment_id AS voucher_code
    , voucher_id
    , processed_date
    , total_customers
    , customer_list
FROM ${ref('bi_dynamic_segment_stg')} AS s
    LEFT JOIN ${ref('dim_voucher')} AS v ON v.voucher_code = segment_id
WHERE NOT REGEXP_CONTAINS(voucher_code, r'TECHTEST_IMPORT|TECHTESTBASE|TECH_TEST_IMPORT2')
QUALIFY ROW_NUMBER() OVER(PARTITION BY segment_id ORDER BY processed_date DESC) = 1
