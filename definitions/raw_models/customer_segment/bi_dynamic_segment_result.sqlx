config {
    type: "table",
    description: "Result of Dynamic Segment",
    tags: ["custom_1h_past10"]
}

SELECT
    segment_id
    , DATE(processed_at) AS processed_date
    , COUNT(1) AS total_customers
    , STRING_AGG(SAFE_CAST(customer_id AS STRING), ", ") AS customer_list
FROM ${ref('bi_dynamic_segment_stg')}
GROUP BY ALL
QUALIFY RANK() OVER(PARTITION BY segment_id ORDER BY processed_date DESC) = 1
