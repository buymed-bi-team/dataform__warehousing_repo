config {
    type: "table",
    tags: ["adhoc-office"],
    dependencies: ["platform_organization_prd_ticket_ticket_instance"],
    name: "fact_ticket_instance",
    description: "PIC: huyen.ngo; model_type: table; Schedule: At minute 5 past hour 7, 10, 13, 16 and 19",
    bigquery: {
    partitionBy: "created_date"
  }
}

WITH ticket_note AS (
    SELECT
        ref_code
        , STRING_AGG(message, "; -") AS message_notes
    FROM ${source.platinum}.platform_organization_prd_ticket_message
    WHERE ref_type LIKE "TICKET_INSTANCE"
        AND message_type = "INTERNAL_NOTE"
    GROUP BY ref_code
)

, cause AS (
   SELECT
  tt_item AS template_code
  ,JSON_VALUE(cause_item, "$.label") AS cause_name
  ,JSON_VALUE(cause_item, "$.value") AS cause_code
  ,reason_code
  ,reason_name
FROM `platinum_buymed_vn.platform_billing_prd_payment_reason_setting`,
  -- Lấy array TICKET_TEMPLATE
  UNNEST(
    JSON_VALUE_ARRAY(
      (SELECT JSON_QUERY(item, "$.value")
       FROM UNNEST(JSON_QUERY_ARRAY(extra_data, "$")) AS item
       WHERE JSON_VALUE(item, "$.key") = "TICKET_TEMPLATE"),
      "$"
    )
  ) AS tt_item,
  -- Lấy array CAUSE
  UNNEST(
    JSON_QUERY_ARRAY(
      (SELECT JSON_QUERY(item, "$.value")
       FROM UNNEST(JSON_QUERY_ARRAY(extra_data, "$")) AS item
       WHERE JSON_VALUE(item, "$.key") = "CAUSE"),
      "$"
    )
  ) AS cause_item
--WHERE reason_code = 'RS111'
)

SELECT
     requester_code
    , requester_name
    , clasify
    , JSON_EXTRACT_SCALAR(a, '$.department_code') AS department_code
    , ti.reason_code
    , priority
    , template_topic_code
    , ticket_instance_code
    , name AS ticket_name
    , JSON_EXTRACT_SCALAR(input_data, '$.userDescription') AS user_description
    , ti.cause_code
    , assignee_account_id
    , DATETIME(
        PARSE_TIMESTAMP(
            '%Y-%m-%dT%H:%M:%E*S%Ez'
            , JSON_EXTRACT_SCALAR(
                JSON_EXTRACT(decision_selecteds, '$[0]')
                , '$.decision_time'
            )
        )
        , "Asia/Ho_Chi_Minh"
    ) AS first_decision_time
    , DATETIME(
        PARSE_TIMESTAMP(
            '%Y-%m-%dT%H:%M:%E*S%Ez'
            , JSON_EXTRACT_SCALAR(
                JSON_EXTRACT(decision_selecteds, '$[1]')
                , '$.decision_time'
            )
        )
        , "Asia/Ho_Chi_Minh"
    ) AS second_decision_time
    , status AS ticket_status
    , JSON_EXTRACT_SCALAR(
        JSON_EXTRACT(decision_selecteds, '$[0]')
        , '$.name'
    ) AS first_decision_name
    , JSON_EXTRACT_SCALAR(
        JSON_EXTRACT(decision_selecteds, '$[1]')
        , '$.name'
    ) AS senconde_decision_name
    , JSON_EXTRACT_SCALAR(input_data, '$.orderID') AS order_id
    , created_date
    , CASE
        WHEN requester_type IS NULL
            THEN JSON_EXTRACT_SCALAR(input_data, '$.REQUESTER_TYPE')
        ELSE requester_type
      END AS requester_type
    , created_by_account_name
    , assignee_account_name
    , assignee_account_email
    , template_module_code
    , branch_code
    , CASE
        WHEN created_by_account_id > 0 THEN "Internal"
        ELSE "Pharmacy"
      END AS creator_type
    , partner_code
    , DATETIME(picked_time, "Asia/Ho_Chi_Minh") AS picked_time
    , DATETIME(created_time, "Asia/Ho_Chi_Minh") AS created_time
    , DATETIME(deadline_time, "Asia/Ho_Chi_Minh") AS deadline_time
    , root_ticket_instance_code
    , DATETIME(
        PARSE_TIMESTAMP(
            '%Y-%m-%dT%H:%M:%E*S%Ez'
            , JSON_EXTRACT_SCALAR(extra_props, '$.completed_time')
        )
        , "Asia/Ho_Chi_Minh"
    ) AS completed_time
    , message_notes
    , c.cause_name AS cause_name
    , c.reason_name
    , JSON_VALUE(ti.input_data, "$.inboundCode") AS pgh
    , JSON_VALUE(ti.input_data, "$.withdrawCode") AS prh
    , JSON_VALUE(ti.input_data, "$.productCode") AS item_code
    , s.product_name
FROM `${source.platinum}.platform_organization_prd_ticket_ticket_instance` ti
LEFT JOIN UNNEST(JSON_EXTRACT_ARRAY(assign_roles, '$')) AS a
LEFT JOIN UNNEST(JSON_EXTRACT_ARRAY(decision_selecteds, '$')) AS b
LEFT JOIN cause AS c ON c.cause_code = ti.cause_code AND c.reason_code = ti.reason_code AND ti.ticket_template_code = c.template_code
LEFT JOIN ticket_note AS tn ON ti.ticket_instance_code = tn.ref_code
LEFT JOIN ${ref('dim_sku_sales_region_current')} AS s ON s.sub_sku_code = JSON_VALUE(ti.input_data, "$.productCode")
WHERE template_module_code IN ('CIRCA_FS', 'O2O_CUSTOMER','INTERNAL_SUPPORT', 'THUOCSIVN_SELLER')
QUALIFY ROW_NUMBER() OVER ( PARTITION BY ticket_instance_code) = 1
