config {
    type: 'table',
    description: `Started time: 2024-06-28 | PIC: tu.dang; schedule: 0h00 daily; model type: table
    Source:
        gold_buymed_vn2.fact_seller_selling_suggestion`,
    columns: {
        //event: `NonNull | IN ("SUGGESTION_SELLING_UPDATE_PRODUCT", "SUGGESTION_SELLING_CREATE_PRODUCT", "SUGGESTION_SELLING_CTA_CLICK","SUGGESTION_SELLING_PAGE_VIEW","SUGGESTION_SELLING_SEARCH_PRODUCT") `,
        action_type:"",
        action:"",
        action_key: "Nullable | IN ('INITIAL_UPDATE_PRODUCT','INITIAL_LISTING_PRODUCT','CONFIRM_UPDATE_PRODUCT','CONFIRM_LISTING_PRODUCT','SUGGESTION_SELLING_PAGE_VIEW','SUGGESTION_SELLING_SEARCH_PRODUCT')"
    },
    tags:['0h00']
}
--- dim_action: temp
with action_key as
(select
--     distinct has_ever_sold
    --  event,
CASE
    WHEN event = "SUGGESTION_SELLING_CTA_CLICK" AND has_ever_sold = true THEN "INITIAL_UPDATE_PRODUCT"
    WHEN event = "SUGGESTION_SELLING_CTA_CLICK" THEN "INITIAL_LISTING_PRODUCT"
    WHEN event = "SUGGESTION_SELLING_UPDATE_PRODUCT" THEN "CONFIRM_UPDATE_PRODUCT"
    WHEN event = "SUGGESTION_SELLING_CREATE_PRODUCT" THEN "CONFIRM_LISTING_PRODUCT"
    WHEN event = "SUGGESTION_SELLING_PAGE_VIEW" THEN "SUGGESTION_SELLING_PAGE_VIEW" 
    WHEN event = "SUGGESTION_SELLING_SEARCH_PRODUCT" THEN "SUGGESTION_SELLING_SEARCH_PRODUCT"
    ELSE NULL
    END AS action_key,
CASE
    WHEN event = "SUGGESTION_SELLING_CTA_CLICK" AND has_ever_sold = true THEN "UPDATE_PRODUCT"
    WHEN event = "SUGGESTION_SELLING_CTA_CLICK" THEN "LISTING_PRODUCT"
    WHEN event = "SUGGESTION_SELLING_UPDATE_PRODUCT" THEN "UPDATE_PRODUCT"
    WHEN event = "SUGGESTION_SELLING_CREATE_PRODUCT" THEN "LISTING_PRODUCT"
    WHEN event = "SUGGESTION_SELLING_PAGE_VIEW" THEN "PAGE_VIEW"
    WHEN event = "SUGGESTION_SELLING_SEARCH_PRODUCT" THEN "SEARCH_PRODUCT"
    ELSE NULL
    END AS action_type,
CASE
    WHEN event = "SUGGESTION_SELLING_CTA_CLICK" AND has_ever_sold = true THEN "INITIAL"
    WHEN event = "SUGGESTION_SELLING_CTA_CLICK" THEN "INITIAL"
    WHEN event = "SUGGESTION_SELLING_UPDATE_PRODUCT" THEN "CONFIRM"
    WHEN event = "SUGGESTION_SELLING_CREATE_PRODUCT" THEN "CONFIRM"
    WHEN event = "SUGGESTION_SELLING_PAGE_VIEW" THEN "PAGE_VIEW"
    WHEN event = "SUGGESTION_SELLING_SEARCH_PRODUCT" THEN "SEARCH_PRODUCT"
    ELSE NULL
    END AS action
from gold_buymed_vn2.fact_seller_selling_suggestion_v2
qualify ROW_NUMBER() over (partition by action_key,action_type)=1)

select *
from action_key