config {
    type: "operations",
    description: "PIC:minh.luu",
    tags: ["custom_5min_9to18","custom_1h_18to9","Weekend"]
    
}
js {
    model_name = "assert_dim_order_channel_primary_key"
}

BEGIN
    CREATE SCHEMA IF NOT EXISTS `lakehouse-prod-394907.dataform_assertions` OPTIONS(location="asia-southeast1");
    EXCEPTION WHEN ERROR THEN
        IF NOT CONTAINS_SUBSTR(@@error.message, "already exists: dataset") AND
            NOT CONTAINS_SUBSTR(@@error.message, "too many dataset metadata update operations") AND
            NOT CONTAINS_SUBSTR(@@error.message, "User does not have bigquery.datasets.create permission")
        THEN
            RAISE USING MESSAGE = @@error.message;
        END IF;
    END;

    CREATE OR REPLACE VIEW `lakehouse-prod-394907.dataform_assertions.${model_name}`
    OPTIONS()
    AS (
    
        SELECT
        'order_id IS NOT NULL' AS failing_row_condition,
        order_id,created_dt
        FROM `lakehouse-prod-394907.gold_buymed_vn2.dim_order_channel`
        WHERE NOT (order_id IS NOT NULL)


        UNION ALL 

        SELECT
            'order_id IS NOT UNIQUE',
            order_id,created_dt
        FROM  `lakehouse-prod-394907.gold_buymed_vn2.dim_order_channel`
        GROUP BY all
        HAVING COUNT(1) > 1

    );
 

IF (
    ( SELECT COUNT(1) FROM `lakehouse-prod-394907.dataform_assertions.assert_dim_order_channel_primary_key` ) <> 0) 
THEN 
    CREATE SNAPSHOT TABLE dataform_assertions.dim_order_channel_${datetime.current_datetime()}
    CLONE ${ref(`dim_order_channel`)};


    CREATE OR REPLACE TABLE ${source.ref}.dim_order_channel 
    PARTITION BY DATE(created_dt)
    AS
    (
        SELECT *
        FROM ${source.ref}.dim_order_channel
        QUALIFY ROW_NUMBER() OVER (WINDOW_PARTITION) = 1
        WINDOW WINDOW_PARTITION AS (PARTITION BY order_id)
    );
END IF;
ASSERT ( (SELECT COUNT(1) FROM `lakehouse-prod-394907.dataform_assertions.assert_dim_order_channel_primary_key` ) = 0 ) AS "Assertion failed, expected zero rows.";
