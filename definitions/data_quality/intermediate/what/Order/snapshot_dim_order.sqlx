config {
    type: "operations",
    description: "PIC:minh.luu"
}


CREATE SNAPSHOT TABLE dataform_assertions.dim_order_${datetime.current_datetime()}
CLONE ${ref(`dim_order`)};

CREATE OR REPLACE TABLE `${source.ref}.dim_order` 
PARTITION BY DATE(created_time)
AS
(
    SELECT *
    FROM ${source.ref}.dim_order
    QUALIFY ROW_NUMBER() OVER (WINDOW_PARTITION) = 1
    WINDOW WINDOW_PARTITION AS (PARTITION BY order_id)
);