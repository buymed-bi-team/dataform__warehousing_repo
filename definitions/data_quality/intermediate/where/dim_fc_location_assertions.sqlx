config {
  type: "assertion",
  tags: "weekly_assertion"
}

SELECT
  location_fc_code, 'parent_location_code IS NULL' AS reason, parent_location_code AS value
FROM
  ${ref(`dim_fc_location`)}
WHERE
  parent_location_code IS NULL
  AND location_fc_code not like "TULANH%"

UNION ALL

SELECT
  location_fc_code, 'type not in ("NORMAL","VIRTUAL",NULL)' AS reason, type AS value
FROM
  ${ref(`dim_fc_location`)}
WHERE
  type not in ("NORMAL","VIRTUAL",NULL)
  AND location_fc_code not like "TULANH%"

UNION ALL

SELECT
  location_fc_code, 'fc_code LIKE "BD" AND location_key IS NULL AND layout_key IS NULL' AS reason,
  CONCAT(
    'location_key = ',
    CAST ( location_key  AS STRING ),
    ' | ',
    'layout_key = ',
    CAST ( layout_key AS STRING )
  ) AS value
FROM
  ${ref(`dim_fc_location`)}
WHERE
  fc_code LIKE "BD" AND location_key IS NULL AND layout_key IS NULL
  AND location_fc_code not like "TULANH%"

UNION ALL

SELECT
  location_fc_code, 'zone_key is NULL' AS reason, zone_key AS value
FROM
  ${ref(`dim_fc_location`)}
WHERE
  zone_key is NULL
  AND location_fc_code not like "TULANH%"