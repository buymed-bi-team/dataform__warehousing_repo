config {
  type: "assertion",
  tags: "weekly_assertion"
}

WITH unittest AS (
  SELECT
    'E1A01A01' AS location_code, 'MEDIUM_GRAY' AS shelf_type, 'E1' AS zone_key, 'A01' AS shelf_key, 'A' AS shelf_level, '01' AS location_number_key, 'E1A01' AS layout_key, 'A01' AS location_key UNION ALL
  SELECT
    'E1A01A02', 'MEDIUM_GRAY', 'E1', 'A01', 'A', '02', 'E1A01', 'A02' UNION ALL
  SELECT
    'E1A01A03', 'MEDIUM_GRAY', 'E1', 'A01', 'A', '03', 'E1A01', 'A03' UNION ALL
  SELECT
    'E1A01A04', 'MEDIUM_GRAY', 'E1', 'A01', 'A', '04', 'E1A01', 'A04' UNION ALL
  SELECT
    'E1A01A05', 'MEDIUM_GRAY', 'E1', 'A01', 'A', '05', 'E1A01', 'A05' UNION ALL
  SELECT
    'E1A01A06', 'MEDIUM_GRAY', 'E1', 'A01', 'A', '06', 'E1A01', 'A06' UNION ALL
  SELECT
    'E1A01A07', 'MEDIUM_GRAY', 'E1', 'A01', 'A', '07', 'E1A01', 'A07' UNION ALL
  SELECT
    'E1A01A08', 'MEDIUM_GRAY', 'E1', 'A01', 'A', '08', 'E1A01', 'A08' UNION ALL
  SELECT
    'E1A01A09', 'MEDIUM_GRAY', 'E1', 'A01', 'A', '09', 'E1A01', 'A09' UNION ALL
  SELECT
    'E1A01A10', 'MEDIUM_GRAY', 'E1', 'A01', 'A', '10', 'E1A01', 'A10' UNION ALL
  SELECT
    'E1A01A11', 'MEDIUM_GRAY', 'E1', 'A01', 'A', '11', 'E1A01', 'A11'
)

SELECT 
  DISTINCT t.*, h.location_code, h.shelf_type, h.zone_key, h.shelf_key, h.shelf_level, h.location_number_key, h.layout_key, h.location_key
FROM ${ref(`dim_fc_location`)} h
RIGHT JOIN unittest t ON h.location_code = t.location_code
WHERE 
  t.shelf_type != h.shelf_type OR
  t.zone_key != h.zone_key OR
  t.shelf_key != h.shelf_key OR
  t.shelf_level != h.shelf_level OR
  t.location_number_key != h.location_number_key OR
  t.layout_key != h.layout_key OR
  t.location_key != h.location_key