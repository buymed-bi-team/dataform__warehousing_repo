js {
                const { generateCDCScript } = require("includes/platinum_render/circa_v2_helpers");

                const querySQL = generateCDCScript({
                    postgresDatabase: "invoice",
                    dataset:      "buymed_circa_v2_raw",
                    tableName:    "invoice_process",
                    targetDataset: "buymed_circa_v2_staging",
                    targetTable: "invoice_invoice_process",
                    rawTable:     "invoice_invoice_process",
                    primaryKey:   "id",
                    createdTime:  "created_at",
                    lookbackHours: 2,
                });
        }

                config {
                type: "operations",
                schema: "buymed_circa_v2_staging",
                tags: ["buymed_circa_v2_invoice", "platinum_custom_10min"]
                }

                ${querySQL}
    