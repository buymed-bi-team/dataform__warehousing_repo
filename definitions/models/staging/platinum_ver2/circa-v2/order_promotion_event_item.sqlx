js {
                const { generateCDCScript } = require("includes/platinum_render/circa_v2_helpers");

                const querySQL = generateCDCScript({
                    postgresDatabase: "order",
                    dataset:      "buymed_circa_v2_raw",
                    tableName:    "promotion_event_item",
                    targetDataset: "buymed_circa_v2",
                    targetTable: "order_promotion_event_item",
                    rawTable:     "order_promotion_event_item",
                    primaryKey:   "id",
                    createdTime:  "created_at",
                    lookbackHours: 1,
                });
        }

                config {
                type: "operations",
