js {
  const { generateCDCScript } = require("includes/platinum_render/circa_v2_helpers");

  const querySQL = generateCDCScript({
    postgresDatabase: "order",
    dataset:      "buymed_circa_v2_raw",
    tableName:    "payment_receipt_voucher",
    targetDataset: "buymed_circa_v2_staging",
    targetTable: "order_payment_receipt_voucher",
    rawTable:     "order_payment_receipt_voucher",
    primaryKey:   "id",
    createdTime:  "created_at",
    lookbackHours: 2,
  });
}

config {
  type: "operations",
  schema: "buymed_circa_v2_staging",
  tags: ["cdc", "platinum_custom_10min"]
}

${querySQL}
