js {
  const { generateCDCScript } = require("includes/platinum_render/circa_v2_helpers_dev");

  const querySQL = generateCDCScript({
    postgresDatabase: "product",
    dataset:          "buymed_circa_v2_raw",
    tableName:        "price_suggestion",
    targetDataset:    "buymed_circa_v2",
    targetTable:      "product_price_suggestion",
    rawTable:         "product_price_suggestion",
    primaryKey:       "id",
    createdTime:      "computed_at",
    lookbackHours:    1,
  });
}

config {
  type: "operations",
  schema: "buymed_circa_v2",
  tags: ["buymed_circa_v2_product", "platinum_custom_30m"]
}

${querySQL}
