js {
                const { generateCDCScript } = require("includes/platinum_render/circa_v2_helpers_dev");

                const querySQL = generateCDCScript({
                    postgresDatabase: "product",
                    dataset:      "buymed_circa_v2_raw",
                    tableName:    "manufacturer",
                    targetDataset: "buymed_circa_v2",
                    targetTable: "product_manufacturer",
                    rawTable:     "product_manufacturer",
                    primaryKey:   ["manufacturer_id", "client_id"],
                    createdTime:  "created_at",
                    lookbackHours: 1,
                });
        }

                config {
                type: "operations",
