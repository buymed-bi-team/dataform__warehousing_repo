config {
    type: "view",
    schema: "platinum_buymed_vn",
    name: "warehouse_prd_inbound_inbound_ticket",
    description : `
    PIC: nguyen.tran
    Partition by: created date
    `,
    tags:["platinum","warehouse_prd_core"]
}

  WITH silver AS (
    SELECT
      key, mg_id, external_type, po_code, check_employee_info, code, created_by, created_time, estimated_delivery_time, inbound_ticket_items, last_updated_time, partner, po_id, priority, seller_code, seller_info, status, tags, ticket_id, total_item, total_sku, type, vendor_code, version_no, warehouse_code, lot_date_input, updated_by, check_in_codes, check_in_session, last_calculate_inbound_priority_time, total_order_waiting, total_order_waiting_to_target, basket_code, erp_ticket_id, last_process_time, picking_type_id, vendor_id, last_conveyour_checking, check_system, inbound_code, completed_time, last_conveyor_checking, point, location_details, is_callback_v1, synced_at, extra_props, action, ingest_time,
      
        CASE
            WHEN created_time IS NOT NULL THEN DATE(DATETIME(created_time, 'Asia/Ho_Chi_Minh'))
            ELSE DATE( '2099-01-01' )
        END
     created_date,
      CAST(null as datetime) 
    FROM silver_buymed_vn.warehouse_prd_inbound_inbound_ticket
    WHERE DATE(ingest_time) >= CURRENT_DATE("+7") - INTERVAL 1 DAY
        AND NOT (action = 'd' AND ingest_time BETWEEN '2026-04-19 17:00:00' AND '2026-04-26 17:00:00')
    QUALIFY ROW_NUMBER() OVER (_window) = 1 
          -- AND ingest_time >= CURRENT_TIMESTAMP() - INTERVAL 16 HOUR
    WINDOW _window AS (
    PARTITION BY mg_id
    ORDER BY synced_at DESC
    ,last_updated_time DESC)
  ), platinum AS (
    SELECT 
      key, mg_id, external_type, po_code, check_employee_info, code, created_by, created_time, estimated_delivery_time, inbound_ticket_items, last_updated_time, partner, po_id, priority, seller_code, seller_info, status, tags, ticket_id, total_item, total_sku, type, vendor_code, version_no, warehouse_code, lot_date_input, updated_by, check_in_codes, check_in_session, last_calculate_inbound_priority_time, total_order_waiting, total_order_waiting_to_target, basket_code, erp_ticket_id, last_process_time, picking_type_id, vendor_id, last_conveyour_checking, check_system, inbound_code, completed_time, last_conveyor_checking, point, location_details, is_callback_v1, synced_at, extra_props, action, ingest_time,
      created_date,
      platinum_refresh
    FROM ${ref(`platinum_buymed_vn__stg`, `warehouse_prd_inbound_inbound_ticket`)}
  )
  SELECT p.*
  FROM platinum p
  LEFT JOIN silver s 
      ON p.mg_id = s.mg_id 
  WHERE s.mg_id is null 

  UNION ALL 

  SELECT s.*
  FROM silver s
  WHERE action <> "d"