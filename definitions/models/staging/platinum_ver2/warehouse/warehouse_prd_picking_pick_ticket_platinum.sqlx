config {
    type: "view",
    schema: "platinum_buymed_vn",
    name: "warehouse_prd_picking_pick_ticket",
    description : `
    PIC: minh.luu
    Partition by: created date
    `,
    tags:["platinum","warehouse_prd_picking"]
}

  WITH silver AS (
    SELECT
      key,mg_id,so,ticket_id,admin_id,create_source,created_time,customer,ex_shipping_date,init_priority,instance_code,is_split,is_split_waiting,is_transfer_created,last_updated_time,merge_warehouse_code,order_price,point,priority,ready_tag,reserved_total_amount,scheduled_date,sort,source_location,split_type,status,tags,total_amount,total_held_sku,total_item,total_order_item,total_sku,type,version_no,warehouse_code,weights,ready_for_pick_time,activation_time,pick_employees,total_sub_pick_ticket,start_pick_time,start_time,baskets,end_pick_time,total_done_sub_pick_ticket,qc_id,qc_name,start_qc_time,end_qc_time,qc_location,qc_weights,updated_by,pack_id,pack_name,start_pack_time,end_time,pack_location,package_images,package_num,packages,is_out_transfer,activation_by,is_manual_active,merged_location,employee,employee_id,additional_time,is_transit,is_pending,additional_employee,additional_employee_id,has_processing_put_ticket,is_locked,put_tickets,has_processing_missing_transfer,transfers,is_second_pick_ticket,is_merge_do,merge_do_status,synced_at,extra_props,action,ingest_time,
      
        CASE
            WHEN created_time IS NOT NULL THEN DATE(DATETIME(created_time, 'Asia/Ho_Chi_Minh'))
            ELSE DATE( '2099-01-01' )
        END
     created_date,
      CAST(null as datetime) 
    FROM silver_buymed_vn.warehouse_prd_picking_pick_ticket
    WHERE ingest_time >= CURRENT_TIMESTAMP() - INTERVAL 1 DAY
    QUALIFY ROW_NUMBER() OVER (_window) = 1 
          AND FIRST_VALUE(action) OVER(_window) != "d"
          AND ingest_time >= CURRENT_TIMESTAMP() - INTERVAL 16 HOUR
          WINDOW _window AS (
          PARTITION BY mg_id
          ORDER BY synced_at DESC,
          IF
              (action='d',3,
              IF
              (action='u',2,1)) DESC
          ,last_updated_time DESC)
  ), platinum AS (
    SELECT 
      key,mg_id,so,ticket_id,admin_id,create_source,created_time,customer,ex_shipping_date,init_priority,instance_code,is_split,is_split_waiting,is_transfer_created,last_updated_time,merge_warehouse_code,order_price,point,priority,ready_tag,reserved_total_amount,scheduled_date,sort,source_location,split_type,status,tags,total_amount,total_held_sku,total_item,total_order_item,total_sku,type,version_no,warehouse_code,weights,ready_for_pick_time,activation_time,pick_employees,total_sub_pick_ticket,start_pick_time,start_time,baskets,end_pick_time,total_done_sub_pick_ticket,qc_id,qc_name,start_qc_time,end_qc_time,qc_location,qc_weights,updated_by,pack_id,pack_name,start_pack_time,end_time,pack_location,package_images,package_num,packages,is_out_transfer,activation_by,is_manual_active,merged_location,employee,employee_id,additional_time,is_transit,is_pending,additional_employee,additional_employee_id,has_processing_put_ticket,is_locked,put_tickets,has_processing_missing_transfer,transfers,is_second_pick_ticket,is_merge_do,merge_do_status,synced_at,extra_props,action,ingest_time,
      created_date,
      platinum_refresh
    FROM ${ref(`platinum_buymed_vn__stg`, `warehouse_prd_picking_pick_ticket`)}
  )
  SELECT p.*
  FROM platinum p
  LEFT JOIN silver s 
      ON p.mg_id = s.mg_id 
  WHERE s.mg_id is null 

  UNION ALL 

  SELECT s.*
  FROM silver s