config {
    type: "view",
    schema: "platinum_buymed_vn",
    name: "warehouse_prd_picking_pick_ticket_item",
    description : `
    PIC: minh.luu
    Partition by: created date
    `,
    tags:["platinum","warehouse_prd_picking"]
}

  WITH silver AS (
    SELECT
      key,mg_id,line_id,so,ticket_id,admin_product_id,combo_info,created_time,details,erp_product_id,expired_details,expired_quantity,finish_full_reserving_time,fulfilled_quantity,has_return_scan_quantity,image_url,is_combo,is_external_seller,is_link,is_red_tag,is_split,item_quantity_sort_per_item,lack_combo_redundant_scan_quantity,last_updated_time,location_details,name,non_vat_details,non_vat_quantity,normal_redundant_scan_quantity,order_quantity,packaging,pick_result,point,price_sort_per_item,product_type,quantity,redundant_fulfill_quantity,reserve_status,sale_line_id,scan_status,scanned_quantity,scheduled_date,seller_code,sku,sku_quantity_sort_per_item,source_location,tags,unit,unit_price,version_no,warehouse_code,weight,zone,updated_by,is_near_exp,is_fragile,is_important,is_second_pick_ticket,is_frozen,has_processed_normal_redundant,has_redundant_create_put,normal_redundant_details,is_full_package,created_by,has_qc_missing_transfer,link_code,link_info,has_processed_lack_combo_redundant,synced_at,extra_props,action,ingest_time,
      
        CASE
            WHEN created_time IS NOT NULL THEN DATE(DATETIME(created_time, 'Asia/Ho_Chi_Minh'))
            ELSE DATE( '2099-01-01' )
        END
     created_date,
      CAST(null as datetime) 
    FROM silver_buymed_vn.warehouse_prd_picking_pick_ticket_item
    WHERE ingest_time >= CURRENT_TIMESTAMP() - INTERVAL 1 DAY
    QUALIFY ROW_NUMBER() OVER (_window) = 1 
          AND ingest_time >= CURRENT_TIMESTAMP() - INTERVAL 16 HOUR
          WINDOW _window AS (
          PARTITION BY mg_id
          ORDER BY synced_at DESC,
          IF
              (action='d',3,
              IF
              (action='u',2,1)) DESC
          ,last_updated_time DESC)
  ), platinum AS (
    SELECT 
      key,mg_id,line_id,so,ticket_id,admin_product_id,combo_info,created_time,details,erp_product_id,expired_details,expired_quantity,finish_full_reserving_time,fulfilled_quantity,has_return_scan_quantity,image_url,is_combo,is_external_seller,is_link,is_red_tag,is_split,item_quantity_sort_per_item,lack_combo_redundant_scan_quantity,last_updated_time,location_details,name,non_vat_details,non_vat_quantity,normal_redundant_scan_quantity,order_quantity,packaging,pick_result,point,price_sort_per_item,product_type,quantity,redundant_fulfill_quantity,reserve_status,sale_line_id,scan_status,scanned_quantity,scheduled_date,seller_code,sku,sku_quantity_sort_per_item,source_location,tags,unit,unit_price,version_no,warehouse_code,weight,zone,updated_by,is_near_exp,is_fragile,is_important,is_second_pick_ticket,is_frozen,has_processed_normal_redundant,has_redundant_create_put,normal_redundant_details,is_full_package,created_by,has_qc_missing_transfer,link_code,link_info,has_processed_lack_combo_redundant,synced_at,extra_props,action,ingest_time,
      created_date,
      platinum_refresh
    FROM ${ref(`platinum_buymed_vn__stg`, `warehouse_prd_picking_pick_ticket_item`)}
  )
  SELECT p.*
  FROM platinum p
  LEFT JOIN silver s 
      ON p.mg_id = s.mg_id 
  WHERE s.mg_id is null 

  UNION ALL 

  SELECT s.*
  FROM silver s
  WHERE action <> "d"
  