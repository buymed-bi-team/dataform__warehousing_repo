config {
    type: "view",
    schema: "platinum_buymed_vn",
    name: "warehouse_prd_inbound_inbound_ticket_item",
    description : `
    PIC: nguyen.tran
    Partition by: created date
    `,
    tags:["platinum","warehouse_prd_core"]
}

  WITH silver AS (
    SELECT
      key, mg_id, sku, ticket_id, admin_product_id, created_by, created_time, demand_quantity, details, draft_quantity, error_items, error_quantity, has_both_vat_type, image_url, image_urls, inbound_code, inbound_quantity, inbound_result, invoice_exportable, is_fragile, is_frozen, is_near_exp, last_updated_time, line_id, name, packaging, po_code, product_code, product_id, qr_quantity, redundant_quantity, synced_receipt_code, vat, vendor_product_name, version_no, warehouse_code, zone, updated_by, hub_detail, is_unknown_product, tags, synced_at, extra_props, action, ingest_time,
      
        CASE
            WHEN created_time IS NOT NULL THEN DATE(DATETIME(created_time, 'Asia/Ho_Chi_Minh'))
            ELSE DATE( '2099-01-01' )
        END
     created_date,
      CAST(null as datetime) 
    FROM silver_buymed_vn.warehouse_prd_inbound_inbound_ticket_item
    WHERE DATE(ingest_time) >= CURRENT_DATE("+7") - INTERVAL 1 DAY
        AND NOT (action = 'd' AND ingest_time BETWEEN '2026-04-19 17:00:00' AND '2026-04-26 17:00:00')
    QUALIFY ROW_NUMBER() OVER (_window) = 1 
          -- AND ingest_time >= CURRENT_TIMESTAMP() - INTERVAL 16 HOUR
    WINDOW _window AS (
    PARTITION BY mg_id
    ORDER BY synced_at DESC
    ,last_updated_time DESC)
  ), platinum AS (
    SELECT 
      key, mg_id, sku, ticket_id, admin_product_id, created_by, created_time, demand_quantity, details, draft_quantity, error_items, error_quantity, has_both_vat_type, image_url, image_urls, inbound_code, inbound_quantity, inbound_result, invoice_exportable, is_fragile, is_frozen, is_near_exp, last_updated_time, line_id, name, packaging, po_code, product_code, product_id, qr_quantity, redundant_quantity, synced_receipt_code, vat, vendor_product_name, version_no, warehouse_code, zone, updated_by, hub_detail, is_unknown_product, tags, synced_at, extra_props, action, ingest_time,
      created_date,
      platinum_refresh
    FROM ${ref(`platinum_buymed_vn__stg`, `warehouse_prd_inbound_inbound_ticket_item`)}
  )
  SELECT p.*
  FROM platinum p
  LEFT JOIN silver s 
      ON p.mg_id = s.mg_id 
  WHERE s.mg_id is null 

  UNION ALL 

  SELECT s.*
  FROM silver s
  WHERE action <> "d"