config {
    type: "view",
    schema: "platinum_buymed_vn",
    name: "marketplace_prd_cart_cart_item",
    description : `
    Partition by: created date
    `,
    tags:["platinum","marketplace_prd_cart"]
}

  WITH silver AS (
    SELECT
      key, mg_id, cart_id, sku, cart_no, created_time, current_price, event_screen, event_source, fee, is_near_expired, is_selected, item_code, last_updated_time, lot_dates, max_quantity, old_level, old_type, owner, page, product_code, product_id, product_name, quantity, ref_cart, seller_code, sku_contract_code, sku_contract_detail_code, sku_level, source, type, skus, notification, point, point_multiplier, is_important, search_key, sku_prev_ver, synced_at, extra_props, action, ingest_time,
      
        CASE
            WHEN created_time IS NOT NULL THEN DATE(DATETIME(created_time, 'Asia/Ho_Chi_Minh'))
            ELSE DATE( '2099-01-01' )
        END
     created_date
    FROM silver_buymed_vn.marketplace_prd_cart_cart_item
    WHERE ingest_time >= CURRENT_TIMESTAMP() - INTERVAL 1 DAY
    QUALIFY ROW_NUMBER() OVER (_window) = 1 
          AND ingest_time >= CURRENT_TIMESTAMP() - INTERVAL 16 HOUR
          WINDOW _window AS (
          PARTITION BY mg_id
          ORDER BY synced_at DESC
          ,last_updated_time DESC)
  ), platinum AS (
    SELECT 
      key, mg_id, cart_id, sku, cart_no, created_time, current_price, event_screen, event_source, fee, is_near_expired, is_selected, item_code, last_updated_time, lot_dates, max_quantity, old_level, old_type, owner, page, product_code, product_id, product_name, quantity, ref_cart, seller_code, sku_contract_code, sku_contract_detail_code, sku_level, source, type, skus, notification, point, point_multiplier, is_important, search_key, sku_prev_ver, synced_at, extra_props, action, ingest_time,
      created_date
    FROM ${ref(`platinum_buymed_vn__stg`, `marketplace_prd_cart_cart_item`)}
  )

  SELECT p.*
  FROM platinum p
  LEFT JOIN silver s 
      ON p.mg_id = s.mg_id 
  WHERE s.mg_id is null 

  UNION ALL 

  SELECT s.*
  FROM silver s
  WHERE action <> "d"
