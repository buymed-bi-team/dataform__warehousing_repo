config {
    type: "view",
    schema: "platinum_buymed_vn",
    name: "circa_online_prd_consumer_tracking_events",
    description : `
    Partition by: created date
    `,
    tags:["platinum","circa-online_prd_order"]
}
 
  WITH silver AS (
    SELECT
      key, mg_id, event_type, customer_phone, product_name, product_code, price, quantity, product_id, expires_at, last_updated_time, created_time, session_id, synced_at, extra_props, action, ingest_time,
      
        CASE
            WHEN created_time IS NOT NULL THEN DATE(DATETIME(created_time, 'Asia/Ho_Chi_Minh'))
            ELSE DATE( '2099-01-01' )
        END
     created_date,
      CAST(null as datetime) 
    FROM silver_buymed_vn.circa_online_prd_consumer_tracking_events
    WHERE ingest_time >= CURRENT_TIMESTAMP() - INTERVAL 1 DAY
    QUALIFY ROW_NUMBER() OVER (_window) = 1 
          WINDOW _window AS (
          PARTITION BY mg_id
          ORDER BY synced_at DESC
          ,last_updated_time DESC)
  )
  , platinum AS (
    SELECT 
      key, mg_id, event_type, customer_phone, product_name, product_code, price, quantity, product_id, expires_at, last_updated_time, created_time, session_id, synced_at, extra_props, action, ingest_time,
      created_date,
      platinum_refresh
    FROM ${ref(`platinum_buymed_vn__stg`, `circa_online_prd_consumer_tracking_events`)}
  )
SELECT p.*
FROM platinum p
WHERE NOT EXISTS (SELECT 1 FROM silver s WHERE s.mg_id = p.mg_id)

  UNION ALL 

  SELECT s.*
  FROM silver s
  WHERE action <> "d"
