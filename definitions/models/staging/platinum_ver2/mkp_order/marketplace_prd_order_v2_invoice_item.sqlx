
config {
  type: "view",
  schema: "platinum_buymed_vn",
  name: "marketplace_prd_order_v2_invoice_item",
  description : `
  PIC: auto-gen
  Partition by: created date
  `,
  tags:["platinum","circa-online_prd_consumer"]
}

WITH silver AS (
  SELECT
    key, mg_id, order_id, item_code, sku_contract_code, sku_status, completed_quantity, sku_contract_detail_code, voucher_amount_by_sku_unit, sku_price_type, fee, max_quantity, lot_dates, event_source, actual_invoice_voucher_amount_by_sku, receive_invoice_info_by, sku_unit, last_updated_time, discount_detail, reserved_quantity, outbound_infos, price_after_discount, charge_deal_fee, sku_status_data, sku_version, total_seller_price, actual_seller_price, outbound_quantity, deal_info, sku, total_price, actual_price, notional_quantity, deal_owner, created_time, total_seller_revenue, invoice_id, seller_revenue, none_vat, event_screen, deliveredQuantity, page, customer_id, total_point, cart_item_created_time, order_code, product_code, notional_price, campaign_info, invoice_code, sku_level, price, reserve_infos, tags, charge_deal_fee_value, deal_pricing_type, seller_code, seller_class, vat, type, quantity, block_code, unit, contract_info, deal_code, product_id, seller_price, source, synced_at, extra_props, action, ingest_time,
    CASE
      WHEN created_time IS NOT NULL THEN DATE(DATETIME(created_time, 'Asia/Ho_Chi_Minh'))
      ELSE DATE('2099-01-01')
    END created_date,
    CAST(NULL AS DATETIME) AS platinum_refresh
  FROM silver_buymed_vn.marketplace_prd_order_v2_invoice_item
  WHERE ingest_time >= CURRENT_TIMESTAMP() - INTERVAL 1 DAY
  QUALIFY ROW_NUMBER() OVER (_window) = 1
    AND ingest_time >= CURRENT_TIMESTAMP() - INTERVAL 16 HOUR
  WINDOW _window AS (
    PARTITION BY mg_id
    ORDER BY synced_at DESC,
      IF(action='d',3, IF(action='u',2,1)) DESC,
      last_updated_time DESC
  )
),

platinum AS (
  SELECT
    key, mg_id, order_id, item_code, sku_contract_code, sku_status, completed_quantity, sku_contract_detail_code, voucher_amount_by_sku_unit, sku_price_type, fee, max_quantity, lot_dates, event_source, actual_invoice_voucher_amount_by_sku, receive_invoice_info_by, sku_unit, last_updated_time, discount_detail, reserved_quantity, outbound_infos, price_after_discount, charge_deal_fee, sku_status_data, sku_version, total_seller_price, actual_seller_price, outbound_quantity, deal_info, sku, total_price, actual_price, notional_quantity, deal_owner, created_time, total_seller_revenue, invoice_id, seller_revenue, none_vat, event_screen, deliveredQuantity, page, customer_id, total_point, cart_item_created_time, order_code, product_code, notional_price, campaign_info, invoice_code, sku_level, price, reserve_infos, tags, charge_deal_fee_value, deal_pricing_type, seller_code, seller_class, vat, type, quantity, block_code, unit, contract_info, deal_code, product_id, seller_price, source, synced_at, extra_props, action, ingest_time,
    created_date,
    platinum_refresh
  FROM ${ref(`platinum_buymed_vn__stg`, `marketplace_prd_order_v2_invoice_item`)}
)

SELECT p.*
FROM platinum p
LEFT JOIN silver s
  ON p.mg_id = s.mg_id
WHERE s.mg_id IS NULL

UNION ALL

SELECT s.*
FROM silver s
WHERE action <> "d"