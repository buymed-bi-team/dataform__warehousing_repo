config {
    type: "view",
    name: "pim_prd_product_attribute_definition_option",
    schema: "platinum_buymed_vn",

    tags:["platinum","pim_prd_product","PLATFORM.global-platform"]
}

WITH over_tbl AS (
    SELECT
        mg_id,
        ARRAY_AGG(
            key 
            ORDER BY
                synced_at DESC,
                last_updated_time DESC
            LIMIT 1
        )[0] key ,
        ARRAY_AGG(
            action 
            ORDER BY
                synced_at DESC,
                last_updated_time DESC
            LIMIT 1
        )[0] action
    FROM ${source.silver}.pim_prd_product_attribute_definition_option
    
    GROUP BY mg_id HAVING action != "d"
)
SELECT
    *,
    CASE
        WHEN created_time IS NOT NULL THEN DATE(DATETIME(created_time, 'Asia/Ho_Chi_Minh'))
        ELSE DATE( '2099-01-01' )
    END AS created_date,
    CURRENT_DATETIME() AS platinum_refresh
FROM ${source.silver}.pim_prd_product_attribute_definition_option
WHERE key IN (SELECT o.key FROM over_tbl o)
