--     created_date,
--     platinum_refresh
--   FROM ${ref(`platinum_buymed_vn__stg`, `seller_prd_core_vendor_store_tag`)}
-- )

-- SELECT p.*
-- FROM platinum p
-- LEFT JOIN silver s
--   ON p.mg_id = s.mg_id
-- WHERE s.mg_id IS NULL

-- UNION ALL

SELECT s.*
FROM silver s
WHERE action <> "d"
