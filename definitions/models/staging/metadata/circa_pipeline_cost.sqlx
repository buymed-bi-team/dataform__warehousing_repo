  TIMESTAMP_TRUNC(execution_time +INTERVAL 7 HOUR, DAY) execution_time,
  flow,
  SUM(job_count) job_count,
  SUM(load_job_count) load_job_count,
  SUM(query_job_count) query_job_count,
  SUM(copy_job_count) copy_job_count,

  de_buymed_vn.readable_size(SUM(total_bytes_billed)) total_readable_size,
  de_buymed_vn.readable_size(SUM(load_bytes_billed)) load_readable_size_billed, 
