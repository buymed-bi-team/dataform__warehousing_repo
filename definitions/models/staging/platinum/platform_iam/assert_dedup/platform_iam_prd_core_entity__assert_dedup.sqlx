config {
    type: "operations",
    tags:["platinum_custom_2h_past7","platform_iam_prd_core"]
}
-- script_tag: ["assert","assert_duplicate"]
DECLARE _assert INT64;
DECLARE sef_dedup BOOL;

SET _assert = (
    SELECT
        COUNT(*)
    FROM (
    SELECT
        mg_id,
        COUNT(1) AS index_row_count
    FROM ${ref(`platform_iam_prd_core_entity`)}
    GROUP BY mg_id
    ) AS data
    WHERE index_row_count > 1
);

IF ( _assert <> 0 ) THEN 
    CREATE OR REPLACE TABLE ${ref(`platform_iam_prd_core_entity`)}
    PARTITION BY  created_date 
    AS (
        SELECT
            * except(created_date),
            CASE 
                WHEN created_time IS NOT NULL THEN DATE(DATETIME(created_time,'Asia/Ho_Chi_Minh'))
                ELSE "2099-01-01"
            END AS created_date
        FROM ${ref(`platform_iam_prd_core_entity`)} o 
        QUALIFY ROW_NUMBER() OVER (_window) = 1
                AND FIRST_VALUE(action) OVER (_window) <> 'd'
        WINDOW _window AS (
            PARTITION BY mg_id
            ORDER BY synced_at DESC,
            IF
                (action='d',3,
                IF
                (action='u',2,1)) DESC,
                last_updated_time DESC)
    );
    SET _assert = ( -- If Still duplicate
        SELECT
            COUNT(*)
        FROM (
        SELECT
            mg_id,
            COUNT(1) AS index_row_count
        FROM ${ref(`platform_iam_prd_core_entity`)}
        GROUP BY mg_id
        ) AS data
        WHERE index_row_count > 1
    );

    ASSERT ( _assert = 0) AS "mg_id must be unique key" ;
END IF
