config {
    type: "incremental",
    name: "marketplace_prd_promotion_gamification_result",
    schema: "platinum_buymed_vn",
    assertions: {
        uniqueKey: 'mg_id'
    },
    bigquery: {
        partitionBy: "created_date"
    },
    tags:["platinum_custom_1h_past7","marketplace_prd_promotion"]
}


js {
  incremental_time = `DATE_TRUNC(CURRENT_DATETIME() - INTERVAL 6 HOUR, DAY)`
  incremental_ts = `TIMESTAMP(${incremental_time})`
}


pre_operations {
  ${
    when(incremental(),
      `--Incremental--
      DECLARE checkpoint_date ARRAY<date>;

      CREATE TEMP TABLE tmp1 AS (
        SELECT * , 
          CASE 
              WHEN created_time IS NOT NULL THEN DATE(DATETIME(created_time,'Asia/Ho_Chi_Minh'))
              ELSE "2099-01-01"
            END AS created_date
        FROM ${source.silver}.marketplace_prd_promotion_gamification_result
        WHERE ingest_time >= ${incremental_ts}
        QUALIFY ROW_NUMBER() OVER (_window) = 1 AND FIRST_VALUE(action) OVER (_window) <> 'd'
        WINDOW _window AS ( 
            PARTITION BY mg_id
            ORDER BY synced_at DESC,
            IF (action = 'd', 3, IF (action = 'u', 2, 1)) DESC,
            last_updated_time DESC
        )
      );
      --

    --   SET checkpoint_date = ( 
    --     SELECT ARRAY_AGG(
    --         DATE( COALESCE(silver_new.created_time, platinum.created_time) ,'+7')
    --         IGNORE NULLS
    --         )
    --     FROM tmp1 silver_new
    --     LEFT JOIN ${self()} platinum ON platinum.mg_id = silver_new.mg_id
    --   );

      DELETE FROM ${self()}
      where 
    --   created_date in UNNEST(checkpoint_date)
    --   and 
      mg_id in ( 
        SELECT DISTINCT mg_id 
        FROM tmp1
        );

      `,
      `--FullRefresh--
      CREATE TEMP TABLE tmp1 AS (

          SELECT * , 
            CASE 
                WHEN created_time IS NOT NULL THEN DATE(DATETIME(created_time,'Asia/Ho_Chi_Minh'))
                ELSE "2099-01-01"
              END AS created_date
          FROM ${source.silver}.marketplace_prd_promotion_gamification_result
          QUALIFY ROW_NUMBER() OVER (_window) = 1 AND FIRST_VALUE(action) OVER (_window) <> 'd'
          WINDOW _window AS ( 
              PARTITION BY mg_id
              ORDER BY synced_at DESC,
              IF (action = 'd', 3, IF (action = 'u', 2, 1)) DESC,
              last_updated_time DESC
        )
        
      )`
    )
  }
}
-- 
SELECT * FROM tmp1

-- all record deleted include action "d"
-- Special case for order -- PIC: AnhLe
