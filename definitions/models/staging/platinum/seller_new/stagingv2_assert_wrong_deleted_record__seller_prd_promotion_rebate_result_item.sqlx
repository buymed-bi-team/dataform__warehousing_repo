config {
    type: "assertion",
    tags: ["platinum_custom_2h_past5","seller_prd_promotion"],
    dependencies: ["seller_prd_promotion_rebate_result_item"]
}

/*
  Emmergency, every day you need to check if the records of wrong data is actually wrong
  If it not acctually wrong then you need to add new deleted action to silver to pass through this filter wrong deleted

  This filter wrong deleted only check if in same time (synced_at) has 2 action deleted and insert or updated, then
    it assume deleted is wrong
*/

WITH checkpoint_timestamp AS (
    SELECT max(ingest_time) ingest_time 
    FROM ${source.platinum}.seller_prd_promotion_rebate_result_item
), wrong_deleted_records_1 AS (
  SELECT mg_id, ingest_time, last_updated_time, TIMESTAMP_TRUNC(synced_at, SECOND) synced_at, action, ROW_NUMBER() OVER(_window) r
  FROM ${source.silver}.seller_prd_promotion_rebate_result_item
  WHERE ingest_time <= (SELECT ingest_time FROM checkpoint_timestamp)

  WINDOW _window AS (PARTITION BY mg_id ORDER BY synced_at DESC, IF(action='d',3,IF(action='u',2,1)) DESC, last_updated_time desc)
), wrong_deleted_records_2 AS (
  SELECT tbl1.mg_id, tbl1.ingest_time, tbl1.synced_at,tbl2.synced_at,  tbl1.action, tbl2.action, tbl1.r
  FROM wrong_deleted_records_1 tbl1 
  LEFT JOIN wrong_deleted_records_1 tbl2 
    ON tbl1.mg_id = tbl2.mg_id 
      AND tbl1.synced_at = tbl2.synced_at 
      and tbl1.r  + 1  = tbl2.r
  WHERE tbl1.action = 'd'
  AND tbl2.action is not null
  AND tbl2.action <> "d"
  AND tbl1.r  = 1
)

SELECT * FROM wrong_deleted_records_2
WHERE mg_id IN (

SELECT 
    a.mg_id 
FROM wrong_deleted_records_2 a
LEFT JOIN  ${ref(`seller_prd_promotion_rebate_result_item`)} b 
  ON a.mg_id = b.mg_id 
WHERE b.mg_id is null

)

