config {
    type: "incremental",
    name: "seller_prd_promotion_rebate_result_item",
    schema: "platinum_buymed_vn",
    assertions: {
        uniqueKey: 'mg_id',
        nonNull: ["created_date"]
    },
    bigquery: {
        partitionBy: "created_date"
    },
    tags: ["platinum_custom_2h_past5","seller_prd_promotion"]
}

pre_operations {
  ${
    when(incremental(),
      `
        # Incremental
        DECLARE has_new_data BOOLEAN;
        -- DECLARE Support_Ingest_checkpoint DATE;  # Only sp big table
        DECLARE Ingest_checkpoint TIMESTAMP;
        DECLARE checkpoint_date ARRAY<date>;
        DECLARE deleted_records ARRAY<STRING>;
        
        -- SET Support_Ingest_checkpoint = (SELECT DATE(CURRENT_DATE() - INTERVAL 1 DAY));
        SET Ingest_checkpoint = (SELECT max(ingest_time) FROM ${self()});

        SET ( has_new_data, checkpoint_date, deleted_records ) = ( 
            SELECT AS STRUCT 
                IF ( 
                    COUNT(*) > 0 , TRUE, FALSE 
                ) has_new_data,
                /* 
                    has_new_data describe the existance of data after the last refresh time of platinum 
                */
                ARRAY_AGG(
                    DISTINCT IF(created_time is NULL, "2099-01-01" , DATE( DATETIME(created_time,'Asia/Ho_Chi_Minh') ) )
                ) AS checkpoint_date,
                ARRAY_AGG (
                    DISTINCT IF(action = 'd',mg_id, NULL) IGNORE NULLS
                ) AS deleted_records
            FROM ${source.silver}.seller_prd_promotion_rebate_result_item
            WHERE ingest_time > Ingest_checkpoint 
        );

        CREATE TEMP TABLE new_records AS (
          SELECT DISTINCT mg_id
          FROM ${source.silver}.seller_prd_promotion_rebate_result_item
          WHERE ingest_time > Ingest_checkpoint 
        );

        IF ( has_new_data = TRUE ) THEN
            IF (SELECT ARRAY_LENGTH(deleted_records) > 0) THEN 
              SET checkpoint_date = ARRAY( 
                SELECT DISTINCT created_date
                FROM ${self()} 
                WHERE mg_id IN (SELECT mg_id FROM new_records)
              );
            END IF;

            DELETE FROM ${self()}
            WHERE 
                created_date IN UNNEST(checkpoint_date)
                AND mg_id IN (SELECT mg_id FROM new_records)
            ;
        ELSE 
            SET Ingest_checkpoint = TIMESTAMP("2099-01-01T00:00:00");
        END IF ;

    
      `,
      ``
    )
  }
}

--
WITH wrong_deleted_records_1 AS (
    SELECT mg_id, last_updated_time, TIMESTAMP_TRUNC(synced_at, SECOND) synced_at, action, ROW_NUMBER() OVER(_window) r
    FROM silver_buymed_vn.seller_prd_promotion_rebate_result_item
    ${when(incremental(), `WHERE ingest_time > Ingest_checkpoint - INTERVAL 2 HOUR AND mg_id IN (SELECT mg_id FROM new_records)`, ``)}
    WINDOW _window AS (PARTITION BY mg_id ORDER BY synced_at DESC, IF(action='d',3,IF(action='u',2,1)) DESC, last_updated_time DESC)
)
, wrong_deleted_records_2 AS (
SELECT tbl1.mg_id, tbl1.synced_at,tbl2.synced_at,  tbl1.action, tbl2.action, tbl1.r
FROM wrong_deleted_records_1 tbl1 
LEFT JOIN wrong_deleted_records_1 tbl2 
    ON tbl1.mg_id = tbl2.mg_id 
    AND tbl1.synced_at = tbl2.synced_at 
    and tbl1.r  + 1  = tbl2.r
WHERE tbl1.action = 'd'
AND tbl2.action is not null
AND tbl2.action <> "d"
AND tbl1.r  = 1
)
SELECT
*,
CASE 
    WHEN created_time IS NOT NULL THEN DATE(DATETIME(created_time,'Asia/Ho_Chi_Minh'))
    ELSE "2099-01-01"
END AS created_date
FROM ${source.silver}.seller_prd_promotion_rebate_result_item o 
${ when(incremental(), `
WHERE ingest_time > Ingest_checkpoint - INTERVAL 2 HOUR
    AND mg_id IN (SELECT mg_id FROM new_records)
` )}

QUALIFY ROW_NUMBER() OVER (_window) = 1 AND FIRST_VALUE(action) OVER (_window) <> 'd'
WINDOW
_window AS (
PARTITION BY
    mg_id
ORDER BY
    synced_at DESC,
IF
    (action='d',3,
    IF
    (action='u',2,1)) DESC,
    last_updated_time DESC
)

UNION ALL
SELECT 
*,
CASE 
    WHEN created_time IS NOT NULL THEN DATE(DATETIME(created_time,'Asia/Ho_Chi_Minh'))
    ELSE "2099-01-01"
END AS created_date
FROM ${source.silver}.seller_prd_promotion_rebate_result_item
WHERE mg_id IN ( SELECT mg_id FROM wrong_deleted_records_2)
${when(incremental() , `
    AND ingest_time > Ingest_checkpoint - INTERVAL 2 HOUR
    AND mg_id IN (SELECT mg_id FROM new_records)
`,``)}
QUALIFY ROW_NUMBER() OVER(_window) = 1
WINDOW _window AS (PARTITION BY mg_id ORDER BY synced_at DESC, IF(action='d',3,2) ASC, last_updated_time desc)


