config {
    type: "table",
    description: `PIC: dong.le & minh.luu; model_type: table; schedule daily at 12am
    SOURCE:
        ${source.silver}.warehouse_prd_inventory_location
        ${source.silver}.warehouse_prd_inventory_sku_location_merge`,
    name: "dim_fc_location",
    tags: ["0h00"],
    assertions: {
      uniqueKey: ['location_fc_code'],
      nonNull: ['location_fc_code']
    },
    columns: {
      location_fc_code: "concatenation of location and warehouse code",
      location_code: "location identifier",
      fc_code: "warehouse code",
      type: "type of item",
      shelf_type: "type of shelf",
      width: "width of the shelf",
      length: "length of the shelf",
      height: "height of the shelf",
      zone_code: "zone code extracted from the first 2 characters of code or the entire code if shelf_type is null",
      shelf_code: "shelf code extracted from characters 3 to 5 of code or the entire code if shelf_type is null",
      shelf_level: "shelf level extracted from the 6th character of code or the entire code if shelf_type is null",
      location_number: "location number extracted from the 7th character onward of code or the entire code if shelf_type is null",
      parent_order: "parent order value",
      parent_location_code: "last value in the parent order array"
    }
}

WITH
  dedup_inventory_location AS ${dedup.dedup(
  "lakehouse-prod-394907.silver_buymed_vn.warehouse_prd_inventory_location",
  "warehouse_code, code, type, parent_order, shelf_type, width, length, height"
)}
,

cte_main as (
  select 
    a.warehouse_code
    , a.location_code
    from ${dedup.dedup(
      "lakehouse-prod-394907.silver_buymed_vn.warehouse_prd_inventory_sku_location_merge",
      "warehouse_code, location_code, stock_quantity")} 
      as a
    where a.warehouse_code IN ("HN", "BD", "DN") and a.location_code IS NOT NULL
    group by 1, 2
)

SELECT
    CONCAT(m.location_code, "_", m.warehouse_code) as location_fc_code,
    m.location_code as location_code,
    m.warehouse_code as fc_code,
    a.type,
    a.shelf_type,
    a.width,
    a.length,
    a.height,
    case
    when a.shelf_type is null then code
    else SUBSTR(code, 1, 2) 
    end AS zone_code
    , case
    when a.shelf_type is null then code
    else SUBSTR(code, 3, 3)  
    end AS shelf_code
    , case
    when a.shelf_type is null then code
    else SUBSTR(code, 6, 1)  
    end AS shelf_level
    , case
    when a.shelf_type is null then code
    else SUBSTR(code, 7)  
    end AS location_number,
    a.parent_order,
    json_value_array( a.parent_order )[offset(array_length(json_value_array( a.parent_order )) - 1)] as parent_location_code
FROM cte_main m
LEFT JOIN dedup_inventory_location a
ON m.warehouse_code = a.warehouse_code AND m.location_code = a.code

post_operations {                
    ALTER TABLE ${self()} ADD PRIMARY KEY (location_fc_code) NOT ENFORCED;
}