config {
    type: "view",
    description: "Source: dim_sku_item_vendors. Extracts the vendor code with lowest priority score for each sku item. PIC: dong.le",
    name: "dim_sku_item_fv_vendor",
    columns: {
    }
}

SELECT
  sku_fc_code,
  sku_code,
  fc_code,
  vendor_code
FROM (
  SELECT
    *,
    ROW_NUMBER() OVER (PARTITION BY sku_fc_code ORDER BY vendor_priority ASC) AS rn
  FROM
    ${ref("dim_sku_item_vendors")} a
)
WHERE rn = 1