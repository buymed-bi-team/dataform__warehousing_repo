config {
    type: "table",
    description: "Fulfillment Center (FC)",
    columns: {
        fc_code: docs.fc_code,
        fc_name:"The name of each warehouse",
        fc_report_category: `Categorizes the warehouse into reporting groups: "CIRCA", "FC", or "FC-INACTIVE" based on group code and status. Note: filter FC for actual fulfillment center`,
        status:"The current operational status of each warehouse (ACTIVE, INACTIVE)",
        sales_region_code: "Identifies the sales region code for each warehouse, translated from warehouse code. (MIENBAC, MIENNAM, MIENTRUNG)",
        purchaser_code: `Identifies the purchaser code for each warehouse, derived from warehouse code. (PUR_HN, PUR_HCM, PUR_DN)`
        
    }
}

select 
    wh.code as fc_code
    , wh.name as fc_name
    , wh.status
    , CASE
        when json_value(wh.extra_props, "$.group_code") = "CIRCA" then "CIRCA"
        when json_value(wh.extra_props, "$.group_code") = "BUYMED" and wh.status = "ACTIVE" then "FC"
        when json_value(wh.extra_props, "$.group_code") = "BUYMED" and wh.status = "INACTIVE" then "FC-INACTIVE"
        else NULL
    end as fc_report_category
    , wh.areas as service_areas
    , CASE
        when wh.code = 'HN' THEN 'MIENBAC'
        when wh.code = 'BD' THEN 'MIENNAM'
        when wh.code = 'DN' THEN 'MIENTRUNG'
    end as sales_region_code
    , CASE
        when wh.code = 'HN' THEN 'PUR_HN'
        when wh.code = 'BD' THEN 'PUR_HCM'
        when wh.code = 'DN' THEN 'PUR_DN'
    end as purchaser_code
FROM ${ref("dedup_warehouse_prd_core_warehouse")} as wh


post_operations {                
    ALTER TABLE ${self()} ADD PRIMARY KEY (fc_code) NOT ENFORCED;
}
