config {
    type: "view",
    description: " PIC: dong.le",
    name: "agg_latest_pick_by_sku_fc"
}

SELECT
    a.sku,
    a.warehouse_code,
    MAX(a.created_time) + INTERVAL 7 HOUR AS latest_pick_time,
    TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), MAX(a.created_time), DAY) AS aging_pick,
    MAX(a.ticket_id) as latest_pick_ticket_id,
    MAX(b.so) as latest_so
FROM ${ref("dedup_warehouse_prd_picking_pick_ticket_item")} a
JOIN ${ref("dedup_warehouse_prd_picking_pick_ticket")} b
ON a.ticket_id = b.ticket_id
GROUP BY 1, 2