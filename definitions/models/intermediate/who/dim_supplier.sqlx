config {
    type: "table",
    description: `PIC: minh.luu; model_type: table; Schedule: hourly
    Source: 
        ${source.silver}.seller_prd_core_seller`,
    name: "dim_supplier",
    tags: ["custom_1h_past5"],
    assertions:{
        uniqueKey:'supplier_code'
    },
    columns: {
        supplier_code: docs.supplier_code,
        supplier_type:"It categorizes suppliers into different types: Enterprise, Individual and so on",
        supplier_sku_trading_type: "Categorizes as NON-TRADING if the supplier is not the favorite vendor of any sku item, otherwise equals to seller_type",
        supplier_class:"Seller-External, Seller-Internal, or Vendor",
        supplier_name:"It assigns the supplier's name based on their class; if the class is 'INTERNAL' or 'PURCHASER', the code is used as the name, otherwise, the name field is used.",
        supplier_status:`Status of supplier, can be one of (ACTIVE, STOP_COOPERATING, DRAFT, INACTIVE)`
    }
}

/*
    supplier_type:
        - INDIVIDUAL:
        - TRADING :
        - ENTERPRISE :
        - NON-TRADING :
        - BIZ_HOUSEHOLD :
        - MARKET : 
        - `null` : unknow
*/


SELECT 
    s.code AS supplier_code,          -- primary key, 
    s.seller_id AS supplier_id,
    IF ( s.seller_type IS NULL , "UNKNOWN", s.seller_type ) AS supplier_type,  -- 310 null,  6 unique value
    IF ( 
        REGEXP_CONTAINS( UPPER(s.name), r'TECH SELLER|TEST|TECH-QC|TS-TECH|\[TECH\]|\(TECH\)|DEMO|QC|TECH MONITOR|TECH 2')
        AND NOT name LIKE "Abbott  test- Sang Pharma" , 
        "TECH" ,
        s.seller_class ) 
    AS supplier_class, -- not null,  4 unique value
    CASE
        WHEN s.seller_class in ("INTERNAL", "PURCHASER") THEN code
        ELSE name
    END as supplier_name,
    s.status AS supplier_status,
    s.extra_props as supplier_extra_props

FROM
    ${dedup.dedup(
        source.silver + `.seller_prd_core_seller`,
        "*"
    )} s

post_operations {
    ALTER TABLE ${self()} ALTER COLUMN supplier_type SET DEFAULT "UNKNOWN";
    ALTER TABLE ${self()} ADD PRIMARY KEY (supplier_code) NOT ENFORCED;
}


