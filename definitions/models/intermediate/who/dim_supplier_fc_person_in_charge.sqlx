config {
    type: "view",
    name: "dim_supplier_fc_person_in_charge",
    description: "PIC: minh,luu; model_type: view",
    columns: {
        supplier_code   : docs.supplier_code,
        fc_code         : docs.fc_code,
        pic_purchase_id : docs.pic_purchase_id,
        cic_category_id : docs.cic_category_id,
        pic_purchase_name: "Name of the employee who is related to pic",
        cic_category_name: "Name of the employee who is related to cic",
    }
}
WITH core_pic AS ${dedup.dedup(
    `${source.silver}.seller_prd_core_pic`,
    `
    action,
    object_code as supplier_code,
    warehouse_code as fc_code,
    pic_account_id AS pic_purchase_id,
    cic_account_id AS cic_category_id,
    object_type
    `
)}
, purchasing_pic AS ${dedup.dedup(
    `${source.silver}.seller_prd_purchasing_pic`,
        `
        action,
        object_code as supplier_code,
        warehouse_code as fc_code,
        pic_account_id AS pic_purchase_id,
        cic_account_id AS cic_category_id,
        object_type
        `
)}, cte_main AS (
        SELECT * except(object_type) FROM purchasing_pic
        WHERE 
            object_type = "VENDOR" 
        QUALIFY ROW_NUMBER() OVER(PARTITION BY supplier_code, fc_code) = 1
        UNION ALL 
        SELECT * except(object_type) FROM core_pic
        WHERE 
            object_type = "SELLER"
        QUALIFY ROW_NUMBER() OVER(PARTITION BY supplier_code, fc_code) = 1
)
, dedup_pic AS ${dedup.dedup(
    `cte_main`,
    `*`
)}

SELECT
    supplier_code,
    fc_code,
    pic_purchase_id,
    cic_category_id,
    dim_employee_1.fullname as pic_purchase_name,
    dim_employee_2.fullname as cic_category_name,
    dim_employee_1.user_name as pic_purchase_username,
    dim_employee_2.user_name as cic_category_username
FROM
    dedup_pic
LEFT JOIN `lakehouse-prod-394907.gold_buymed_vn2.dim_employee` dim_employee_1
    ON pic_purchase_id = dim_employee_1.employee_id
LEFT JOIN `lakehouse-prod-394907.gold_buymed_vn2.dim_employee` dim_employee_2
    ON cic_category_id = dim_employee_2.employee_id

