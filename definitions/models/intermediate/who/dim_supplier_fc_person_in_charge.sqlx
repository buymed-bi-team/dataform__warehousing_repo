config {
    type: "table",
    name: "dim_supplier_fc_person_in_charge",
    description: "PIC: minh,luu; model_type: table",
    columns: {
        supplier_code   : docs.supplier_code,
        fc_code         : docs.fc_code,
        pic_purchase_id : docs.pic_purchase_id,
        cic_category_id : docs.cic_category_id,
        pic_purchase_name: "Name of the employee who is related to pic",
        cic_category_name: "Name of the employee who is related to cic",
    },
    tags: ["custom_1h_past5"]
}
WITH core_pic AS (
    SELECT 
        action,
        object_code as supplier_code,
        warehouse_code as fc_code,
        pic_account_id AS pic_purchase_id,
        cic_account_id AS cic_category_id,
        object_type,
        synced_at,
        last_updated_time
    FROM ${source.platinum}.seller_prd_core_pic
)
, purchasing_pic AS (
    SELECT 
        action,
        object_code as supplier_code,
        warehouse_code as fc_code,
        pic_account_id AS pic_purchase_id,
        cic_account_id AS cic_category_id,
        object_type,
        synced_at,
        last_updated_time
    FROM ${source.platinum}.seller_prd_purchasing_pic
), cte_main AS (
        SELECT * except(object_type) FROM purchasing_pic
        WHERE 
            object_type = "VENDOR" 
        QUALIFY ROW_NUMBER() OVER(PARTITION BY supplier_code, fc_code ORDER BY synced_at DESC, last_updated_time DESC) = 1
        UNION ALL 
        SELECT * except(object_type) FROM core_pic
        WHERE 
            object_type = "SELLER"
        QUALIFY ROW_NUMBER() OVER(PARTITION BY supplier_code, fc_code ORDER BY synced_at DESC, last_updated_time DESC) = 1
)
, dedup_pic AS (
    SELECT *
    FROM cte_main
    QUALIFY ROW_NUMBER() OVER(PARTITION BY supplier_code, fc_code ORDER BY synced_at DESC, last_updated_time DESC) = 1
)

SELECT
    supplier_code,
    fc_code,
    pic_purchase_id,
    cic_category_id,
    dim_employee_1.fullname as pic_purchase_name,
    dim_employee_2.fullname as cic_category_name,
    dim_employee_1.user_name as pic_purchase_username,
    dim_employee_2.user_name as cic_category_username

FROM
    dedup_pic
LEFT JOIN ${ref('dim_employee')} dim_employee_1
    ON pic_purchase_id = dim_employee_1.branch_account_id AND dim_employee_1.employee_status= "ACTIVE"
LEFT JOIN ${ref('dim_employee')} dim_employee_2
    ON cic_category_id = dim_employee_2.branch_account_id AND dim_employee_2.employee_status= "ACTIVE"

