config {
    type: "table",
    name: "dim_employee",
    assertions: {
        uniqueKey: ["employee_id"],
        nonNull: ["employee_status","fullname"]
    },
    description:"Employee table within VN branch | PIC: minh.luu; model type: table; schedule: 0h00\nSource: platform_human_resource_prd_employee_employee_info",
    columns: {
        employee_id:"NonNull",
        branch_account_id:"The unique identifier for the employee. This ID is branch_account_id field within the user_branch_infos JSON array",
        user_name:"",
        email:"The email address of the employee",
        fullname: " The full name of the employee",
        department: "department of employee",
        job_title: "employee position",
        employee_status: "The current employment status of the employee. This indicates whether the employee is ACTIVE, TERMINATED"
    },
    tags: ["0h00"]
}

WITH dedup_human_resource AS ${dedup.dedup(
    source.silver + `.platform_human_resource_prd_employee_employee_info`,
    `        
    employee_id,       
    email,
    user_name,
    full_name as fullname,
    status as employee_status,
    employee_department as department,
    employee_position as job_title,
    user_branch_infos
    `
)},

    employee_phone_number AS (
        SELECT
            LPAD(code, 10, "0") AS phone_number
            , LOWER(value) as email
        FROM ${source.collector}.data_prd
        WHERE
            object = 'Phone_PIC'
            AND type = 'EMPLOYEE_MAIL'
            AND submit_id >= 5066
            -- AND submit_id <> 5079
        QUALIFY ROW_NUMBER() over (PARTITION BY code, object, type ORDER BY submit_id DESC) = 1
    )

SELECT 
    a.employee_id,
    CAST(json_value(branch.branch_account_id) AS INTEGER) AS branch_account_id,
    a.email,
    a.user_name,
    a.fullname,
    a.department,
    a.job_title,
    a.employee_status,
     COALESCE(c.phone_number, d.phone_number) AS phone_number,
    IF(d.phone_number IS NOT NULL, "RIDER", "EMPLOYEE") AS type
FROM dedup_human_resource AS a,
    UNNEST(JSON_EXTRACT_ARRAY(user_branch_infos)) as branch
    LEFT JOIN employee_phone_number AS c 
        ON c.email = a.email
    LEFT JOIN employee_phone_number AS d 
        ON d.email = LOWER(a.fullname)
WHERE JSON_VALUE(branch,'$.branch') LIKE "VN"
AND NOT REGEXP_CONTAINS(UPPER(a.fullname),"TEST|DEMO|/[TECH/]|AP CHECKL")

post_operations {
    ALTER TABLE ${self()} ADD PRIMARY KEY (employee_id) NOT ENFORCED;
}