config {
    type: "view",
    description: " PIC: dong.le",
    name: "agg_latest_put_by_sku_fc"
}

WITH LatestPutCombined AS (
    SELECT
        JSON_VALUE(b.extra_props, '$.inbound_code') AS inbound_code,
        JSON_VALUE(b.extra_props, '$.parent_ref') AS code,
        JSON_EXTRACT_SCALAR(sku_code) AS sku
    FROM ${source.platinum}.warehouse_prd_inbound_put_ticket_item a
        JOIN ${source.platinum}.warehouse_prd_inbound_put_ticket b
            ON a.put_code = b.code
        , UNNEST(JSON_EXTRACT_ARRAY(b.extra_props, '$.skus')) AS sku_code
    WHERE
        REGEXP_CONTAINS(
            COALESCE(JSON_EXTRACT_SCALAR(b.extra_props, '$.inbound_code')
            , JSON_VALUE(b.extra_props, '$.suggest_reference_codes.0'))
            , r'PO|PGH|TO'
        ) AND b.status <> "CANCEL" 
    GROUP BY ALL
    
),

LatestPut AS (
    SELECT
        a.sku,
        a.warehouse_code,
        MAX(b.end_put_time) AS latest_put_time
    FROM ${source.platinum}.warehouse_prd_inbound_put_ticket_item a
    JOIN ${source.platinum}.warehouse_prd_inbound_put_ticket b
        ON a.put_code = b.code
    WHERE
        REGEXP_CONTAINS(
            COALESCE(JSON_EXTRACT_SCALAR(b.extra_props, '$.inbound_code')
            , JSON_VALUE(b.extra_props, '$.suggest_reference_codes.0'))
            , r'PO|PGH|TO'
        ) AND
        b.status <> "CANCEL"
    GROUP BY ALL),

LatestFinalPut AS (
SELECT
        a.sku,
        p.product_name,
        a.warehouse_code,
        b.code,
        b.status,
        b.end_put_time AS latest_time
    FROM ${source.platinum}.warehouse_prd_inbound_put_ticket_item a
    JOIN ${source.platinum}.warehouse_prd_inbound_put_ticket b
        ON a.put_code = b.code
    LEFT JOIN ${ref("dim_product")} p
        ON a.product_id = p.product_id
    WHERE
        b.status <> "CANCEL" and b.code <> 'PUT-2284711' 
    QUALIFY
        ROW_NUMBER() OVER (PARTITION BY a.sku, a.warehouse_code ORDER BY b.end_put_time DESC) = 1) 

SELECT DISTINCT
    f.sku,
    f.product_name,
    f.warehouse_code,
    l.latest_put_time,
    TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), l.latest_put_time, DAY) AS aging_put_days,
    b.code AS latest_put_code,
    f.code AS final_put_code,
    TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), f.latest_time, DAY) AS aging_final_days,
    COALESCE(p.inbound_code, json_value(b.extra_props, "$.inbound_code")) AS latest_inbound_code
FROM LatestPut l
JOIN ${source.platinum}.warehouse_prd_inbound_put_ticket_item a
    ON l.sku = a.sku
    AND l.warehouse_code = a.warehouse_code
JOIN ${source.platinum}.warehouse_prd_inbound_put_ticket b
    ON a.put_code = b.code
    AND l.latest_put_time = b.end_put_time
LEFT JOIN LatestPutCombined p
    ON l.sku = p.sku
    AND b.code = p.code
RIGHT JOIN LatestFinalPut f
    ON l.sku = f.sku
    AND l.warehouse_code = f.warehouse_code