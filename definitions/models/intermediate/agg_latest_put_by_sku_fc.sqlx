config {
    type: "view",
    description: " PIC: dong.le",
    name: "agg_latest_put_by_sku_fc"
}

SELECT
    sku,
    warehouse_code,
    MAX(created_time) + INTERVAL 7 HOUR AS ts_latest_put,
    TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), MAX(created_time), DAY) AS aging_put
FROM ${ref("dedup_warehouse_prd_inbound_put_ticket_item")} o
GROUP BY 1, 2