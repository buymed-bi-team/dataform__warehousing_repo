config {
    type: "view",
    description: " PIC: dong.le",
    name: "agg_latest_put_by_sku_fc"
}

WITH LatestPut AS (
    SELECT
        a.sku,
        a.warehouse_code,
        MAX(b.end_put_time) AS latest_put_time
    FROM ${source.platinum}.warehouse_prd_inbound_put_ticket_item a
    JOIN ${source.platinum}.warehouse_prd_inbound_put_ticket b
        ON a.put_code = b.code
    -- LEFT JOIN ${ref("dim_inbound_ticket")} c
    --     ON json_value(b.extra_props, "$.inbound_code") = c.po_code
    WHERE
        -- c.inbound_type = "PURCHASE" and
        REGEXP_CONTAINS(
            COALESCE(JSON_EXTRACT_SCALAR(b.extra_props, '$.inbound_code')
            , JSON_VALUE(b.extra_props, '$.suggest_reference_codes.0'))
            , r'PO|PGH'
        ) AND
        b.status <> "CANCEL"
    GROUP BY 1, 2
    
),

LatestFinalPut AS (
SELECT
        a.sku,
        a.warehouse_code,
        b.code,
        b.status,
        b.end_put_time AS latest_time
    FROM ${source.platinum}.warehouse_prd_inbound_put_ticket_item a
    JOIN ${source.platinum}.warehouse_prd_inbound_put_ticket b
        ON a.put_code = b.code
    WHERE
        b.status <> "CANCEL"
    QUALIFY
        ROW_NUMBER() OVER (PARTITION BY a.sku, a.warehouse_code ORDER BY b.end_put_time DESC) = 1) 


SELECT DISTINCT
    l.sku,
    l.warehouse_code,
    TIMESTAMP_ADD(l.latest_put_time, interval 7 hour) AS latest_put_time,
    TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), TIMESTAMP_ADD(l.latest_put_time, interval 7 hour), DAY) AS aging_put_days,
    b.code AS latest_put_code,
    f.code AS final_put_code,
    TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), TIMESTAMP_ADD(f.latest_time, interval 7 hour), DAY) AS aging_final_days,
    COALESCE(json_value(b.extra_props, "$.inbound_code")
    , JSON_VALUE(b.extra_props, '$.suggest_reference_codes.0')) AS latest_inbound_code
FROM LatestPut l
JOIN ${source.platinum}.warehouse_prd_inbound_put_ticket_item a
    ON l.sku = a.sku
    AND l.warehouse_code = a.warehouse_code
JOIN ${source.platinum}.warehouse_prd_inbound_put_ticket b
    ON a.put_code = b.code
    AND l.latest_put_time = b.end_put_time
LEFT JOIN LatestFinalPut f
    ON l.sku = f.sku
    AND l.warehouse_code = f.warehouse_code
