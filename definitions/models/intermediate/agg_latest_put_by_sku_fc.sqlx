config {
    type: "view",
    description: " PIC: dong.le",
    name: "agg_latest_put_by_sku_fc"
}

WITH LatestPut AS (
    SELECT
        a.sku,
        a.warehouse_code,
        MAX(a.created_time) AS latest_put_time
    FROM ${ref("dedup_warehouse_prd_inbound_put_ticket_item")} a
    JOIN ${ref("dedup_warehouse_prd_inbound_put_ticket")} b
        ON a.put_code = b.code
    LEFT JOIN ${ref("dim_inbound_ticket")} c
        ON json_value(b.extra_props, "$.inbound_code") = c.po_code
    WHERE c.inbound_type = "PURCHASE"
    GROUP BY 1, 2
    
)

SELECT
    l.sku,
    l.warehouse_code,
    l.latest_put_time,
    TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), l.latest_put_time, DAY) AS aging_put_days,
    b.code AS latest_put_code,
    json_value(b.extra_props, "$.inbound_code") AS latest_inbound_code
FROM LatestPut l
JOIN ${ref("dedup_warehouse_prd_inbound_put_ticket_item")} a
    ON l.sku = a.sku
    AND l.warehouse_code = a.warehouse_code
    AND l.latest_put_time = a.created_time
JOIN ${ref("dedup_warehouse_prd_inbound_put_ticket")} b
    ON a.put_code = b.code
