config {
    type: "table",
    description: "PIC: Minh.luu; Model_Type: table; Schedule: 0h,7h,10h,13h,16h,18h",
    //assertions: {
    //    uniqueKey: ["sku_key"],
    //    // nullable : seller_class vì một số seller_code không có trong seller_prd_core_seller table
    //    nonNull: ["seller_class","product_id","sku_code","seller_class"]
    //},
    tags: ["0h00","7h00","10h00","13h00","16h00","18h00"],
    columns: {
        sku_code: "The unique identifier for each SKU. Note: Except 2 error SKUs are MEDX.AGI-AGi-001 and MEDX.test.",
        product_id: "The identifier for the product associated with the SKU. Each product can have multiple SKUs",
        product_name: "The name of product",
        seller_code: "The unique code for the seller providing the SKU",
        sku_key: "A composite key generated by concatenating product_id and seller_code with an underscore. This key uniquely identifies the combination of product and seller",
        seller_class: "The classification of the seller, indicating their category or tier. This is used to categorize sellers based on predefined criteria", // MARKERTING, BUYMED
    }
}

/*
*/

WITH dedup_sku_main as -- 83MB
${dedup.dedup(
    source.silver + `.marketplace_prd_product_v2_sku_main_v2`,
    `
    code as sku_code,
    product_id,
    seller_code
    `
)}
, dedup_seller AS
${dedup.dedup(
    source.silver + `.seller_prd_core_seller`,
    `
    seller_class,
    code seller_code
    `
)}
, dedup_product AS 
${dedup.dedup(
    source.silver + `.marketplace_prd_product_v2_product`,
    `
    product_id,
    name as product_name
    `
)}
SELECT
    sku_code,
    dedup_sku_main.product_id,
    dedup_product.product_name,
    dedup_sku_main.seller_code,
    dedup_sku_main.product_id || "_" || dedup_sku_main.seller_code as sku_key,
    seller_class
FROM dedup_sku_main
INNER JOIN dedup_seller
ON dedup_sku_main.seller_code = dedup_seller.seller_code
LEFT JOIN dedup_product
ON dedup_sku_main.product_id = dedup_product.product_id
WHERE
    dedup_sku_main.seller_code <> 'Med_NT' 
    -- and sku_code not in ( -- loại trừ những trường
    --     select sku_code 
    --     from dedup_sku_main
    --     where upper(sku_code) in (
    --         select upper(sku_code)
    --         from dedup_sku_main
    --         where REGEXP_CONTAINS(sku_code, r'[a-z]')
    --         INTERSECT distinct
    --         select sku_code
    --         from dedup_sku_main
    --         where NOT REGEXP_CONTAINS(sku_code, r'[a-z]')
    --     )
    --     and REGEXP_CONTAINS(sku_code, r'[a-z]')
    -- )

post_operations {                
    ALTER TABLE ${self()} ADD PRIMARY KEY (sku_key) NOT ENFORCED;
}