config {
    type: "table",
    description: "PIC: Minh.luu; Model_Type: table; Schedule: 0h,7h,10h,13h,16h,18h",
    //assertions: {
    //    uniqueKey: ["sku_key"],
    //    // nullable : seller_class vì một số seller_code không có trong seller_prd_core_seller table
    //    nonNull: ["seller_class","product_id","sku_code","seller_class"]
    //},
    tags: ["0h00","7h00","10h00","13h00","16h00","18h00"],
    columns: {
        sku_code: "Mã SKU. Lưu ý: Đã loại bỏ 2 SKU bị lỗi là MEDX.AGI-AGi-001 và MEDX.test.",
        product_id: "Id của sản phẩm",
        sku_key: "Primary key - ",
        seller_code: "Mã của nhà bán hàng. Đã loại bỏ mã MEDX-HN", // MARKERTING, BUYMED
    }
}
/*
TODO
    - In research
*/

WITH dedup_sku_main as -- 83MB
( 
    SELECT 
        code as sku_code,
        product_id,
        seller_code
    FROM silver_buymed_vn.marketplace_prd_product_v2_sku_main_v2 
    QUALIFY ROW_NUMBER() OVER(_window) = 1 AND FIRST_VALUE(action) over(_window) <> 'd'
    WINDOW _window AS (PARTITION BY mg_id ORDER BY synced_at DESC, IF(action='d',3,IF(action='u',2,1)) DESC)
), dedup_seller AS
(
    SELECT
        DISTINCT
        seller_class,
        code seller_code
    FROM silver_buymed_vn.seller_prd_core_seller
)
SELECT
    sku_code,
    product_id,
    dedup_sku_main.seller_code,
    product_id || "_" || dedup_sku_main.seller_code as sku_key,
    seller_class
FROM dedup_sku_main
INNER JOIN dedup_seller
ON dedup_sku_main.seller_code = dedup_seller.seller_code
WHERE
    dedup_sku_main.seller_code <> 'Med_NT' 
    -- and sku_code not in ( -- loại trừ những trường
    --     select sku_code 
    --     from dedup_sku_main
    --     where upper(sku_code) in (
    --         select upper(sku_code)
    --         from dedup_sku_main
    --         where REGEXP_CONTAINS(sku_code, r'[a-z]')
    --         INTERSECT distinct
    --         select sku_code
    --         from dedup_sku_main
    --         where NOT REGEXP_CONTAINS(sku_code, r'[a-z]')
    --     )
    --     and REGEXP_CONTAINS(sku_code, r'[a-z]')
    -- )

post_operations {                
    ALTER TABLE ${self()} ADD PRIMARY KEY (product_id) NOT ENFORCED
}