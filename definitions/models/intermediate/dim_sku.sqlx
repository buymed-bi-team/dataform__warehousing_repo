config {
    type: "table",
    description: "SKU dim table. PIC: Minh.luu",
    // tags: ["1HOUR","PRODUCT", "LISTING"],
    columns: {
        sku_code: "Primary key - Mã SKU. Lưu ý: Đã loại bỏ 2 SKU bị lỗi là MEDX.AGI-AGi-001 và MEDX.test.",
        sku_created_at: "Thời gian tạo SKU.",
        last_updated_time: "",
        product_id: "Id của sản phẩm",
        seller_code: "Mã của nhà bán hàng. Đã loại bỏ mã MEDX-HN", // MARKERTING, BUYMED
        is_combo: "Là combo hay không? ", // True, False, Null?
        sku_type: "Loại sản phẩm là 1 trong 3 NORMAL, COMBO, GIFT",
        // sku_status: "", // NORMAL, NULL?
        sku_active: "", // true, false, null?
    }
}
