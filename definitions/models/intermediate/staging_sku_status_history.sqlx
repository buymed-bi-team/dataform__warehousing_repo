config {
    type: "incremental",
    tags: ["adhoc-office"],
    description: "SKU status change history || PIC: anh.letam;  model_type: table; schedule: hourly",
    name: "staging_sku_status_history",
    bigquery: {
        partitionBy: "DATE(created_time)",
        clusterBy: ["item_code"]
    },

    tags: ["custom_1h_past5"]
    
}

-- extract sku, item_code and status, and filter the time status of item_cod changed

  SELECT
    JSON_VALUE(extra_props, "$.sku") AS sku,
    JSON_VALUE(extra_props, "$.item_code") AS item_code,
    JSON_VALUE(next, "$.seller_class") AS seller_class,
    created_time,
    JSON_VALUE(next, "$.status") AS status,
    cast(JSON_VALUE(next, "$.is_active") as boolean ) as is_active,
    ingest_time,
    key
  FROM
     ${source.silver}.marketplace_prd_product_v2_history_update_price  a
 ${ when(incremental(), `WHERE ingest_time > (SELECT MAX(ingest_time) FROM ${self()})`)}
  QUALIFY
    (status != LAG(status) OVER (PARTITION BY item_code ORDER BY created_time)) OR
    (LAG(status) OVER (PARTITION BY item_code ORDER BY created_time) IS NULL)


post_operations {
  ${
    when(incremental(),
      `
      DELETE FROM ${self()}
      WHERE key IN (
        SELECT key FROM (
          SELECT 
            key,
            status,
            LAG(status) OVER (PARTITION BY item_code ORDER BY created_time) AS prev_status
          FROM ${self()}
        ) 
        WHERE status = prev_status
      );
      `,
      ``
    )
  }
}