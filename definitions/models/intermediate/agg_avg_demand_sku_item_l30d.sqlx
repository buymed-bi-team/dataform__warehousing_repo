config {
  type: "view",
  description: "Source: fact_potential_sort, created_time in the last 30 days | PIC: dong.le",
  name: "agg_avg_demand_sku_item_l30d",
  columns: {
    sku_fc_key: "concatenation of sku key and warehouse code",
    avg_demand_l15d: "average daily order_quantity for each sku_fc_key in the last 15 days",
    avg_demand_l30d: "average daily order_quantity for each sku_fc_key in the last 30 days"
  }
}

WITH filtered_data AS (
    SELECT 
        a.sku_fc_key,
        a.order_quantity AS outgoing_quantity,
        a.created_date AS created_date
  FROM ${ref("fact_potential_sort")} a
  WHERE a.created_date >= date_sub(current_date(),interval 30 day)
  )

SELECT
    sku_fc_key,
    SUM(outgoing_quantity)/30 AS avg_demand_l30d,
    SUM(CASE 
        WHEN created_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 15 DAY) THEN outgoing_quantity
        ELSE 0
      END) / 15 AS avg_demand_l15d
FROM filtered_data
GROUP BY 1


  