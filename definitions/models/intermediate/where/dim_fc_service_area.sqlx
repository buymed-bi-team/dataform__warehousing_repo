config {
    type: "table",
    description: "PIC: dong.le",
    tags: ["0h00"],
    columns: {
        fc_code: "NonNull", 
        service_area_code: "NonNull | location_code - currently province code"
    }
    // assertions: {
    //     uniqueKey : ['service_area_code'],
    //     nonNull : ["fc_code","service_area_code"]
    // }
}

select
    fc.fc_code
    , json_extract_scalar(unnested_value) as service_area_code
    , fc.sales_region_code
from 
    ${ ref('dim_fc') } as fc,
    unnest( (json_extract_array(fc.service_areas, '$'))) as unnested_value

UNION ALL

SELECT 
    'BD' AS fc_code,
    '00' AS service_area_code,
    'MIENNAM' AS sales_region_code

UNION ALL

SELECT 
    'DN' AS fc_code,
    '00' AS service_area_code,
    'MIENTRUNG' AS sales_region_code

UNION ALL

SELECT 
    'HN' AS fc_code,
    '00' AS service_area_code,
    'MIENBAC' AS sales_region_code