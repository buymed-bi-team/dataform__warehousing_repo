config {
    type: "table",
    description: "PIC: dong.le",
    tags: ["0h00"],
    columns: {
        fc_code: "NonNull", 
        service_area_code: "NonNull | location_code - currently province code"
    }
    // assertions: {
    //     uniqueKey : ['service_area_code'],
    //     nonNull : ["fc_code","service_area_code"]
    // }
}

select
    fc.fc_code
    , json_extract_scalar(unnested_value) as service_area_code
    , fc.sales_region_code
    , "PROVINCE" AS area_type
from 
    (
        SELECT code, name, status, areas, extra_props
        FROM ${ref(`platinum_buymed_vn`, `warehouse_prd_core_warehouse` )}
    ) as fc,
    unnest( (json_extract_array(fc.service_areas, '$'))) as unnested_value

UNION ALL

SELECT "BD" AS fc_code, "00" AS service_area_code, "MIENNAM" AS sales_region_code, "EXTENSION" AS area_type
UNION ALL
SELECT "DN" AS fc_code, "00" AS service_area_code, "MIENTRUNG" AS sales_region_code, "EXTENSION" AS area_type
UNION ALL
SELECT "HN" AS fc_code, "00" AS service_area_code, "MIENBAC" AS sales_region_code, "EXTENSION" AS area_type
UNION ALL
SELECT "BD" AS fc_code, "0" AS service_area_code, "MIENNAM" AS sales_region_code, "EXTENSION" AS area_type
UNION ALL
SELECT "DN" AS fc_code, "0" AS service_area_code, "MIENTRUNG" AS sales_region_code, "EXTENSION" AS area_type
UNION ALL
SELECT "HN" AS fc_code, "0" AS service_area_code, "MIENBAC" AS sales_region_code, "EXTENSION" AS area_type
UNION ALL
SELECT "HN" AS fc_code, "1" AS service_area_code, "MIENBAC" AS sales_region_code, "EXTENSION" AS area_type
UNION ALL
SELECT "BD" AS fc_code, "MIENNAM" AS service_area_code, "MIENNAM" AS sales_region_code, "EXTENSION" AS area_type
UNION ALL
SELECT "DN" AS fc_code, "MIENTRUNG" AS service_area_code, "MIENTRUNG" AS sales_region_code, "EXTENSION" AS area_type
UNION ALL
SELECT "HN" AS fc_code, "MIENBAC" AS service_area_code, "MIENBAC" AS sales_region_code, "EXTENSION" AS area_type
UNION ALL
SELECT "BD" AS fc_code, "MN_ADM" AS service_area_code, "MIENNAM" AS sales_region_code, "EXTENSION" AS area_type
UNION ALL
SELECT "DN" AS fc_code, "MT_ADM" AS service_area_code, "MIENTRUNG" AS sales_region_code, "EXTENSION" AS area_type
UNION ALL
SELECT "HN" AS fc_code, "MB_ADM" AS service_area_code, "MIENBAC" AS sales_region_code, "EXTENSION" AS area_type
