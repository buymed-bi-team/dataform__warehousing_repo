config {
    type: "table",
    description: `PIC: minh.luu; model_type: table; schedule 0h00
    Source: 
        ${source.silver}.core_prd_master_data_district
        ${source.silver}.core_prd_master_data_ward
        ${source.silver}.core_prd_master_data_province
        ${source.silver}.core_prd_master_data_region`,
    assertions:{
        nonNull: ["location_code"],
        uniqueKey: ["location_code"]
    },
    name: "dim_geo_location",
    tags: ["0h00"],
    columns: {
        location_code: "NonNull | It is union code of ward district province region",
        location_name: "NonNull | ",
        location_class : "NonNull | It must be one of the following: WARD, DISTRICT, PROVINCE, REGION",
        ward_code : "Nullable | Null if island, or location class is not ward",
        ward_name : "Nullable | ",
        district_code : "Nullable | Null if location class is province region ",
        district_name : "Nullable | ",
        province_code : "Nullable |  Null if location class is region",
        province_name : "Nullable | ",
        region_code : "Nullable | ",
        region_name : "Nullable | ",
    }
}
-- location code can be every level code: ward, district, province, region
-- The categorized way is location_classs
-- when I am do adhoc, I use join with this table. How can I drill up and down location with smallest change?


WITH 
    dedup_district AS ${dedup.dedup(
        source.silver + `.core_prd_master_data_district`,
        `
        code,
        name as district_name,
        province_code
        `
    )},
    dedup_ward AS ${dedup.dedup(
        source.silver + `.core_prd_master_data_ward`,
        `
        code,
        name as ward_name,
        district_code
        `
    )},
    dedup_province AS ${dedup.dedup(
        source.silver + `.core_prd_master_data_province`,
        `
        code,
        name as province_name,
        region_code
        `
    )},
    dedup_region AS ${dedup.dedup(
        source.silver + `.core_prd_master_data_region`,
        `
        code,
        name as region_name
        `
    )}


SELECT
    dedup_ward.code AS location_code,
    dedup_ward.ward_name AS location_name,
    'WARD' AS location_class,
    dedup_ward.code as ward_code,
    dedup_ward.ward_name,
    dedup_district.code as district_code,
    dedup_district.district_name,
    dedup_province.code as province_code,
    dedup_province.province_name,
    dedup_region.code as region_code,
    dedup_region.region_name
FROM dedup_district 
LEFT JOIN dedup_ward
    ON dedup_district.code = dedup_ward.district_code
LEFT JOIN dedup_province
    ON dedup_province.code = dedup_district.province_code
LEFT JOIN dedup_region
    ON dedup_region.code = dedup_province.region_code
WHERE dedup_ward.code is not null

UNION ALL

SELECT
    dedup_district.code AS location_code,
    dedup_district.district_name AS location_name,
    'DISTRICT' AS location_class,
    NULL AS ward_code,
    NULL AS ward_name,
    dedup_district.code as district_code,
    dedup_district.district_name,
    dedup_province.code as province_code,
    dedup_province.province_name,
    dedup_region.code as region_code,
    dedup_region.region_name
FROM dedup_district 
LEFT JOIN dedup_province
    ON dedup_province.code = dedup_district.province_code
LEFT JOIN dedup_region
    ON dedup_region.code = dedup_province.region_code

UNION ALL

SELECT
    dedup_province.code AS location_code,
    dedup_province.province_name AS location_name,
    'PROVINCE' AS location_class,
    NULL AS ward_code,
    NULL AS ward_name,
    NULL AS district_code,
    NULL AS district_name,
    dedup_province.code as province_code,
    dedup_province.province_name,
    dedup_region.code as region_code,
    dedup_region.region_name
FROM dedup_province
LEFT JOIN dedup_region
    ON dedup_region.code = dedup_province.region_code

UNION ALL

SELECT
    dedup_region.code AS location_code,
    dedup_region.region_name AS location_name,
    'REGION' AS location_class,
    NULL AS ward_code,
    NULL AS ward_name,
    NULL AS district_code,
    NULL AS district_name,
    NULL AS province_code,
    NULL AS province_name,
    dedup_region.code as region_code,
    dedup_region.region_name
FROM dedup_region


post_operations {
    ALTER TABLE ${self()} ADD PRIMARY KEY (location_code) NOT ENFORCED;
}
