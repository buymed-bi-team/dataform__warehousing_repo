config {
    type: "table", 
    description: 
        `
        SKUs Tags;
        PIC: nguyen.tran; 
        Type: Table; 
        Refresh Schedule: hourly;
        Source: 
            ${source.platinum}.marketplace_prd_product_v2_sku,
            ${source.platinum}.marketplace_prd_product_v2_tag,
            ${source.ref}.dim_sku_sales_region_current
        `,
    tags: ["custom_1h_past5"]
}

WITH 
    cte_1 AS  (
        SELECT
            a.product_id,
            c.sku_code,
            a.seller_code,
            c.sku_key,
            c.sub_sku_code,
            c.sales_region_code,
            CONCAT(c.sku_code,"_",c.sales_region_code) as sku_sales_region_code,
            t as tag_code,
            b.name AS tag,
            COALESCE(b.name, t) AS tag_name,
            b.tag_id,
            TIMESTAMP_ADD(a.created_time, INTERVAL 7 HOUR) AS created_time,
            TIMESTAMP_ADD(a.last_updated_time, INTERVAL 7 HOUR) AS last_updated_time,
            b.visible,
            "SKU" AS type
        FROM ${source.platinum}.marketplace_prd_product_v2_sku AS a
            , UNNEST(JSON_VALUE_ARRAY(a.tags)) AS t
            LEFT JOIN ${source.platinum}.marketplace_prd_product_v2_tag AS b 
                ON t = b.code
            LEFT JOIN ${ref("dim_sku_sales_region_current")} c 
                ON a.mg_id = c.mg_id 
        WHERE 
            a.mg_id IS NOT NULL 
            AND c.sku_code IS NOT NULL
            AND b.tag_id IS NOT NULL
    )
    , cte_2 AS (
        SELECT
            a.product_id,
            c.sku_code,
            a.seller_code,
            c.sku_key,
            c.sub_sku_code,
            c.sales_region_code,
            CONCAT(c.sku_code,"_",c.sales_region_code) as sku_sales_region_code,
            t as tag_code,
            b.name AS tag,
            COALESCE(b.name, t) AS tag_name,
            b.tag_id,
            TIMESTAMP_ADD(a.created_time, INTERVAL 7 HOUR) AS created_time,
            TIMESTAMP_ADD(a.last_updated_time, INTERVAL 7 HOUR) AS last_updated_time,
            b.visible,
            "THUOCSI" AS type
        FROM ${source.platinum}.marketplace_prd_product_v2_sku_tag AS a
            , UNNEST(JSON_VALUE_ARRAY(a.region_codes)) AS r
            , UNNEST(JSON_VALUE_ARRAY(a.tags)) AS t
            LEFT JOIN ${source.platinum}.marketplace_prd_product_v2_tag AS b
                ON t = b.code
            LEFT JOIN ${ref("dim_sku_sales_region_current")} c
                ON r = c.sales_region_code AND a.sku = c.sku_code
        WHERE
            c.sku_code IS NOT NULL
            AND b.tag_id IS NOT NULL
    )
SELECT  *
FROM cte_1
UNION ALL
SELECT *
FROM cte_2