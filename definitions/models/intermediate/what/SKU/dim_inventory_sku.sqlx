config {
    type: "table", 
    description: 
        ` 
        The inventory quantity of SKUs at each warehouse;
        PIC: nguyen.tran; 
        Type: Table; 
        Refresh Schedule: hourly;
        Source: 
            ${source.platinum}.warehouse_prd_inventory_sku,
            ${source.ref}.dim_sku, 
            ${source.ref}.dim_incoming_quantity_sku
        `,
    tags: ["custom_1h_past5"]
}

WITH
    incoming AS (
        SELECT
            sku
            , fc_code
            , SUM(quantity) AS incoming_quantity
        FROM ${ref('dim_incoming_quantity_sku')}
        GROUP BY sku, fc_code
    ),

    po_draft AS (
        SELECT
            sku
            , b.warehouse_code AS fc_code
            , SUM(expect_quantity) AS po_draft_quantity
        FROM platinum_buymed_vn.seller_prd_purchasing_purchase_order_item AS a
            LEFT JOIN  platinum_buymed_vn.seller_prd_purchasing_purchase_order AS b
                ON a.po_code = b.po_code
        WHERE
            DATE( DATE_TRUNC(b.created_time, DAY)) >= DATE_SUB(CURRENT_DATE, interval 1 month)
            AND b.warehouse_code in ('BD', 'HN','DN')
            AND b.status = 'DRAFT'
        GROUP BY 1, 2
    ),

    unavailable AS (
        SELECT
            sku
            , ti.warehouse_code AS fc_code
            , SUM(order_quantity - quantity) AS unavailable_quantity
        FROM ${source.platinum}.warehouse_prd_picking_pick_ticket_item AS ti
            LEFT JOIN ${source.platinum}.warehouse_prd_picking_pick_ticket AS t 
                ON ti.ticket_id = t.ticket_id
        WHERE 
            ti.warehouse_code in ('BD', 'HN','DN')
            AND t.status NOT IN ('DONE', 'WAIT_TO_PICK', 'WAIT_TO_PACK', 'PICKING',
                    'WAIT_QC_CONFIRM', 'WAIT_TO_DELIVERY', 'QC_PROCESSING', 'PACKING', 'CANCEL')
            AND ti.created_date >= DATE_SUB(DATE_TRUNC(CURRENT_DATE("+7"), MONTH), INTERVAL 1 MONTH)
            AND t.created_date >= DATE_SUB(DATE_TRUNC(CURRENT_DATE("+7"), MONTH), INTERVAL 1 MONTH)
        GROUP BY ALL
    ),

    inventory AS (
        SELECT
            a.sku_code AS sku
            , a.sku_key
            , a.product_id
            , a.product_name
            , a.seller_code
            , b.warehouse_code AS fc_code
            , CONCAT(
                a.sku_code, '_', 
                CASE
                    WHEN b.warehouse_code = 'HN' then 'MIENBAC'
                    WHEN b.warehouse_code = 'BD' then 'MIENNAM'
                    WHEN b.warehouse_code = 'DN' then 'MIENTRUNG'
                END
            ) AS sku_sales_region
            , CONCAT(
                a.sku_key, '_', 
                CASE
                    WHEN b.warehouse_code = 'HN' then 'MIENBAC'
                    WHEN b.warehouse_code = 'BD' then 'MIENNAM'
                    WHEN b.warehouse_code = 'DN' then 'MIENTRUNG'
                END
            ) AS sku_key_sales_region
            , CONCAT(a.sku_code, '_', b.warehouse_code) AS sku_fc_code
            , b.stock_quantity
            , b.available_quantity
            , b.min_quantity
            , b.status AS sku_status
            , b.product_type
        FROM ${ref('dim_sku')} AS a
            LEFT JOIN ${source.platinum}.warehouse_prd_inventory_sku AS b 
                ON a.sku_code = b.sku
        WHERE
            b.warehouse_code in ('HN','BD','DN')
    )

SELECT
    a.*
    , b.incoming_quantity
    , u.unavailable_quantity
    , p.po_draft_quantity
FROM inventory AS a
    LEFT JOIN incoming AS b ON a.sku = b.sku AND a.fc_code = b.fc_code
    LEFT JOIN unavailable AS u ON u.sku = a.sku AND u.fc_code = a.fc_code
    LEFT JOIN po_draft AS p ON p.sku = a.sku AND p.fc_code = a.fc_code
QUALIFY ROW_NUMBER() OVER(PARTITION BY sku_key_sales_region) = 1