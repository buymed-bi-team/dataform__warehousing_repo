config {
    type: "table",
    description: 
        `
        Fulfillment Cut Off Route of each ticket (SO);
        PIC: nguyen.tran; 
        Type: Table; 
        Refresh Schedule: hourly;
        Source: 
            ${source.platinum}.warehouse_prd_picking_pick_ticket
        `,
    tags: ["FFM_CUTOFF", "custom_1h_past5"],
    columns: {
        ticket_id           : "The pick_ticket_id of SO",
        ready_for_pick_time : "The time when pick ticket ready",
        pack_done_time      : "The time when package was pack done",
        dow_ready_for_pick  : "Day of Week of ready for pick time",
        start_time          : "The active start hour of cuf-off route",
        cut_off_time        : "The cut-off hour of cut-off route",
        end_time            : "The active end hour of cut-off route",
        route_name          : "The cut-off route name",
        list_day_of_week    : "The list day of week of cut-off route",
        flag                : "Check if the cut-off route is suitable with SO ",
        is_same_day         : "Check if end active & cut-off hour are same day",
        cut_off_ts          : "The date and time of cut-off route"
    }
}

WITH
    route AS (
        SELECT
            ticket_id
            , TIMESTAMP_ADD(COALESCE(ready_for_pick_time, activation_time, start_time), INTERVAL 7 HOUR) AS ready_for_pick_time
            , TIMESTAMP_ADD(end_time, INTERVAL 7 HOUR) AS pack_done_time
            , CASE EXTRACT(DAYOFWEEK FROM TIMESTAMP_ADD(COALESCE(ready_for_pick_time, activation_time, start_time), INTERVAL 7 HOUR))
                WHEN 1 THEN "Sunday"
                WHEN 2 THEN "Monday"
                WHEN 3 THEN "Tuesday"
                WHEN 4 THEN "Wednesday"
                WHEN 5 THEN "Thursday"
                WHEN 6 THEN "Friday"
                WHEN 7 THEN "Saturday"
              END AS dow_ready_for_pick
            , SAFE_CAST( JSON_VALUE(r, '$.from_time') AS INT64 ) / 3600 AS start_hour
            , SAFE_CAST( JSON_VALUE(r, '$.cut_off_time') AS INT64 ) / 3600 AS cut_off_hour
            , SAFE_CAST( JSON_VALUE(r, '$.to_time') AS INT64 ) / 3600 AS end_hour
            , JSON_VALUE(r, '$.route_name') AS route_name
            , REGEXP_REPLACE(TO_JSON_STRING(JSON_QUERY(r, '$.day_of_week')), r'\[|\]|\"', "") AS list_day_of_week
            , TIMESTAMP_ADD(TIMESTAMP_SECONDS(NULLIF(SAFE_CAST(ts.picked_time AS INT64), 0)), INTERVAL 7 HOUR) AS carrier_picked_time
        FROM ${source.platinum}.warehouse_prd_picking_pick_ticket AS p
            , UNNEST(JSON_QUERY_ARRAY(extra_props, '$.route_details')) AS r
            LEFT JOIN (
                SELECT DISTINCT
                    reference_id
                    , delivery_order_code
                    , status
                FROM ${source.platinum}.warehouse_prd_core_delivery_order
            ) AS do ON do.reference_id = p.ticket_id AND do.status <> 'MERGED'
            LEFT JOIN ${source.platinum}.delivery_prd_transporting_shipping_order AS ts
                ON ts.reference_code = do.delivery_order_code
    ),

    cut_off_route AS (
        SELECT
            *
            , IF(
                EXTRACT(HOUR FROM ready_for_pick_time) + EXTRACT(MINUTE FROM ready_for_pick_time) / 60 + EXTRACT(SECOND FROM ready_for_pick_time) / 3600
                    BETWEEN start_hour AND end_hour
                AND STRPOS(list_day_of_week, dow_ready_for_pick) > 0 
                , TRUE
                , FALSE
              ) AS flag
            , IF(end_hour < cut_off_hour, TRUE, FALSE) AS is_same_day
        FROM route
        QUALIFY ROW_NUMBER() over (PARTITION BY ticket_id ORDER BY flag DESC, end_hour) = 1
    ),

    actual_route AS (
        SELECT
            ticket_id
            , ABS(
                TIMESTAMP_DIFF(
                    TIMESTAMP_SUB(carrier_picked_time, INTERVAL 210 MINUTE )
                    , PARSE_TIMESTAMP("%Y-%m-%d %H:%M", CONCAT(DATE(carrier_picked_time), " ", FLOOR(cut_off_hour), ":", FLOOR((cut_off_hour - FLOOR(cut_off_hour)) * 60)))
                    , SECOND
                ) / 3600
              ) AS flag
            , PARSE_TIMESTAMP("%Y-%m-%d %H:%M", CONCAT(DATE(carrier_picked_time), " ", FLOOR(cut_off_hour), ":", FLOOR((cut_off_hour - FLOOR(cut_off_hour)) * 60))) AS actual_route
        FROM route AS a
        QUALIFY ROW_NUMBER() over (PARTITION BY ticket_id ORDER BY flag ) = 1
    ),

    cut_off_time AS (
        SELECT
            *
            , IF(
                flag AND is_same_day
                , PARSE_TIMESTAMP("%Y-%m-%d %H:%M", CONCAT(DATE(ready_for_pick_time), " ", FLOOR(cut_off_hour), ":", FLOOR((cut_off_hour - FLOOR(cut_off_hour)) * 60)))
                , PARSE_TIMESTAMP("%Y-%m-%d %H:%M", CONCAT(DATE_ADD(DATE(ready_for_pick_time), INTERVAL 1 DAY), " ", FLOOR(cut_off_hour), ":", FLOOR((cut_off_hour - FLOOR(cut_off_hour)) * 60)))
              ) AS cut_off_ts
        FROM cut_off_route
    ),

    cut_off_status AS (
        SELECT
            a.*
            , IF(
                carrier_picked_time IS NOT NULL
                , IF(
                        carrier_picked_time <= TIMESTAMP_ADD(cut_off_ts, INTERVAL 210 MINUTE)
                        , "ON_TIME"
                        , "LATE"
                  )
                , IF(cut_off_ts < TIMESTAMP_ADD(CURRENT_TIMESTAMP(), INTERVAL 7 HOUR), "LATE", NULL)
              ) AS fulfill_status_cut_off
            , b.actual_route
        FROM cut_off_time AS a
            LEFT JOIN actual_route AS b USING(ticket_id)
    )

SELECT
    *
    , TIMESTAMP_DIFF(carrier_picked_time, cut_off_ts, MINUTE ) / 60 AS delay_hours
FROM cut_off_status
-- WHERE ticket_id = 13290198

