config {
    type: "table", 
    description: 
        `
        List of orders participating in Gamification;
        PIC: nguyen.tran; 
        Type: Table; 
        Refresh Schedule: hourly;
        Source: 
            ${source.ref}.fact_order_item,
            ${source.ref}.fact_order,
            ${source.ref}.dim_gamification,
            ${source.ref}.dim_gamification_sku
        `,
    tags: ["custom_1h_past5","PROMOTION_MKP"]
}

-- WITH 
--     cte AS (
--         SELECT
--             *
--             , IF(sku_code IN ("MEDX.SAN-ALE-001","MEDX.5b4213a5d8495","MEDX.SAN-OFL-002"),
--                    IF( DATE(created_at) BETWEEN "2024-11-15" AND "2024-12-31", 1, 0), 1) flag_gamification 
--         FROM ${ref('fact_order_item')}
--     )

SELECT
    o.customer_id
    , g.gamification_code
    , g.min_total_value
    , o.order_id
    , o.created_at as order_created_at
    , SUM(demand_quantity * sales_price) AS ordered_amount
    , SUM(
        IF(
            o.order_status_seq >= g.order_status_seq
            , IF(g.kind_of_value = 'ACTUAL', outbound_quantity * sales_price, demand_quantity * sales_price)
            , null
        )
      ) AS value_by_condition
FROM ${ref('fact_order_item')} AS oi
    LEFT JOIN ${ref('fact_order')} AS o ON oi.order_id = o.order_id
    JOIN ${ref('dim_gamification_sku')} AS gs ON oi.sku_orignal_key = gs.sku_key
    LEFT JOIN ${ref('dim_gamification')} AS g ON gs.gamification_code = g.gamification_code
WHERE
    oi.created_at >= '2024-06-01' AND
    oi.created_at >= g.start_time
    AND oi.created_at <= g.end_time
    AND o.order_status <> 'CANCEL'
    AND o.province_code IN (SELECT a.province_code FROM ${ref('dim_gamification_location')} AS a WHERE a.gamification_code = g.gamification_code)
    -- AND flag_gamification = 1
GROUP BY ALL