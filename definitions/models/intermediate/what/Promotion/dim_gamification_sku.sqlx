config {
    type: "table", 
    description: 
        `
        SKUs is applied in Gamification;
        PIC: nguyen.tran; 
        Type: Table; 
        Refresh Schedule: hourly;
        Source: 
            ${source.ref}.dim_gamification,
            ${source.ref}.dim_sku_tag
        `,
    tags: ["custom_1h_past5","PROMOTION_MKP"]
}

SELECT DISTINCT
    gamification_code
    , st.sku_code
    , st.sku_key
FROM ${ref('dim_gamification')},
    UNNEST(JSON_VALUE_ARRAY(condition.tags)) AS t
    LEFT JOIN ${ref('dim_sku_tag')} AS st ON st.tag_code = t
-- WHERE 
--     SPLIT(st.sku_code, '.')[SAFE_OFFSET(0)] = 'MEDX'
UNION DISTINCT
SELECT
    gamification_code
    , s AS sku_code
    , sku_key
FROM ${ref('dim_gamification')},
    UNNEST(JSON_VALUE_ARRAY(condition.skus)) AS s
    LEFT JOIN ${ref('dim_sku')} AS ss ON s = ss.sku_code