config {
    type: "table", 
    description: 
        `
        List of Customers Participating in Gamification;
        PIC: nguyen.tran; 
        Type: Table; 
        Refresh Schedule: hourly;
        Source: 
            ${source.platinum}.marketplace_prd_promotion_gamification_customer
        `,
    tags: ["custom_1h_past5","PROMOTION_MKP"]
}

WITH
    customer_and_gami AS (
        SELECT
            c.customer_id
            , g.gamification_id
            , g.gamification_code
        FROM gold_buymed_vn2.dim_customer AS c
            , gold_buymed_vn2.dim_gamification AS g
        WHERE customer_status = "ACTIVE"
    )

    , excluding_customer AS (
        SELECT
            a.customer_id
            , g.gamification_id
            , g.gamification_code
        FROM platinum_buymed_vn.marketplace_prd_promotion_gamification_customer AS a
            LEFT JOIN gold_buymed_vn2.dim_gamification AS g USING(gamification_id)
        WHERE a.status <> "ACTIVE"
            AND g.gamification_id IS NOT NULL
    )

    , final AS (
        SELECT
            *
        FROM customer_and_gami
        EXCEPT DISTINCT
        SELECT
            *
        FROM excluding_customer
    )

SELECT
    a.customer_id
    , a.gamification_id
    , g.gamification_code
FROM ${source.platinum}.marketplace_prd_promotion_gamification_customer AS a
    LEFT JOIN ${ref('dim_gamification')} AS g USING(gamification_id)
WHERE a.status = "ACTIVE"
    AND g.gamification_id IS NOT NULL
UNION DISTINCT
SELECT *
FROM final

