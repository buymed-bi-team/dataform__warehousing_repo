config {
    type: "table", 
    description: 
        `
        List of Customers Participating in Gamification;
        PIC: nguyen.tran; 
        Type: Table; 
        Refresh Schedule: hourly;
        Source: 
            ${source.platinum}.marketplace_prd_promotion_gamification_customer
        `,
    tags: ["custom_1h_past5","PROMOTION_MKP"]
}

WITH
    active_customer_gamification AS (
        SELECT
            a.customer_id
            , a.gamification_id
            , g.gamification_code
        FROM ${source.platinum}.marketplace_prd_promotion_gamification_customer AS a
            LEFT JOIN ${ref('dim_gamification')} AS g USING(gamification_id)
        WHERE a.status IN ("ACTIVE", "INACTIVE")
            AND g.gamification_id IS NOT NULL
    )
    
    , customer_and_gamification AS (
        SELECT
            c.customer_id
            , g.gamification_id
            , g.gamification_code
        FROM ${ref('dim_customer')} AS c
            , ${ref('dim_gamification')} AS g
        WHERE customer_status = "ACTIVE"
            AND g.gamification_id NOT IN (SELECT DISTINCT gamification_id FROM active_customer_gamification)

    )

    , excluding_customer AS (
        SELECT
            a.customer_id
            , g.gamification_id
            , g.gamification_code
        FROM ${source.platinum}.marketplace_prd_promotion_gamification_customer AS a
            LEFT JOIN ${ref('dim_gamification')} AS g USING(gamification_id)
        WHERE a.status = "BLACKLIST"
            AND g.gamification_id IS NOT NULL
    )

    , customer_gamification_exclude_blacklist AS (
        SELECT
            *
        FROM customer_and_gamification
        EXCEPT DISTINCT
        SELECT
            *
        FROM excluding_customer
    )

    , final AS (
        SELECT *
        FROM active_customer_gamification
        UNION DISTINCT
        SELECT *
        FROM customer_gamification_exclude_blacklist
    )

SELECT
    a.*
    , b.province_code AS customer_province_code
FROM final AS a
    LEFT JOIN ${ref('dim_customer')} AS b USING(customer_id)



