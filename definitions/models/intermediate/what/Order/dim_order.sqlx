config {
    type: "incremental",
    description: `PIC: minh.luu; model_type: incremental; Schedule: each 5 min from 9 to 18 and each 1h from 18 to 9 am
    Source:
      ${source.silver}.marketplace_prd_order_v2_order
      ${source.silver}.tender_prd_core_tender_orders`,
    name: "dim_order",
    assertions: {
        uniqueKey: ["order_id"],
        nonNull:["order_id","order_channel"]
    //     // nullable : seller_class vì một số seller_code không có trong seller_prd_core_seller table
    //     // nonNull: ["created_time","order_channel"]
    },
    tags: ["custom_5min_9to18","custom_1h_18to9","Weekend"],
    columns: {
      order_id:"NonNull | Unique identifier for each order",
      created_time: "NonNull | Timestamp indicating when the order was created. The time zone is set to 'Asia/Ho_Chi_Minh'",
      confirmation_date: "Nullable | order confirmation time. The time zone is set to 'Asia/Ho_Chi_Minh",
      order_channel: "NonNull | Category of the order based on the tags and source.  'TENDER' if customer_tags contains 'TENDER', 'DISTRIBUTION' if source is 'brand-portal' or 'clinic-portal', 'CONSIGNMENT-RECOGNITION' if tags contains 'SO_INTERNAL', 'CONSIGNMENT' if source is 'internal-portal','CIRCA' if customer_tags contains 'CIRCA', otherwise 'MARKETPLACE'",
      order_type: "NonNull | SO, CO, TENDER, DO",
      location_code: "Nullable | A standardized code used to identify provinces within a country",
      shipping_location_code: "Nullable ",
      sales_region_code: "Nullable | Translate from the province code rather than the warehouse code, because assigning warehouse codes is not supported before 2022"
    },
    bigquery: {
      partitionBy: "DATE(created_time)"
    }
}
-- 4.92 GB / day

-- Advance:
--  - Writing unit test
--  - Checking if any column can be change over time
js {
  function choose_new(column_name){
    /*
      Because in real time, we allow user to fix order, this make order_id have 2 created time
      So that to ensure order_id is unique, we will group by it and get all new data along with new created_time
    */
    return `ARRAY_AGG( ${column_name} ORDER BY created_time DESC)[0] AS ${column_name}`
  }
}
WITH 
-- Marketplace
dedup_order AS ${
    dedup.dedup(
      source.silver + `.marketplace_prd_order_v2_order`,
      `
      order_id, 
      ${utils.ToTimezone(`created_time`)} as created_time, 
      ${utils.ToTimezone(`confirmation_date`)} as confirmation_date, 
      source, 
      ward_code,
      district_code,
      province_code,
      customer_ward_code,
      customer_district_code,
      customer_province_code, 
      TO_JSON_STRING(JSON_VALUE_ARRAY(extra_props, '$.customer_tags')) as customer_tags,
      TO_JSON_STRING(tags) as tags,
      customer_id,
      JSON_VALUE(extra_props, "\$.brand_code") AS brand_code,
      warehouse_code
      `,
      start_timestamp= when(incremental(),
                ` TIMESTAMP(current_datetime() - INTERVAL 2 DAY )`, // Nếu incremental thì mình chỉ lấy 3 ngày trở lại
                ` TIMESTAMP_SECONDS(0)`)                            // tránh cho việc dedup phải thực hiện window function cả bảng
                                                                    // Điều này giúp nâng performance cụ thể là 1.32GB thành 37MB mỗi lần chạy incremental
)}
, order_sales_region_code as (
  SELECT
    a.*,
    CASE
        WHEN SAFE_CAST(a.ward_code AS integer) > 0 THEN a.ward_code
        WHEN SAFE_CAST(a.district_code AS integer) > 0 THEN a.district_code
        WHEN SAFE_CAST(a.province_code AS integer) > 0 THEN a.province_code
        ELSE NULL
    END AS location_code,
    CASE
        WHEN SAFE_CAST(a.customer_ward_code AS integer) > 0 THEN a.customer_ward_code
        WHEN SAFE_CAST(a.customer_district_code AS integer) > 0 THEN a.customer_district_code
        WHEN SAFE_CAST(a.customer_province_code AS integer) > 0 THEN a.customer_province_code
        ELSE NULL
    END AS shipping_location_code,
    COALESCE(dim_fc.sales_region_code, dim_fc2.sales_region_code) sales_region_code
  FROM dedup_order a
  LEFT JOIN ${ref(`dim_fc_service_area`)} dim_fc_service_area
        ON a.province_code = dim_fc_service_area.service_area_code
  LEFT JOIN ${ref(`dim_fc`)} dim_fc
      ON dim_fc_service_area.fc_code = dim_fc.fc_code
  LEFT JOIN ${ref(`dim_fc_service_area`)} dim_fc_service_area2
          ON a.customer_province_code = dim_fc_service_area2.service_area_code
  LEFT JOIN ${ref(`dim_fc`)} dim_fc2
      ON dim_fc_service_area2.fc_code = dim_fc2.fc_code
)

,order_tbl as ( -- dedup order when incremental too fast
  SELECT 
    order_id,
    max(created_time) created_time,
    ${choose_new(`confirmation_date`)},
    ${choose_new(`source`)},
    ${choose_new(`location_code`)},
    ${choose_new(`shipping_location_code`)},
    ${choose_new(`customer_tags`)},
    ${choose_new(`tags`)},
    ${choose_new(`customer_id`)},
    ${choose_new(`brand_code`)},
    ${choose_new(`sales_region_code`)},
    ${choose_new(`warehouse_code`)}
  FROM
    order_sales_region_code
  GROUP BY
    order_id
)


-- TENDER
, dedup_tender_order AS ${ dedup.dedup(
    source.silver + `.tender_prd_core_tender_orders`,
    `
    order_id,
    ${utils.ToTimezone(`created_time`)} as created_time, 
    ${utils.ToTimezone(`confirmation_date`)} as confirmation_date, 
    ward_code,
    district_code,
    province_code
    `,
    start_timestamp = when ( incremental(),
              ` TIMESTAMP(current_datetime() - INTERVAL 2 DAY )`,
              ` TIMESTAMP_SECONDS(0)`)                           
)}

,dedup_tender_order_sales_region_code AS  
  (
  SELECT 
    a.*,
    CASE
        WHEN SAFE_CAST(a.ward_code AS integer) > 0 THEN a.ward_code
        WHEN SAFE_CAST(a.district_code AS integer) > 0 THEN a.district_code
        WHEN SAFE_CAST(a.province_code AS integer) > 0 THEN a.province_code
        ELSE NULL
    END AS location_code,
    CASE
        WHEN SAFE_CAST(a.ward_code AS integer) > 0 THEN a.ward_code
        WHEN SAFE_CAST(a.district_code AS integer) > 0 THEN a.district_code
        WHEN SAFE_CAST(a.province_code AS integer) > 0 THEN a.province_code
        ELSE NULL
    END AS shipping_location_code,
    dim_fc.sales_region_code

  FROM dedup_tender_order a
  LEFT JOIN ${ref(`dim_fc_service_area`)} dim_fc_service_area
        ON a.province_code = dim_fc_service_area.service_area_code
  LEFT JOIN ${ref(`dim_fc`)} dim_fc
    ON dim_fc_service_area.fc_code = dim_fc.fc_code
)

, tender_order_tbl AS (
  SELECT 
    order_id,
    max(created_time) created_time,
    ${choose_new(`confirmation_date`)},
    ${choose_new(`location_code`)},
    ${choose_new(`shipping_location_code`)},
    ${choose_new(`sales_region_code`)}
  FROM
    dedup_tender_order_sales_region_code
  GROUP BY
    order_id
)

SELECT
  order_id,
  created_time,
  confirmation_date,
  CASE
    WHEN customer_tags LIKE '%TENDER%' THEN 'TENDER'
    WHEN source = 'brand-portal' AND brand_code IN ('Q8HDUVQX', '2E84FW961P', 'PG961P') THEN 'TENDER'
    WHEN source in ('brand-portal', 'clinic-portal') THEN 'DISTRIBUTION'
    WHEN REGEXP_CONTAINS(tags,'SO_INTERNAL')  THEN 'CONSIGNMENT-RECOGNITION' -- replace consignment
    WHEN created_time >= "2023-10-01" AND source = 'internal-portal' THEN 'CONSIGNMENT'  
    WHEN created_time >= "2023-10-01" AND customer_id = 241098 THEN 'CONSIGNMENT'
    WHEN customer_tags LIKE "%TERMINATE_CIRCA%" THEN "MARKETPLACE"
    WHEN customer_tags LIKE '%CIRCA%'  THEN 'CIRCA'
    ELSE 'MARKETPLACE'
  END AS order_channel,
  CASE -- same with above
    WHEN customer_tags LIKE '%TENDER%' THEN 'TENDER'
    WHEN source = 'brand-portal' AND brand_code IN ('Q8HDUVQX', '2E84FW961P', 'PG961P') THEN 'TENDER'
    WHEN source in ('brand-portal', 'clinic-portal') THEN 'SO'
    WHEN created_time >= "2023-10-01" AND source = 'internal-portal' THEN 'CO'  -- Dự án CONSIGNMENT đã bể
    WHEN created_time >= "2023-10-01" AND customer_id = 241098 THEN 'CO'
    WHEN customer_tags LIKE "%TERMINATE_CIRCA%" THEN "SO"
    WHEN customer_tags LIKE '%"CIRCA"%'  THEN 'SO'
    ELSE 'SO'
  END AS order_type,
  location_code,
  shipping_location_code,
  order_tbl.sales_region_code
FROM order_tbl
${when(incremental(),
   `WHERE created_time > (SELECT MAX(created_time) FROM ${self()})`,
   ``)}

UNION ALL

SELECT 
  order_id,
  created_time,
  confirmation_date,
  "TENDER" AS order_channel,
  "TENDER" AS order_type,
  location_code,
  shipping_location_code,
  sales_region_code
FROM tender_order_tbl

${when(incremental(),
   `WHERE created_time > (SELECT MAX(created_time) FROM ${self()})`,
   ``)}


pre_operations {
  -- If user change order more than 5 minutes, incremental model will duplicate that order cause this model just
  -- append row, not update it
  -- so that I will remove order that created about 45 minute ago, then add the new one, also the new changed order
  ${
    when(
      incremental(),
      `
      DELETE ${self()}
      WHERE created_time > CURRENT_DATETIME("+7") - INTERVAL 1 DAY 
      `,
      ``
    )
  }
}


post_operations {                
  ${
    when(incremental(),
      "",
      `
      -- Bước thực hiện add primary key, nhưng chỉ trong lần đầu full-refresh, nếu thực hiện incremental sau thì k cần làm gì
      ALTER TABLE ${self()} 
        ADD PRIMARY KEY (order_id) NOT ENFORCED,
        ADD FOREIGN KEY (location_code) references ${ref(`dim_geo_location`)}(location_code) NOT ENFORCED,
        ADD FOREIGN KEY (shipping_location_code) references ${ref(`dim_geo_location`)}(location_code) NOT ENFORCED;
      `
    )
  }
}


