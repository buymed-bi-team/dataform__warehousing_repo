config {
    type: "incremental",
    description: `PIC: minh.luu; model_type: incremental; Schedule: each 5 min from 9 to 18 and each 1h from 18 to 9 am
    Source:
      ${source.silver}.marketplace_prd_order_v2_order
      ${source.silver}.tender_prd_core_tender_orders`,
    tags: ["custom_5min_9to18","custom_1h_18to9","Weekend"],
    columns: {
        order_id:"NonNull | Unique identifier for each order",
        location_code: "Nullable | Location code that the customer has registered",
        shipping_location_code: "Nullable | Order specific delivery location code",
        sales_region_code: "Nullable | Translate from the province code rather than the warehouse code, because assigning warehouse codes is not supported before 2022",
        created_dt: "Nullable | Timezone in +7"

    },
    bigquery: {
        partitionBy: "DATE(created_dt)"
    }
}

js {
    // if ( `${datetime.isDaysOfWeek(0,6)}` == 'true') {
    //     delete_interval = "INTERVAL 7 HOUR"
    // }
    // else {
    //     delete_interval = "INTERVAL 3 HOUR"
    // }
    const checkpoint_datetime = `"${datetime.getPastDatetime({ intervalHours: 7 })}"`

}


pre_operations {
  ${
    when(
      incremental(),
      `
      DELETE ${self()}
      WHERE created_dt > ${checkpoint_datetime}
      `,
      ``
    )
  }
}

WITH 
    order_mkp AS (
        SELECT 
            * EXCEPT ( mg_id, synced_at, last_updated_time)
        FROM ${dedup.dedup(
        source.silver + `.marketplace_prd_order_v2_order`,
        `
            order_id,
            ward_code,
            district_code,
            province_code,
            customer_ward_code,
            customer_district_code,
            customer_province_code, 
            created_time
        `,
        start_timestamp= when(incremental(),
            ` TIMESTAMP(current_datetime() - INTERVAL 2 DAY )`, 
            ` TIMESTAMP_SECONDS(0)`)                           
    )}
)
,
    order_tender AS (
        SELECT 
            order_id,
            ward_code,
            district_code,
            province_code,
            ward_code as customer_ward_code,
            district_code as customer_district_code,
            province_code as customer_province_code, 
            created_time
        FROM ${source.platinum}.tender_prd_core_tender_orders 
        WHERE created_time >= ${ when(incremental(),
            ` TIMESTAMP(current_datetime() - INTERVAL 2 DAY )`, 
            ` TIMESTAMP_SECONDS(0)`)                           
        }
)
,   
    union_order AS (
        SELECT * FROM order_mkp
        UNION ALL 
        SELECT * FROM order_tender
)
,
    js { function case_then(column_name) { return `WHEN SAFE_CAST(${column_name} AS integer) > 0 THEN CAST(${column_name} AS STRING)`} }
    order_sales_region_code AS (
        SELECT
            a.*,
            CASE
                ${case_then(`a.ward_code`)}
                ${case_then(`a.district_code`)}
                ${case_then(`a.province_code`)}
                ELSE NULL 
            END AS location_code,
            CASE
                ${case_then(`a.customer_ward_code`)}
                ${case_then(`a.customer_district_code`)}
                ${case_then(`a.customer_province_code`)}
                ELSE NULL
            END AS shipping_location_code,
            COALESCE(dim_fc.sales_region_code, dim_fc2.sales_region_code) sales_region_code
        FROM union_order a
        LEFT JOIN ${ref(`dim_fc_service_area`)} dim_fc_service_area
                ON a.province_code = dim_fc_service_area.service_area_code
        LEFT JOIN ${ref(`dim_fc`)} dim_fc
            ON dim_fc_service_area.fc_code = dim_fc.fc_code
        LEFT JOIN ${ref(`dim_fc_service_area`)} dim_fc_service_area2
                ON a.customer_province_code = dim_fc_service_area2.service_area_code
        LEFT JOIN ${ref(`dim_fc`)} dim_fc2
            ON dim_fc_service_area2.fc_code = dim_fc2.fc_code
), 
js {
  function choose_new(column_name){
    /*
      Because in real time, we allow user to fix order, this make order_id have 2 created time
      So that to ensure order_id is unique, we will group by it and get all new data along with new created_time
    */
    return `ARRAY_AGG( ${column_name} ORDER BY created_time DESC)[0] AS ${column_name}`
  }
}
    order_tbl AS (
        SELECT 
            order_id,
            ${utils.ToTimezone(`max(created_time)`)} AS created_dt,
            ${choose_new(`location_code`)},
            ${choose_new(`shipping_location_code`)},
            ${choose_new(`sales_region_code`)}
        FROM 
            order_sales_region_code
        GROUP BY 1
)
SELECT 
    order_id,
    location_code,
    shipping_location_code,
    sales_region_code,
    created_dt
FROM order_tbl
${when(incremental(),
   `WHERE created_dt > ${checkpoint_datetime}`,
   ``)}


post_operations {                
  ${
    when(incremental(),
      "",
      `
      ALTER TABLE ${self()} 
        ADD PRIMARY KEY (order_id) NOT ENFORCED,
        ADD FOREIGN KEY (location_code) references ${ref(`dim_geo_location`)}(location_code) NOT ENFORCED,
        ADD FOREIGN KEY (shipping_location_code) references ${ref(`dim_geo_location`)}(location_code) NOT ENFORCED;
      `
    )
  }
}
