config {
    type: "table",
    description: "Schedule: daily at 12am, 12pm | PIC: dong.le",
    name: "dim_expired_date",
    tags: ["0h00"],
    columns: {

    }
}

SELECT DISTINCT
    expired_date,
    CASE 
        WHEN LENGTH(expired_date) = 6 THEN
            CASE 
                WHEN SAFE_CAST(SUBSTR(expired_date, 3, 2) AS INT64) <= 12 THEN
                    PARSE_DATE('%Y-%m-%d', CONCAT('20', SUBSTR(expired_date, 5, 2), '-', SUBSTR(expired_date, 3, 2), '-', SUBSTR(expired_date, 1, 2)))
                ELSE 
                    PARSE_DATE('%Y-%m-%d', CONCAT('20', SUBSTR(expired_date, 5, 2), '-', SUBSTR(expired_date, 1, 2), '-', SUBSTR(expired_date, 3, 2)))
            END
        WHEN LENGTH(expired_date) = 8 THEN
            CASE 
                WHEN SAFE_CAST(SUBSTR(expired_date, 3, 2) AS INT64) <= 12 THEN
                    PARSE_DATE('%d%m%Y', expired_date)
                ELSE 
                    PARSE_DATE('%m%d%Y', expired_date)
            END
        WHEN LENGTH(expired_date) = 10 THEN
            CASE 
                WHEN SAFE_CAST(SUBSTR(expired_date, 4, 2) AS INT64) <= 12 THEN
                    PARSE_DATE('%d-%m-%Y', expired_date)
                ELSE 
                    PARSE_DATE('%m-%d-%Y', expired_date)
            END
        WHEN LENGTH(expired_date) = 24 THEN
            CASE 
                WHEN SAFE_CAST(SUBSTR(expired_date, 6, 2) AS INT64) <= 12 THEN
                    PARSE_DATE('%Y-%m-%d', CONCAT(SUBSTR(expired_date, 21, 4), '-', SUBSTR(expired_date, 6, 2), '-', SUBSTR(expired_date, 3, 2)))
                ELSE 
                    PARSE_DATE('%Y-%m-%d', CONCAT(SUBSTR(expired_date, 21, 4), '-', SUBSTR(expired_date, 3, 2), '-', SUBSTR(expired_date, 6, 2)))
            END
        ELSE
            NULL
    END AS formatted_expdate
FROM
    (SELECT expired_date FROM ${ref("fact_stock_lotdate_incoming")}
     UNION ALL
     SELECT expired_date FROM ${ref("fact_stock_lotdate_outgoing")}) AS combined_dates
WHERE expired_date IS NOT NULL
