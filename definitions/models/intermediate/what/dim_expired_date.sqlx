config {
    type: "table",
    description: "Schedule: daily at 12am, 12pm | PIC: dong.le",
    name: "dim_expired_date",
    tags: ["0h00"],
    columns: {

    }
}

WITH main AS (
    SELECT DISTINCT
        expired_date,
        CASE 
            -- Handle 6-character dates (DDMMYY or MMDDYY)
            WHEN LENGTH(expired_date) = 6 AND 
                SAFE_CAST(SUBSTR(expired_date, 3, 2) AS INT64) BETWEEN 1 AND 12 AND
                SAFE_CAST(SUBSTR(expired_date, 1, 2) AS INT64) BETWEEN 1 AND 31 THEN
                CASE 
                    WHEN SAFE_CAST(SUBSTR(expired_date, 3, 2) AS INT64) <= 12 THEN
                        SAFE.PARSE_DATE('%d%m%y', expired_date)
                    ELSE 
                        SAFE.PARSE_DATE('%m%d%y', expired_date)
                END
            
            -- Handle 8-character dates (DDMMYYYY or MMDDYYYY)
            WHEN LENGTH(expired_date) = 8 AND 
                SAFE_CAST(SUBSTR(expired_date, 3, 2) AS INT64) BETWEEN 1 AND 12 AND
                SAFE_CAST(SUBSTR(expired_date, 1, 2) AS INT64) BETWEEN 1 AND 31 THEN
                CASE 
                    WHEN SAFE_CAST(SUBSTR(expired_date, 3, 2) AS INT64) <= 12 THEN
                        SAFE.PARSE_DATE('%d%m%Y', expired_date)
                    ELSE 
                        SAFE.PARSE_DATE('%m%d%Y', expired_date)
                END
            
            -- Handle 10-character dates (DD-MM-YYYY or MM-DD-YYYY)
            WHEN LENGTH(expired_date) = 10 AND 
                SAFE_CAST(SUBSTR(expired_date, 4, 2) AS INT64) BETWEEN 1 AND 12 AND
                SAFE_CAST(SUBSTR(expired_date, 1, 2) AS INT64) BETWEEN 1 AND 31 THEN
                CASE 
                    WHEN SAFE_CAST(SUBSTR(expired_date, 4, 2) AS INT64) <= 12 THEN
                        SAFE.PARSE_DATE('%d-%m-%Y', expired_date)
                    ELSE 
                        SAFE.PARSE_DATE('%m-%d-%Y', expired_date)
                END
            
            -- Handle 24-character dates (datetime format with full timestamp)
            WHEN LENGTH(expired_date) = 24
                -- AND
                -- SAFE_CAST(SUBSTR(expired_date, 6, 2) AS INT64) BETWEEN 1 AND 12 AND
                -- SAFE_CAST(SUBSTR(expired_date, 3, 2) AS INT64) BETWEEN 1 AND 31 THEN
                -- CASE 
                --     WHEN SAFE_CAST(SUBSTR(expired_date, 6, 2) AS INT64) <= 12 THEN
                --         SAFE.PARSE_DATE('%Y-%m-%d', CONCAT(SUBSTR(expired_date, 21, 4), '-', SUBSTR(expired_date, 6, 2), '-', SUBSTR(expired_date, 3, 2)))
                --     ELSE 
                --         SAFE.PARSE_DATE('%Y-%m-%d', CONCAT(SUBSTR(expired_date, 21, 4), '-', SUBSTR(expired_date, 3, 2), '-', SUBSTR(expired_date, 6, 2)))
                -- END
                THEN SAFE.PARSE_DATE('%Y-%m-%d', CONCAT(SUBSTR(expired_date, 1, 10)))
            ELSE
                NULL
        END AS formatted_expdate
    FROM
        (SELECT expired_date FROM ${ref("fact_stock_lotdate_incoming")}
        UNION ALL
        SELECT expired_date FROM ${ref("fact_stock_lotdate_outgoing")}) AS combined_dates
    WHERE expired_date IS NOT NULL
)

SELECT
    *,
    CASE 
        WHEN DATE_DIFF(formatted_expdate, CURRENT_DATE(), DAY) > 360 THEN 'MORE THAN 1 YEAR'
        WHEN DATE_DIFF(formatted_expdate, CURRENT_DATE(), DAY) <= 360 AND DATE_DIFF(formatted_expdate, CURRENT_DATE(), DAY) > 180 THEN '6-12 MONTHS'
        WHEN DATE_DIFF(formatted_expdate, CURRENT_DATE(), DAY) <= 180 AND DATE_DIFF(formatted_expdate, CURRENT_DATE(), DAY) > 90 THEN '3-6 MONTHS'
        WHEN DATE_DIFF(formatted_expdate, CURRENT_DATE(), DAY) <= 90 AND DATE_DIFF(formatted_expdate, CURRENT_DATE(), DAY) > 30 THEN '1-3 MONTHS'
        WHEN DATE_DIFF(formatted_expdate, CURRENT_DATE(), DAY) <= 30 AND DATE_DIFF(formatted_expdate, CURRENT_DATE(), DAY) >= 0 THEN 'LESS THAN 1 MONTH'
        WHEN DATE_DIFF(formatted_expdate, CURRENT_DATE(), DAY) < 0 THEN 'EXPIRED'
    ELSE 'N/A'
    END AS expiration_status,
    DATE_DIFF(formatted_expdate, CURRENT_DATE(), DAY) AS days_until_expired
FROM main

