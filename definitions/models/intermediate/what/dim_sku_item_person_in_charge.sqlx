config {
    type: "view",
    description: "Source: seller_prd_purchasing_pic, where object_type is SKU | PIC: dong.le",
    name: "dim_sku_item_person_in_charge",
    columns: {
      sku_code: "unique sku identifier",
      fc_code: "warehouse code",
      pic_purchase_id: "PIC account ID for purchasing",
      pic_purchase_name: "full name of the PIC for purchasing",
      pic_category_id: "CIC account ID for category management",
      pic_category_name: "full name of the PIC for category management"
    }
}

WITH cte_main as (
SELECT 
    -- a.mg_id
    a.object_code as sku_code
    , a.warehouse_code as fc_code
    , a.cic_account_id
    , a.pic_account_id
    -- , a.action
    -- , a.synced_at
FROM silver_buymed_vn.seller_prd_purchasing_pic as a
WHERE
    COALESCE(a.object_type, 'SKU') = "SKU"
QUALIFY ROW_NUMBER() OVER(_window) = 1 AND FIRST_VALUE(a.action) OVER(_window) <> "d"
WINDOW _window AS (PARTITION BY a.mg_id ORDER BY synced_at DESC)
)

SELECT
    sku.sku_code
    , fc.fc_code
    , coalesce(
        m.cic_account_id
        , ic.cic_category_id
    ) as pic_category_id
    , coalesce(
        m.pic_account_id
        , ic.pic_purchase_id
    ) as pic_purchase_id
    , coalesce(
        e1.fullname
        , ic.cic_category_name
    ) as pic_category_name
    , coalesce(
        e2.fullname
        , ic.pic_purchase_name
    ) as pic_purchase_name
FROM ${ref("dim_sku")} AS sku, ${ref("dim_fc")} AS fc
LEFT JOIN cte_main AS m ON sku.sku_code = m.sku_code AND fc.fc_code = m.fc_code
LEFT JOIN ${ ref("dim_supplier_fc_person_in_charge") } AS ic ON sku.seller_code = ic.supplier_code AND fc.fc_code = ic.fc_code
LEFT JOIN ${ ref("dim_employee") } AS e1 ON m.cic_account_id = e1.employee_id
LEFT JOIN ${ ref("dim_employee") } AS e2 ON m.pic_account_id = e2.employee_id
