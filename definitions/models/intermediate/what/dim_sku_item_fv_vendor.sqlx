config {
    type: "table",
    description: "Source: dim_sku_item_vendors. Extracts the vendor code with zero priority score for each sku item. PIC: dong.le",
    name: "dim_sku_item_fv_vendor",
    tags: ["0h00", "12h00"],
    columns: {
      sku_code: "unique sku identifier", fc_code: "warehouse code", vendor_code: "the vendor code with lowest priority score for the sku"
    }
}

SELECT
  sku_code,
  fc_code,
  vendor_code,
  vendor_priority
FROM ${ref("dim_sku_item_vendors")} a
WHERE a.vendor_priority = "0"