config {
    type: "table",
    description: "Source: warehouse_prd_inventory_sku_merge, agg_latest_put_by_sku_fc, agg_latest_pick_by_sku_fc | Schedule: daily at 12am | PIC: dong.le",
    name: "dim_stock_classification",
    tags: ["0h00"],
    columns: {
        latest_put_time: "Already converted to GMT+7 timezone",
        latest_pick_time: "Already converted to GMT+7 timezone",
        type_stock_aging: "Categorizes inventory items based on latest pick (NORMAL: < 14 days, BLACK: > 14 days, DEAD: no demand) and put (I: < 15 days. II: 16-30 days. III: >30 days) aging."
    }
}

WITH RankedData AS (
    SELECT 
        a.sku AS sku_code,
        a.warehouse_code AS fc_code,
        b.aging_put_days,
        c.aging_pick_days,
        DATETIME(b.latest_put_time, 'Asia/Ho_Chi_Minh') AS latest_put_time,
        DATETIME(c.latest_pick_time, 'Asia/Ho_Chi_Minh') AS latest_pick_time,
        CASE
            -- NORMAL cases
            WHEN c.aging_pick_days >= 0 AND c.aging_pick_days <= 14 AND (b.aging_put_days >= 0 AND b.aging_put_days <= 15) THEN '01/NORMAL-I: DE(<=14d) | IB(0-15d)'
            WHEN c.aging_pick_days >= 0 AND c.aging_pick_days <= 14 AND (b.aging_put_days > 15 AND b.aging_put_days <= 30) THEN '01/NORMAL-II: DE(<=14d) | IB(16-30d)'
            WHEN c.aging_pick_days >= 0 AND c.aging_pick_days <= 14 AND (b.aging_put_days > 30 OR b.aging_put_days IS NULL) THEN '01/NORMAL-III: DE(<=14d) | IB(>30d)'
            -- BLACK cases
            WHEN c.aging_pick_days > 14 AND (b.aging_put_days >= 0 AND b.aging_put_days <= 15) THEN '02/BLACK-I: DE(>14d) | IB(0-15d)'
            WHEN c.aging_pick_days > 14 AND (b.aging_put_days > 15 AND b.aging_put_days <= 30) THEN '02/BLACK-II: DE(>14d) | IB(16-30d)'
            WHEN c.aging_pick_days > 14 AND (b.aging_put_days > 30 OR b.aging_put_days IS NULL) THEN '02/BLACK-III: DE(>14d) | IB(>30d)'
            -- DEAD cases (No-Demand)
            WHEN c.aging_pick_days IS NULL AND (b.aging_put_days >= 0 AND b.aging_put_days <= 15) THEN '03/DEAD-I: No-Demand | IB(0-15d)'
            WHEN c.aging_pick_days IS NULL AND (b.aging_put_days > 15 AND b.aging_put_days <= 30) THEN '03/DEAD-II: No-Demand | IB(16-30d)'
            WHEN c.aging_pick_days IS NULL AND (b.aging_put_days > 30 OR b.aging_put_days IS NULL) THEN '03/DEAD-III: No-Demand | IB(>30d)'
            ELSE '03/DEAD-III: No-Demand | IB(>30d)'
        END AS type_stock_aging,
        CONCAT(
            '{',
            REGEXP_REPLACE(CONCAT(
                IF(b.aging_put_days IS NOT NULL, CONCAT('"aging_put_days":', b.aging_put_days, ','), ''),
                IF(c.aging_pick_days IS NOT NULL, CONCAT('"aging_pick_days":', c.aging_pick_days, ','), ''),
                IF(b.latest_put_code IS NOT NULL, CONCAT('"latest_put_code":"', b.latest_put_code, '",'), ''),
                IF(b.latest_inbound_code IS NOT NULL, CONCAT('"latest_inbound_code":"', b.latest_inbound_code, '",'), ''),
                IF(c.latest_pick_ticket_id IS NOT NULL, CONCAT('"latest_pick_ticket_id":"', c.latest_pick_ticket_id, '",'), ''),
                IF(c.latest_so IS NOT NULL, CONCAT('"latest_so":"', c.latest_so, '",'), ''),
                IF(b.final_put_code <> b.latest_put_code, CONCAT('"final_put_code":"', b.final_put_code, '",'), ''),
                IF(b.final_put_code <> b.latest_put_code, CONCAT('"aging_final_days":', b.aging_final_days, ','), '')
            ), ",$", ""),
            '}'
        ) AS note,
        CASE
            WHEN b.final_put_code <> b.latest_put_code THEN "False"
            ELSE "True"
        END AS lastest_put_is_inbound,
        ROW_NUMBER() OVER (PARTITION BY a.sku, a.warehouse_code ORDER BY GREATEST(b.latest_put_time, c.latest_pick_time) DESC) AS rn
    FROM ${source.platinum}.warehouse_prd_inventory_sku a
    LEFT JOIN ${ref("agg_latest_put_by_sku_fc")} b
        ON a.sku = b.sku AND a.warehouse_code = b.warehouse_code
    LEFT JOIN ${ref("agg_latest_pick_by_sku_fc")} c
        ON a.sku = c.sku AND a.warehouse_code = c.warehouse_code
    WHERE b.latest_put_time IS NOT NULL OR c.latest_pick_time IS NOT NULL
)

SELECT *
FROM RankedData
WHERE rn = 1