config {
    type: "incremental",
    description: `PIC: minh.luu; model_type: incremental; Schedule: each 5 min from 9 to 18 and each 1h from 18 to 9 am
    Source:
      ${source.silver}.marketplace_prd_order_v2_order
      ${source.silver}.tender_prd_core_tender_orders`,
    name: "dim_order",
    assertions: {
        uniqueKey: ["order_id"],
        nonNull:["order_id"]
    //     // nullable : seller_class vì một số seller_code không có trong seller_prd_core_seller table
    //     // nonNull: ["created_time","order_channel"]
    },
    tags: ["custom_5min_9to18","custom_1h_18to9","Weekend"],
    columns: {
      order_id:"Unique identifier for each order",
      created_time: "Timestamp indicating when the order was created. The time zone is set to 'Asia/Ho_Chi_Minh'",
      confirmation_date: "order confirmation time",
      order_channel: "Category of the order based on the tags and source.  'TENDER' if customer_tags contains 'TENDER', 'DISTRIBUTION' if source is 'brand-portal' or 'clinic-portal', 'CONSIGNMENT' if source is 'internal-portal','CIRCA' if customer_tags contains 'CIRCA', otherwise 'MARKETPLACE'",
      province_code: "A standardized code used to identify provinces within a country",

    },
    bigquery: {
      partitionBy: "DATE(created_time)"
    }
}
-- 4.92 GB / day

-- Advance:
--  - Writing unit test
--  - Checking if any column can be change over time
js {
  function choose_new(column_name){
    /*
      Because in real time, we allow user to fix order, this make order_id have 2 created time
      So that to ensure order_id is unique, we will group by it and get all new data along with new created_time
    */
    return `ARRAY_AGG( ${column_name} ORDER BY created_time DESC)[0] AS ${column_name}`
  }
}

WITH dedup_order as ${
  dedup.dedup(
    source.silver + `.marketplace_prd_order_v2_order`,
    `
    order_id, 
    DATETIME(created_time, 'Asia/Ho_Chi_Minh') as created_time, 
    confirmation_date, 
    source, 
    province_code, 
    TO_JSON_STRING(JSON_VALUE_ARRAY(extra_props, '$.customer_tags')) as customer_tags,
    customer_id
    `,
    start_timestamp= when(incremental(),
              ` TIMESTAMP(current_datetime() - INTERVAL 2 DAY )`, // Nếu incremental thì mình chỉ lấy 3 ngày trở lại
              ` TIMESTAMP_SECONDS(0)`)                            // tránh cho việc dedup phải thực hiện window function cả bảng
                                                                  // Điều này giúp nâng performance cụ thể là 1.32GB thành 37MB mỗi lần chạy incremental
)}

,order_tbl as ( -- dedup order
  SELECT 
    order_id,
    max(created_time) created_time,
    ${choose_new(`confirmation_date`)},
    ${choose_new(`source`)},
    ${choose_new(`province_code`)},
    ${choose_new(`customer_tags`)},
    ${choose_new(`customer_id`)}
  FROM
    dedup_order
  GROUP BY
    order_id
)

, dedup_tender_order AS ${ // tender system
  dedup.dedup(
    source.silver + `.tender_prd_core_tender_orders`,
    `
    order_id,
    DATETIME(created_time, 'Asia/Ho_Chi_Minh') as created_time, 
    confirmation_date, 
    province_code, 
    "TENDER" AS order_channel
    `,
    start_timestamp = when ( incremental(),
              ` TIMESTAMP(current_datetime() - INTERVAL 2 DAY )`,
              ` TIMESTAMP_SECONDS(0)`)                           
  
)}

, tender_order_tbl AS (
  SELECT 
    order_id,
    max(created_time) created_time,
    ${choose_new(`confirmation_date`)},
    ${choose_new(`province_code`)},
    order_channel
  FROM
    dedup_tender_order
  GROUP BY
    order_id,order_channel
)

SELECT
  order_id,
  created_time,
  confirmation_date,
  CASE
    WHEN customer_tags LIKE '%TENDER%' THEN 'TENDER'
    WHEN source in ('brand-portal', 'clinic-portal') THEN 'DISTRIBUTION'
    WHEN source = 'internal-portal' THEN 'CONSIGNMENT' 
    WHEN customer_id = 241098 THEN 'CONSIGNMENT'
    WHEN customer_tags LIKE '%CIRCA%'  THEN 'CIRCA'
    ELSE 'MARKETPLACE'
  END AS order_channel,
  province_code
FROM
  order_tbl
${
  when(incremental(),
   `
   WHERE created_time > (SELECT MAX(created_time) FROM ${self()})
   `,
   ``)
   
}

UNION ALL

SELECT 
  order_id,
  created_time,
  confirmation_date,
  order_channel,
  province_code
FROM dedup_tender_order
${
  when(incremental(),
   `
   WHERE created_time > (SELECT MAX(created_time) FROM ${self()})
   `,
   ``)
   
}

pre_operations {
  -- If user change order more than 5 minutes, incremental model will duplicate that order cause this model just
  -- append row, not update it
  -- so that I will remove order that created about 45 minute ago, then add the new one, also the new changed order
  ${
    when(
      incremental(),
      `
      DELETE ${self()}
      WHERE created_time > CURRENT_DATETIME("+7") - INTERVAL 1 DAY 
      `,
      ``
    )
  }
}


post_operations {                
  ${
    when(incremental(),
      "",
      `
      -- Bước thực hiện add primary key, nhưng chỉ trong lần đầu full-refresh, nếu thực hiện incremental sau thì k cần làm gì
      ALTER TABLE ${self()} ADD PRIMARY KEY (order_id) NOT ENFORCED;
      `
    )
  }
}


