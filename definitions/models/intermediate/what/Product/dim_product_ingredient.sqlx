config {
    type: "table", 
    description: 
        `PIC: nguyen.tran; 
        Type: Table; 
        Refresh Schedule: hourly;
        Source: 
            ${source.platinum}.marketplace_prd_product_v2_product,
            ${source.platinum}.marketplace_prd_product_v2_ingredient
        `,
    tags: ["custom_1h_past5"],
    columns: {
        ingredient_name: "The name of the ingredients in the product",
        volume: "The volume of the ingredients",
        ingredient_level: "The level of the ingredients",
        is_medicine: "Indicates whether the product is medicine"
    }
}

SELECT
    p.product_id
    , i.name AS ingredient_name
    , REPLACE(JSON_EXTRACT_SCALAR(pi.volume), ' ', '') AS volume
    , ROW_NUMBER() over (PARTITION BY p.product_id) AS ingredient_level
    , i.description
    , COALESCE(i.is_medicine, FALSE) AS is_medicine
    , p.usage
    , IFNULL(i.is_ingredient_special, FALSE) AS is_ingredient_special
    , i.ingredient_id
    , i.usages
FROM ${source.platinum}.marketplace_prd_product_v2_product AS p
    , UNNEST(JSON_EXTRACT_ARRAY(p.ingredients)) AS pi
LEFT JOIN (
    SELECT 
        code
        , name
        , description
        , is_medicine
        , is_ingredient_special
        , ingredient_id
        , STRING_AGG(s, ", ") AS usages
    FROM ${source.platinum}.marketplace_prd_product_v2_ingredient 
        LEFT JOIN UNNEST(JSON_VALUE_ARRAY(specialUsages)) AS s
    GROUP BY ALL
) AS i ON i.code = JSON_VALUE(pi.ingredient_code)