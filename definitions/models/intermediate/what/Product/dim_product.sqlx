config {
    type: "table",
    description: `PIC: minh.luu & dong.le; model_type: table; orchestration: hourly
    Source:
      ${source.platinum}.marketplace_prd_product_v2_product
      ${source.platinum}.seller_prd_core_seller
    `,
    name: "dim_product",
    tags: ["custom_1h_past5"],
    assertions: {
        uniqueKey: "product_id",
        nonNull: ["product_id","owner_code"]
    },
    columns: {
        transformed_at: "NonNull | The last time that table is refresh",
        product_created_at: "NonNull | Timezone in +7",
        product_id: "NonNull | Unique identifier for each product",
        filter_product_id: "NonNull | is string type cast from product_id",
        // product_code : "",
        product_name: "NonNull | Name of the product",
        // product_vat: "",
        product_category: "Nullable | one of following: (Thuốc, Dược mỹ phẩm, Thực phẩm chức năng, Thiết bị và vật tư y tế, Hàng tiêu dùng, Null)",
        product_category_code: "Nullable | one of following: (AQFV2U, UACLT0, P3ABCL, GU2U1Y, YX7GBC, Null)",
        // brand: "",
        // brand_type: "",

        owner_code : "NonNull | Code representing the owner (seller) of the product",
        owner_name : "NonNull | Name of the owner (seller) of the product",

        manufacturer_code: "NonNull | Mã nhà sản xuất",
        manufacturer_short_name: "Nullable | Tên viết tắt của nhà sản xuất",
        
        dosage_form: "Dạng bảo chứa",
        unit : "Nullable | Unit of measure for the product",
        volumes : "Nullable | Volume information for the product",
        // retail_unit_quantity_per_unit: "Số lượng bán lẻ của sản phâm trên 1 unit. Ví dụ 10 viên/vỉ thì 10 là retail_unit_quantity_per_unit",
        // retail_unit: "Đơn vị bán lẻ. Bao gồm: Chai, vỉ, lốc, thùng,...",

        
        origin: "NonNull | Xuất xứ, currenly just care about in VietNam or not",
        origin_type: "NonNull | Same with above origin column, is Local or Import ",
        country_origin: "",
        registration_number: "Số đăng ký kiểm định",

        // is_prescription: "NonNull | (DRUG, NON-DRUG) Indicates whether the product is drug",
        is_prescription: "Nullable | is_prescription : Không phải Thuốc, Null, Thuốc kê đơn, Thuốc không kê đơn",
        is_fragile: "NonNull | (FRAGILE, NORMAL) Indicates whether the product is easily breakable",
        is_ingredient_special: "NonNull | (SPECIAL, NORMAL) Indicates whether the product has special ingredient or normal",
        is_frozen : "NonNull | (FROZEN, NORMAL) Indicates whether the product requires freezing",
        is_herb: "Sản phẩm có phải là sản phảm thảo mộc hay không ?. True/False (Nếu Blank sẽ được tính là False)",

        height: "NonNull | Product height",
        length: "NonNull | Product length",
        width: "NonNull | Product width",
        // weight: "",
        
        // usage: "Cách sử dụng thuốc",
        // act_2: "",
        // act_3: "",
        // retail_name: "",
        // retail_categogy_name: "",
        
        // level_1_unit: " ",
        // level_1_quantity: " ",
        // level_2_unit: " ",
        // level_2_quantity: " ",
        // level_3_unit: " ",
        // level_3_quantity: " ",
        // level_4_unit: " ",
        // level_4_quantity: " ",

        // unit_sale_allowed: " ",

        /*
        owner -> owner_name
        manufacturer -> manufacturer_short_name
        */

        product_report_category : "NonNull | Category of the product based on certain criteria and logic: If owner_name contains '[Tech]', then 'TECH'; If owner_code is 'MARKETING', then 'MARKETING'; If owner_code is 'DENX', then 'DENX'; If unit or volumes is 'COMBO', then 'COMBO'; If product_name contains certain keywords, then 'PROMOTION'; Otherwise, 'NORMAL' ",
        // product_classification: "",
    }
}

/*
Chú thích chi tiết:
    Product_report_category:
        DENX : Từ tất cả sản phẩm đến từ nhà bán DENX
        TECH : các sản phẩm được tạo ra để kiểm thử phần mềm, hệ thống internal
        MARKETING : các sản phẩm chủ yếu để quảng bá có campaign
        COMBO     : Tất cả các sản phẩm là bán theo 1 combo, tuy nhiên có 1 số sản phẩm tuy bán combo 
                        nhưng thật ra combo đó để khuyến mãi PROMOTION mà th
        PROMOTION : Tất cả các sản phẩm khuyến mãi
        NORMAL    : Các Sản phẩm không theo nhóm trên
*/
WITH product_retail_unit AS ( 
  SELECT
      product_id
      , max(case when level = 1 then unit end) as level_1_unit,
          sum(case when level = 1 then quantity end) as level_1_quantity,
          max(case when level = 2 then unit end) as level_2_unit,
          sum(case when level = 2 then quantity end) as level_2_quantity,
          max(case when level = 3 then unit end) as level_3_unit,
          sum(case when level = 3 then quantity end) as level_3_quantity,
          max(case when level = 4 then unit end) as level_4_unit,
          sum(case when level = 4 then quantity end) as level_4_quantity,
          max(case when is_sale = true then unit end) as unit_sale_allowed
  FROM (
      SELECT
          product_id
          , JSON_EXTRACT_SCALAR(ru.unit) as unit
          , SAFE_CAST(JSON_EXTRACT_SCALAR(ru.level) AS INT64) as level
          , SAFE_CAST(JSON_EXTRACT_SCALAR(ru.quantity) AS INT64) as quantity
          , SAFE_CAST(JSON_EXTRACT_SCALAR(ru.is_sale) as BOOLEAN) as is_sale
      FROM ${source.platinum}.marketplace_prd_product_v2_product AS p
      LEFT JOIN UNNEST(JSON_EXTRACT_ARRAY(p.retail_units)) AS ru
  ) a
  GROUP BY product_id
)

  , high_margin_product AS (
      SELECT 
          SAFE_CAST(code AS INT64) AS product_id
          , NULLIF(value, "NAN") as high_margin
      FROM ${source.collector}.data_prd
      WHERE object = 'Product' and type = 'HIGH_MARGIN'
      QUALIFY ROW_NUMBER() OVER(PARTITION BY code, object, type ORDER BY submit_id DESC) = 1
  )

  , is_ingredient_special AS (
    SELECT DISTINCT
      product_id
      , usages
    FROM ${ref('dim_product_ingredient')}
    WHERE is_ingredient_special
    -- GROUP BY 1
  )

  , retail_price AS (
    SELECT
      product_id
      , retail_price
    FROM ${source.platinum}.pim_prd_product_product_retail_price
    WHERE region_code = "ALL"
  )

  , brand AS (
    SELECT
      product_id
      , b.name AS brand
    FROM ${source.platinum}.pim_prd_product_product AS a
      LEFT JOIN ${source.platinum}.pim_prd_product_brand AS b 
        ON JSON_VALUE(a.extra_props, "$.brand_code") = b.brand_code
  )


  , ownbrand_portfolio AS (
        SELECT DISTINCT
            product_id
            , "OWNBRAND" AS ownbrand_portfolio
        FROM ${ref('dim_product_division')}
        WHERE brand_group = "OWNBRAND"
        UNION DISTINCT
        SELECT DISTINCT
            product_id
            , "CIRCA"
        FROM buymed_external.potential_high_margin_product
  )

  , chronic AS (
      SELECT
          SAFE_CAST(code AS INT64) AS product_id
          , IF(value <> "CHRONIC", NULL, value) AS chronic
      FROM ${source.collector}.data_prd
      WHERE DATE(submit_at) >= "2025-06-18"
          AND submit_id >= 5539
          AND object = "Product"
          AND type = "CHRONIC"
      QUALIFY ROW_NUMBER() over (PARTITION BY code, object, type ORDER BY submit_id DESC) = 1
  )
  
  , essential AS (
      SELECT
          SAFE_CAST(code AS INT64) AS product_id
          , NULLIF(value, "NAN") AS essential
      FROM collector.data_prd
      WHERE DATE(submit_at) >= "2025-06-18"
          AND submit_id >= 5539
          AND object = "Product"
          AND type = "ESSENTIAL"
      QUALIFY ROW_NUMBER() over (PARTITION BY code, object, type ORDER BY submit_id DESC) = 1
  )
  
  , atc4 AS (
      SELECT
          SAFE_CAST(code AS INT64) AS product_id
          , NULLIF(value, "NAN") AS atc_4
      FROM collector.data_prd
      WHERE DATE(submit_at) >= "2025-08-13"
          AND submit_id >= 5623
          AND object = "Product"
          AND type = "ATC4"
      QUALIFY ROW_NUMBER() over (PARTITION BY code, object, type ORDER BY submit_id DESC) = 1
  )
  
  , atc3 AS (
      SELECT
          SAFE_CAST(code AS INT64) AS product_id
          , NULLIF(value, "NAN") AS atc_3
      FROM collector.data_prd
      WHERE DATE(submit_at) >= "2025-08-13"
          AND submit_id >= 5624
          AND object = "Product"
          AND type = "ATC3"
      QUALIFY ROW_NUMBER() over (PARTITION BY code, object, type ORDER BY submit_id DESC) = 1
  )

SELECT
  ${utils.ToTimezone('current_timestamp()')} as transformed_at,
  ${utils.ToTimezone('product.created_time')} as product_created_at,
  product.product_id,
  CAST(product.product_id AS STRING) AS filter_product_id,
  product.code as product_code, 
  product.name as product_name,
  -- seller_category.name AS product_category,
  product.seller_category_code as product_category_code,
  product.vat,
  -- product.brand,
  br.brand,
  JSON_VALUE(product.extra_props, "$.product_category_management") as brand_type,
  JSON_VALUE(product.extra_props, "$.product_status") as product_status,
  SAFE_CAST(JSON_VALUE(product.extra_props, "$.related_product_id") AS INT64) as related_product_id,
  JSON_VALUE(product.extra_props, "$.status_reason") as status_reason,

  seller.code as owner_code,
  seller.name as owner_name,

  manufacturer.code as manufacturer_code,
  COALESCE(NULLIF(manufacturer.short_name,''), manufacturer.name) as manufacturer_short_name,
  manufacturer.name as commercial_manufacturer_name,

  product.dosage_form,
  product.unit,
  product.volumes,
  product.retail_unit_quantity_per_unit,
  product.retail_unit,



  CASE
      WHEN product.origin IN ('Vietnam', 'VN') THEN 'Vietnam'
      WHEN product.origin NOT IN ('Vietnam', 'VN') THEN 'International'
  END AS origin,
  CASE
    WHEN product.origin IN ('Vietnam', 'VN') THEN 'Local'
    WHEN product.origin NOT IN ('Vietnam', 'VN') THEN 'Import'
  END AS origin_type,
  COALESCE(tb3.name, product.origin) as country_origin,
  product.registration_number,

  -- IF(product.is_prescription = TRUE, "DRUG","NON-DRUG") is_prescription,
  -- IF(product.is_ingredient_special = TRUE, "SPECIAL","NORMAL") is_ingredient_special,
  -- IF(product.is_fragile = TRUE,"FRAGILE","NORMAL") is_fragile,
  -- IF(product.is_frozen = TRUE, "FROZEN","NORMAL") is_frozen,
  -- seller_category.name AS product_category,
  CASE
      WHEN product.seller_category_code = "AQFV2U" THEN 
        CASE
          WHEN seller_sub_category.code IN ('XT2U1Y','LALT0T') THEN seller_sub_category.name
          ELSE "Thuốc (Chưa phân loại)"
        END
      ELSE seller_category.name
  END AS product_category,
  CASE
      WHEN product.seller_category_code = 'AQFV2U' THEN
        CASE
          WHEN seller_sub_category.code IN ('XT2U1Y','LALT0T') THEN seller_sub_category.name
          -- ELSE "Thuốc không kê đơn"
        END
      ELSE 'Không phải Thuốc'
  END AS is_prescription,
  IFNULL(product.is_fragile, FALSE) AS is_fragile,
  IFNULL(product.is_frozen, FALSE) AS is_frozen,
  IFNULL(product.is_liquid, FALSE) AS is_liquid,
  IFNULL(product.is_herb,FALSE) AS is_herb,
  IFNULL(SAFE_CAST(JSON_VALUE(product.extra_props, '$.is_portable') AS BOOLEAN), FALSE) as is_portable,
  -- product.is_ingredient_special,
  IF(
    iis.product_id IS NOT NULL 
    AND product.seller_category_code = "AQFV2U"
    AND REGEXP_CONTAINS(LOWER(iis.usages), LOWER(product.usage))
    , TRUE
    , FALSE
  ) AS is_ingredient_special, -- product must have special ingredients and be a medicine to be classified as a special controlled medicine

  product.height,
  product.length,
  product.width,
  product.weight,

  IF(product.usage = "Dùng tại chổ","Dùng tại chỗ", product.usage) AS usage,
  atc2.name AS act_2,
  -- COALESCE(a3.atc_3, atc3.name) AS act_3,
  a3.atc_3 AS act_3,
  a4.atc_4,
  JSON_EXTRACT_SCALAR(product.retail_info, '$.retail_name') as retail_name,
  tb1.name as retail_categogy_name,


  tb2.level_1_unit,
  tb2.level_1_quantity,
  tb2.level_2_unit,
  tb2.level_2_quantity,
  tb2.level_3_unit,
  tb2.level_3_quantity,
  tb2.level_4_unit,
  tb2.level_4_quantity,

  tb2.unit_sale_allowed,

  CASE
    WHEN seller.name LIKE '%[Tech]%' OR lower(product.name) LIKE "%[tech]%"THEN 'TECH'
    when REGEXP_CONTAINS(
      LOWER(product.name),
      "tech test|techtest|tech -|test-|test -|test_|tech-test|tech tạo để test|test combo|test_combo|tech check"
      || "|sản phẩm test clinic - server|test sản phẩm|sản phẩm test|sp test|test new|quavo tech|tech sp combo medx|thuốc mới test"
      || "|combohatest|ma sp dai 20 ky tu test|bht test|qc test"
    ) THEN 'TECH'
    WHEN REGEXP_CONTAINS (
      LOWER(product.name),
      r'\[.*qc.*\]|\(.*qc.*\)'
    ) THEN 'TECH'
    WHEN seller.code LIKE 'MARKETING' then 'MARKETING'
    WHEN seller.code LIKE 'DENX' then 'DENX'
    WHEN UPPER( COALESCE( product.unit, product.volumes ) ) = 'COMBO' OR product.is_combo = true then 'COMBO'
    WHEN REGEXP_CONTAINS(
          LOWER(product.name ),
          r'combo|quà|tặng|khuyến mãi|khuyến mại|hóa đơn|bảo hiểm|thẻ cào|mua|gift 1|gift 2|tờ rơi|áo blouse|poster|ưu đãi|trưng bày'
        ) OR LOWER(product.name ) LIKE '% circa %' OR LOWER(product.name ) LIKE '% thuocsi %' 
        then 'PROMOTION'
    WHEN UPPER(product.name) LIKE "%[HÀNG THU HỒI]%" THEN "RECALLED"
    ELSE 'NORMAL'
  END product_report_category,
  tb4.name as main_category_name,
  IFNULL(product.is_combo,FALSE) AS is_combo,
  hmp.high_margin,
  rp.retail_price,
  op.ownbrand_portfolio,
  IF(
    chronic.chronic = "CHRONIC"
    , "Chronic"
    , IF(product.seller_category_code = "AQFV2U" AND product.seller_sub_category_code = "LALT0T", "Acute", NULL)
  ) AS chronic,
  essential.essential,

  CASE
      WHEN product.seller_category_code = "AQFV2U" THEN 
        CASE
          WHEN seller_sub_category.code ='LALT0T' THEN "Rx"
          WHEN seller_sub_category.code ='XT2U1Y' THEN "OTC"
        END
      WHEN product.seller_category_code IS NOT NULL THEN "Non-Drug"
  END AS product_category_commercial,

  REGEXP_REPLACE(JSON_VALUE(product.image_urls, "$[0]"), r'storage.googleapis.com', 'cdn-gcs.thuocsi.vn') AS product_image_url
  --  , CASE
  --       WHEN product.product_category = "Thuốc kê đơn" THEN "Rx"
  --       WHEN d.product_category = "Thuốc không kê đơn" THEN "OTC"
  --       WHEN d.product_category = "Thuốc (Chưa phân loại)" OR d.product_category IS NULL THEN NULL
  --       ELSE "Non-Drug"
  --   END AS product_category_commercial


FROM ${source.platinum}.marketplace_prd_product_v2_product AS product
LEFT JOIN  ${source.platinum}.seller_prd_core_seller AS seller on product.owner = seller.code
LEFT JOIN ${source.platinum}.marketplace_prd_product_v2_seller_category AS seller_category ON seller_category.code = product.seller_category_code
LEFT JOIN ${source.platinum}.marketplace_prd_product_v2_seller_sub_category AS seller_sub_category ON seller_sub_category.code = product.seller_sub_category_code
LEFT JOIN ${source.platinum}.marketplace_prd_product_v2_manufacturer AS manufacturer ON manufacturer.code = product.manufacturer_code
LEFT JOIN ${source.platinum}.core_prd_master_data_atc AS atc2 ON product.atc2_code = atc2.code
LEFT JOIN ${source.platinum}.core_prd_master_data_atc AS atc3 ON product.atc3_code = atc3.code
LEFT JOIN ${source.platinum}.marketplace_prd_product_v2_product AS tb1 ON tb1.code = JSON_EXTRACT_SCALAR(product.extra_props, '$.retail_category_codes.0')
LEFT JOIN product_retail_unit AS tb2 ON tb2.product_id = product.product_id
LEFT JOIN ${source.platinum}.core_prd_master_data_country AS tb3 ON tb3.code = product.origin
LEFT JOIN ${source.platinum}.marketplace_prd_product_v2_main_category AS tb4 ON tb4.code = product.main_category_code
-- LEFT JOIN product_cic AS cic ON cic.product_id = product.product_id
LEFT JOIN high_margin_product AS hmp ON hmp.product_id = product.product_id
LEFT JOIN is_ingredient_special AS iis ON iis.product_id = product.product_id
LEFT JOIN retail_price AS rp ON rp.product_id = product.product_id
LEFT JOIN brand AS br ON br.product_id = product.product_id
LEFT JOIN ownbrand_portfolio AS op ON op.product_id = product.product_id
LEFT JOIN chronic AS chronic ON chronic.product_id = product.product_id
LEFT JOIN essential AS essential ON essential.product_id = product.product_id
LEFT JOIN atc3 AS a3 ON a3.product_id = product.product_id
LEFT JOIN atc4 AS a4 ON a4.product_id = product.product_id

WHERE
    LOWER(product.name) NOT LIKE '%(bỏ)%'
    AND LOWER(product.name) NOT LIKE '%[bỏ]%'
    AND LOWER(product.name) NOT LIKE '%(tech%'
    AND LOWER(product.name) NOT LIKE '%[tech%'
    AND LOWER(product.name) NOT LIKE '%[oanh%'
    AND LOWER(product.name) NOT LIKE '%sp test%'
    AND LOWER(product.name) NOT LIKE '%[removed]%'
QUALIFY ROW_NUMBER() OVER(PARTITION BY product_id) = 1

post_operations {                
  ALTER TABLE ${self()} ADD PRIMARY KEY (product_id) NOT ENFORCED;
}