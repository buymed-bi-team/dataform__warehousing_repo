config {
    type: "table", 
    description: 
        `PIC: nguyen.tran; 
        Type: Table; 
        Refresh Schedule: hourly;
        Source: 
            ${source.platinum}.seller_prd_promotion_division
        `,
    tags: ["custom_1h_past5"]
}

WITH 
    client AS (
        select
            cast(code as integer) division_id,
            type,
            IF(value = 'NAN', null, value) as value
        from collector.data_prd
        where object = 'Product' and submit_id >= 4300 and type  in ('DIVISION_NAME', 'IMAGE_LINK', 'DATA_SHARING')
          and code not in ('216','217','218','219')
        qualify ROW_NUMBER() over (partition by code, object, type order by submit_at desc) = 1
    ),

    division AS (
        SELECT
            SAFE_CAST(JSON_EXTRACT_SCALAR(b.product_id) AS INT64) as product_id
            , JSON_EXTRACT_SCALAR(b.product_code) as product_code
            , a.division_id
            , a.division_code
            , a.division_name
        FROM ${source.platinum}.seller_prd_promotion_division AS a
            , UNNEST(JSON_QUERY_ARRAY(products)) AS b
    ),

    image AS (
        SELECT
            *
        FROM UNNEST([
            STRUCT (1246 AS division_id, "https://thuocsi1-my.sharepoint.com/:i:/g/personal/bi_buymed_com/EfOGh4eYWgFClpXIT8UbByABxtsNiSprBM7X5dEBewTXwA?e=eI1Xdt" AS image_link)
        ])
    )

select
    a.*,
    b.value as brand_name,
    COALESCE(lower(c.value), i.image_link) as image_link,
    d.value AS data_sharing_type
from division AS a
    left join client b on b.division_id = a.division_id and b.type = 'DIVISION_NAME'
    left join client c on c.division_id = a.division_id and c.type = 'IMAGE_LINK'
    left join client d on d.division_id = a.division_id and d.type = 'DATA_SHARING'
    left join image AS i on i.division_id = a.division_id

