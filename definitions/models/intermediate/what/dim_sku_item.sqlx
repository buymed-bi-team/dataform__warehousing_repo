config {
    type: "table",
    description: `Schedule: hourly | PIC: dong.le
    Source:
      ${source.platinum}.marketplace_prd_product_v2_sku,
      ${source.ref}.dim_fc_service_area
      ${source.ref}.dim_fc
      ${source.ref}.dim_sku
      ${source.ref}.fact_stock_sku_item
      ${source.ref}.dim_stock_classification
      ${source.ref}.dim_product_fc_catm
      ${source.ref}.agg_avg_demand_sku_item_l30d
      ${source.ref}.dim_sku_item_fv_vendor
      ${source.ref}.dim_sku_item_person_in_charge
      ${source.ref}.dim_sku_sales_region_current`,
    name: "dim_sku_item",
    assertions: {
      uniqueKey: ["sku_fc_key"]
    },
    tags: ["custom_1h_past5"],
    columns: {
       sku_fc_key: "primary-key, concatenation of product_id, seller_code, and fc_code",
       sku_sr_key: "concatenation of sku and sales region code",
       item_system_active: "the status of sku_item in system ( ACTIVE or INACTIVE )",
       inventory_price: "COALESCE(WHEN supplier_class = “EXTERNAL” THEN setting_price, WHEN supplier_class = “INTERNAL” THEN purchase_price END, 999)",
       sku_code: "sku identifier",
       product_id: "product identifier",
       sales_region_code: "active sales region of sku_item",
       fc_code: "warehouse code",
       supplier_code: "seller_code from dim_sku",
       supplier_class: "seller_class from dim_sku",
       item_code: "item_code from marketplace_prd_product_v2_sku",
       item_status: "status from marketplace_prd_product_v2_sku",
       item_is_active: "is_active from marketplace_prd_product_v2_sku",
       item_system_active: "if item_status IN ('NORMAL', 'LIMIT') AND item_is_active IS TRUE, 'ACTIVE', else 'INACTIVE'",
       demand_classification_code: "extra_props.demand_classification_code from marketplace_prd_product_v2_sku",
       latest_put_time: "last end_put_time from put_ticket",
       aging_put_days: "date difference from today to latest_put_time",
       latest_pick_time: "last created_time from pick_ticket",
       aging_pick_days: "date difference from today to latest_pick_time",
       note: "PO, SO, and ticket details for aging classification",
       type_stock_aging: "type_stock_aging for dim_stock_classification",
       catm_group: "category management group for product_fc",
       avg_demand_l15d: "average daily order quantity for SKU in the last 15 days",
       avg_demand_l30d: "average daily order quantity for SKU in the last 30 days",
       fv_vendor_code: "vendor_code with seller_prd_purchasing_sku_config.vendor.priority = 0",
       trading_type: "IF fv_vendor_code IS NULL, 'NON-TRADING', else 'TRADING'",
       pic_purchase_id: "pic_purchase_id from dim_sku_item_person_in_charge",
       pic_purchase_name: "corresponding username",
       pic_category_id: "cic_account_id from dim_sku_sales_region_current",
       pic_category_name: "corresponding username"


    }
}

WITH cte_sku AS (
  SELECT
    product_id,
    seller_code,
    item_code,
    sku,
    status,
    is_active,
    JSON_EXTRACT_SCALAR(extra_props, "$.demand_classification_code") as demand_classification_code,
    STRING(codes) AS location_code
  FROM ${source.platinum}.marketplace_prd_product_v2_sku s,
  UNNEST(JSON_EXTRACT_ARRAY(s.location_codes)) codes
),

cte_sku_sr_code AS (
  SELECT
    a.*,
    CASE
      WHEN LENGTH(a.location_code) = 2 THEN b.sales_region_code
      WHEN a.location_code IN ("MIENBAC", "MIENTRUNG", "MIENNAM") THEN a.location_code
    END AS sales_region_code
  FROM cte_sku a
  LEFT JOIN ${ref("dim_fc_service_area")} b
  ON a.location_code = b.service_area_code
  WHERE a.location_code NOT IN ("MN_ADM", "MB_ADM")

  UNION ALL

  SELECT
    a.*,
    "MIENTRUNG" AS sales_region_code
  FROM cte_sku a
  WHERE a.location_code IN ("MN_ADM", "MB_ADM")

  UNION ALL

  SELECT
    a.*,
    CASE
      WHEN a.location_code = "MN_ADM" THEN "MIENNAM"
      WHEN a.location_code = "MB_ADM" THEN "MIENBAC"
    END AS sales_region_code
  FROM cte_sku a
  WHERE a.location_code IN ("MN_ADM", "MB_ADM")
),

cte_sku_ranked AS (
  SELECT DISTINCT
    s.sku,
    s.sales_region_code,
    f.fc_code,
    s.product_id,
    s.item_code,
    s.status,
    s.is_active,
    s.demand_classification_code,
    ROW_NUMBER() OVER (PARTITION BY s.sku, s.sales_region_code ORDER BY s.product_id) AS row_num
  FROM cte_sku_sr_code s
  LEFT JOIN ${ref("dim_fc")} f on s.sales_region_code = f.sales_region_code
  WHERE s.sales_region_code IS NOT NULL
),

cte_sku_fc AS (
  SELECT
    s.sku_code,
    s.product_id,
    s.seller_code,
    s.seller_class,
    f.fc_code,
    f.sales_region_code
  FROM ${ref("dim_sku")} s
  CROSS JOIN ${ref("dim_fc")} f
),

cte_sku_item AS ( 
  SELECT
    CONCAT(sf.product_id, "_", sf.seller_code, "_", sf.fc_code) AS sku_fc_key,
    CONCAT(sf.product_id, "_", sf.seller_code, "_", sf.sales_region_code) AS sku_sr_key,
    sf.sku_code,
    sf.product_id,
    sf.sales_region_code,
    sf.fc_code,
    sf.seller_code as supplier_code,
    sf.seller_class as supplier_class,
    sr.item_code,
    sr.status as item_status,
    sr.is_active as item_is_active,
    IF(
      sr.status IN ('NORMAL', 'LIMIT') AND sr.is_active IS TRUE,
      'ACTIVE',
      'INACTIVE'
    ) AS item_system_active,
    sr.demand_classification_code
  FROM cte_sku_fc sf
  LEFT JOIN cte_sku_ranked sr
  ON sf.sku_code = sr.sku AND sf.fc_code = sr.fc_code AND sr.row_num = 1
),

cte_sku_fc_location AS (
  SELECT
    sku_fc_key,
    STRING_AGG(location_code, ', ') AS location_codes
  FROM ${ref("fact_stock_sku_item")}
  GROUP BY sku_fc_key
),

cte_sku_fc_agg AS (
  SELECT
    a.*,
    b.latest_put_time,
    b.aging_put_days,
    b.latest_pick_time,
    b.aging_pick_days,
    b.note,
    b.lastest_put_is_inbound,
    b.type_stock_aging,
    c.catm as catm_group,
    c.height,
    c.length,
    c.width,
    d.avg_demand_l30d,
    d.avg_demand_l15d,
    COALESCE(i.fv_code, a.supplier_code) as fv_vendor_code,
    IF (i.fv_code IS NULL, "NON-TRADING", "TRADING") as trading_type,
    SAFE_CAST(f.pic_purchase_id AS INT64) as pic_purchase_id,
    f.pic_purchase_name,
    COALESCE(SAFE_CAST(i.cic_account_id AS INT64), f.pic_category_id) as pic_category_id,
    COALESCE(i.cic_name, f.pic_category_name) as pic_category_name,
    COALESCE(
      CASE
        WHEN g.seller_class = "EXTERNAL" THEN g.retail_price_value
        WHEN g.seller_class = "INTERNAL" THEN g.purchase_price
      END, 999) AS inventory_price,
    h.location_codes,
    i.fv_vendor_stock_days,
    i.sku_leadtime as fv_vendor_leadtime,
    

  FROM cte_sku_item a
  LEFT JOIN ${ref("dim_stock_classification")} b
  ON a.sku_code = b.sku_code AND a.fc_code = b.fc_code
  LEFT JOIN ${ref("dim_product_fc_catm")} c
  ON a.product_id = c.product_id AND a.fc_code = c.fc_code
  LEFT JOIN ${ref("agg_avg_demand_sku_item_l30d")} d
  ON a.sku_fc_key = d.sku_fc_key
  -- LEFT JOIN ${ref("dim_sku_item_fv_vendor")} e
  -- ON a.sku_code = e.sku_code AND a.fc_code = e.fc_code
  LEFT JOIN ${ref("dim_sku_item_person_in_charge")} f
  ON a.sku_code = f.sku_code AND a.fc_code = f.fc_code
  LEFT JOIN ${source.platinum}.marketplace_prd_product_v2_sku g
  ON a.item_code = g.item_code
  LEFT JOIN cte_sku_fc_location h
  ON a.sku_fc_key = h.sku_fc_key
  LEFT JOIN ${ref("dim_sku_sales_region_current")} i 
  ON a.sku_code = i.sku_code AND a.fc_code = i.fc_code

)

SELECT *
FROM cte_sku_fc_agg
WHERE product_id NOT IN (127470, 219446, 245422, 127138)
qualify row_number() over (partition by sku_fc_key) = 1

post_operations {
    ALTER TABLE ${self()} ADD PRIMARY KEY (sku_fc_key) NOT ENFORCED;
}