config {
    type: "view",
    description: "Source: marketplace_prd_product_v2_product_category_management | PIC: dong.le",
    name: "dim_product_fc_catm",
    columns: {
        product_id: "unique identifier for the product",
        fc_code: "code representing the fulfillment center",
        catm: "category management code, prioritizing fulfillment center category management (fc_catm) if available, otherwise defaulting to general category management (catm)"
    }
}

WITH
dedup_product_catm AS ${dedup.dedup(
  source.silver + `.marketplace_prd_product_v2_product_category_management`,
  "product_id, category_management_data, category_management"
)},

unnest_product_catm AS (
  SELECT
    c.product_id,
    STRING(cm.warehouse_code) as fc_code,
    STRING(cm.category_management) as fc_catm,
    c.category_management as catm 
  FROM dedup_product_catm c
  LEFT JOIN UNNEST(JSON_EXTRACT_ARRAY(c.category_management_data)) cm
)

SELECT DISTINCT
  p.product_id,
  p.height,
  p.length,
  p.width,
  f.fc_code,
  COALESCE(upc.fc_catm, upc2.catm) as catm
FROM ${ref("dim_product")} p
CROSS JOIN ${ref("dim_fc")} f
LEFT JOIN unnest_product_catm upc
  ON p.product_id = upc.product_id 
  AND f.fc_code = upc.fc_code
LEFT JOIN unnest_product_catm upc2
  ON p.product_id = upc2.product_id 
  AND upc.fc_catm IS NULL
  