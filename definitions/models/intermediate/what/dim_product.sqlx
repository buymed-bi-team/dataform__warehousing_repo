config {
    type: "table",
    description: `PIC: minh.luu & dong.le; model_type: table; orchestration: hourly
    Source:
      ${source.platinum}.marketplace_prd_product_v2_product
      ${source.platinum}.seller_prd_core_seller
    `,
    name: "dim_product",
    tags: ["custom_1h_past5"],
    assertions: {
        uniqueKey: "product_id",
        nonNull: ["product_id","owner_code"]
    },
    columns: {
        product_id: "NonNull | Unique identifier for each product",
        product_name: "NonNull | Name of the product",
        owner_code : "NonNull | Code representing the owner (seller) of the product",
        owner_name : "NonNull | Name of the owner (seller) of the product",
        unit : "Nullable | Unit of measure for the product",
        volumes : "Nullable | Volume information for the product",
        is_prescription: "NonNull | Indicates whether the product is drug",
        is_fragile: "NonNull | Indicates whether the product is easily breakable",
        is_frozen : "NonNull | Indicates whether the product requires freezing",
        height: "NonNull | Product height",
        length: "NonNull | Product length",
        width: "NonNull | Product width",
        product_report_category : "NonNull | Category of the product based on certain criteria and logic: If owner_name contains '[Tech]', then 'TECH'; If owner_code is 'MARKETING', then 'MARKETING'; If owner_code is 'DENX', then 'DENX'; If unit or volumes is 'COMBO', then 'COMBO'; If product_name contains certain keywords, then 'PROMOTION'; Otherwise, 'NORMAL' "
    }
}

/*
Chú thích chi tiết:
    Product_report_category:
        DENX : Từ tất cả sản phẩm đến từ nhà bán DENX
        TECH : các sản phẩm được tạo ra để kiểm thử phần mềm, hệ thống internal
        MARKETING : các sản phẩm chủ yếu để quảng bá có campaign
        COMBO     : Tất cả các sản phẩm là bán theo 1 combo, tuy nhiên có 1 số sản phẩm tuy bán combo 
                        nhưng thật ra combo đó để khuyến mãi PROMOTION mà th
        PROMOTION : Tất cả các sản phẩm khuyến mãi
        NORMAL    : Các Sản phẩm không theo nhóm trên
*/

WITH stg_product as (
  SELECT
    product_id,
    name as product_name,
    owner as owner_code,
    unit,
    volumes,
    is_prescription,
    is_fragile,
    is_frozen,
    height,
    length,
    width
  FROM ${source.platinum}.marketplace_prd_product_v2_product
)
,
stg_seller as (
  SELECT
    code,
    seller_id,
    name as owner_name
  FROM ${source.platinum}.seller_prd_core_seller
)

SELECT
  product_id,
  product_name,
  owner_code,
  owner_name,
  unit,
  volumes,
  IF(is_prescription = TRUE, "DRUG","NON-DRUG") is_prescription,
  IF(is_fragile = TRUE,"FRAGILE","NORMAL") is_fragile,
  IF(is_frozen = TRUE, "FROZEN","NORMAL") is_frozen,
  height,
  length,
  width,
  CASE
    WHEN owner_name LIKE '%[Tech]%' THEN 'TECH'
    WHEN owner_code LIKE 'MARKETING' then 'MARKETING'
    WHEN owner_code LIKE 'DENX' then 'DENX'
    WHEN UPPER( COALESCE( unit, volumes ) ) = 'COMBO' then 'COMBO'
    WHEN REGEXP_CONTAINS(
          LOWER(product_name),
          r'combo|quà|tặng|khuyến mãi|khuyến mại|hóa đơn|bảo hiểm|thẻ cào|mua|gift 1|gift 2|tờ rơi|áo blouse|poster|ưu đãi|trưng bày'
        ) OR LOWER(product_name) LIKE '% circa %' OR LOWER(product_name) LIKE '% thuocsi %' 
        then 'PROMOTION'
    ELSE 'NORMAL'
  END product_report_category
FROM 
  stg_product p
LEFT JOIN  stg_seller s on p.owner_code = s.code


post_operations {                
  ALTER TABLE ${self()} ADD PRIMARY KEY (product_id) NOT ENFORCED;
}
