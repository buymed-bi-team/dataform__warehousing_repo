config {
  type: "view",
  description: "Source: warehouse_prd_picking_pick_ticket, warehouse_prd_picking_pick_ticket_item, where so LIKE '%SO%' and created_time is in the last 15 days | PIC: dong.le",
  name: "agg_avg_demand_sku_item_l15d",
  columns: {
    sku_fc_key: "concatenation of sku key and warehouse code",
    avg_demand_l15d: "average daily order_quantity for each sku_fc_key"
  }
}

WITH dedup_pick_ticket AS ${dedup.dedup(
  "lakehouse-prod-394907.silver_buymed_vn.warehouse_prd_picking_pick_ticket",
  "ticket_id, so, warehouse_code as fc_code, status, created_time",
  "timestamp(date_sub(current_date(),interval 15 day))"
)},

dedup_pick_ticket_item AS ${dedup.dedup(
  "lakehouse-prod-394907.silver_buymed_vn.warehouse_prd_picking_pick_ticket_item",
  "ticket_id, sku as sku_code, order_quantity",
  "timestamp(date_sub(current_date(),interval 15 day))"
)},

filtered_data AS (
    SELECT 
        CONCAT(c.sku_key, "_", a.fc_code) as sku_fc_key,
        b.sku_code,
        a.fc_code,
        b.order_quantity AS outgoing_quantity,
        DATE(a.created_time) AS created_date
    FROM dedup_pick_ticket_item AS b
    LEFT JOIN dedup_pick_ticket AS a ON b.ticket_id = a.ticket_id
    LEFT JOIN ${ref("dim_sku")} AS c ON b.sku_code = c.sku_code
    WHERE a.so LIKE "%SO%"
),

daily_outgoing AS (
    SELECT
        sku_fc_key,
        created_date,
        SUM(outgoing_quantity) AS total_daily_outgoing
    FROM filtered_data
    GROUP BY sku_fc_key, created_date
)

SELECT
    sku_fc_key,
    AVG(total_daily_outgoing) AS avg_demand_l15d
FROM daily_outgoing
GROUP BY sku_fc_key


  