config {
    type: "table",
    description: "PIC: minhluu; model_type: table; schedule: Manual",
    assertions: {
        uniqueKey: "metric_code",
        nonNull: ["metric_code"]
        // rowConditions: [`metric_code = lv2 || "_" || lv1 OR metric_code = lv2 || "_" || "NULL_REGION"`]
    }
}

/*
    dim_strategic_metric Adding Rule:
        - metric_code is primary key. Currently it is concat of lv2 and lv1
        - description doesn't support character `,`    
        - Remember to trigger assertions
*/


${cfunction.csvToSQL(`
    "metric_code"                       ,"lv1"              ,"lv2"          ,"desciption"
    "GMV_By_Channel_TENDER"             ,"TENDER"           ,"GMV By Channel","GMV calculated from orders in the Tender channel. GMV is the sum of price field in marketplace order table. In tender GMV is the sum of total_amount in order table "
    "GMV_By_Channel_MARKETPLACE"        ,"MARKETPLACE"      ,"GMV By Channel","GMV calculated from orders in the MARKETPLACE channel"
    "GMV_By_Channel_DISTRIBUTION"       ,"DISTRIBUTION"     ,"GMV By Channel","GMV calculated from orders in the DISTRIBUTION channel"
    "GMV_By_Channel_CONSIGNMENT"        ,"CONSIGNMENT"      ,"GMV By Channel","GMV calculated from orders in the CONSIGNMENT channel"
    "GMV_By_Channel_CIRCA"              ,"CIRCA"            ,"GMV By Channel","GMV calculated from orders in the CIRCA channel"
    "GMV_By_Region_MIENBAC"             ,"MIENBAC"          ,"GMV By Region","GMV calculated from orders in the MIENBAC region"
    "GMV_By_Region_MIENTRUNG"           ,"MIENTRUNG"        ,"GMV By Region","GMV calculated from orders in the MIENBAC region"
    "GMV_By_Region_MIENNAM"             ,"MIENNAM"          ,"GMV By Region","GMV calculated from orders in the MIENBAC region"
    "GMV_By_Region_NULL_REGION"         ,"UNKNOWN REGION"   ,"GMV By Region","GMV calculated from orders without assigned region"
`, value_prediction='"')}

