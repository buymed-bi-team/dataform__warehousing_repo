    "Item_Sold_NULL_REGION"             ,"UNKNOWN REGION"   ,"Item_Sold"    ,"Count the number of items sold without assigned region"
    "Fulfilled_Amount_MIENBAC"          ,"MIENBAC"          ,"Fulfilled_Amount","The total amount based on fulfilled orders in the MIENBAC region. The fulfilled orders must be one of following status: DELIVERING or DELIVERED or COMPLETED "
    "Fulfilled_Amount_MIENTRUNG"        ,"MIENTRUNG"        ,"Fulfilled_Amount","The total amount based on fulfilled orders in the MIENTRUNG region"
    "Fulfilled_Amount_MIENNAM"          ,"MIENNAM"          ,"Fulfilled_Amount","The total amount based on fulfilled orders in the MIENNAM region"
    "Fulfilled_Amount_NULL_REGION"      ,"UNKNOWN REGION"   ,"Fulfilled_Amount","The total amount based on fulfilled orders without assigned region"
    "Unfulfilled_Amount_MIENBAC"        ,"MIENBAC"          ,"Unfulfilled_Amount","The total amount based on unfulfilled orders in the MIENBAC region. The unfulfilled orders must be one of following status: CONFIRMED or PROCESSING or WAIT_TO_DELIVER "
    "Unfulfilled_Amount_MIENTRUNG"      ,"MIENTRUNG"        ,"Unfulfilled_Amount","The total amount based on unfulfilled orders in the MIENTRUNG region"
    "Unfulfilled_Amount_MIENNAM"        ,"MIENNAM"          ,"Unfulfilled_Amount","The total amount based on unfulfilled orders in the MIENNAM region"
    "Unfulfilled_Amount_NULL_REGION"    ,"UNKNOWN REGION"   ,"Unfulfilled_Amount","The total amount based on unfulfilled orders without assigned region"
    "Cancellation_Amount_MIENBAC"       ,"MIENBAC"          ,"Cancellation_Amount","The total amount based on cancellation orders in the MIENBAC region. The cancellation orders must be one of following status: CANCEL or CANCELLED "
    "Cancellation_Amount_MIENTRUNG"     ,"MIENTRUNG"        ,"Cancellation_Amount","The total amount based on cancellation orders in the MIENTRUNG region"
    "Cancellation_Amount_MIENNAM"       ,"MIENNAM"          ,"Cancellation_Amount","The total amount based on cancellation orders in the MIENNAM region"
    "Cancellation_Amount_NULL_REGION"   ,"UNKNOWN REGION"   ,"Cancellation_Amount","The total amount based on cancellation orders without assigned region"
    "Backorder_Amount_MIENBAC"          ,"MIENBAC"          ,"Backorder_Amount","The total amount based on back orders in the MIENBAC region. The back orders amount is get from accounting_prd_core_credit_note with type = return"
    "Backorder_Amount_MIENTRUNG"        ,"MIENTRUNG"        ,"Backorder_Amount","The total amount based on back orders in the MIENTRUNG region"
    "Backorder_Amount_MIENNAM"          ,"MIENNAM"          ,"Backorder_Amount","The total amount based on back orders in the MIENNAM region"
    "Backorder_Amount_NULL_REGION"      ,"UNKNOWN REGION"   ,"Backorder_Amount","The total amount based on back orders without assigned region"
    "Outbound_Backlog_MIENBAC"          ,"MIENBAC"          ,"Outbound_Backlog","Count Orders has status CONFIRMED or PROCESSING or WAIT_TO_DELIVER and in the MIENBAC region"
    "Outbound_Backlog_MIENTRUNG"        ,"MIENTRUNG"        ,"Outbound_Backlog","Count Orders has status CONFIRMED or PROCESSING or WAIT_TO_DELIVER and in the MIENTRUNG region"
    "Outbound_Backlog_MIENNAM"          ,"MIENNAM"          ,"Outbound_Backlog","Count Orders has status CONFIRMED or PROCESSING or WAIT_TO_DELIVER and in the MIENNAM region"
    "Outbound_Backlog_NULL_REGION"      ,"UNKNOWN REGION"   ,"Outbound_Backlog","Count Orders has status CONFIRMED or PROCESSING or WAIT_TO_DELIVER and without assigned region"
*/


post_operations {
    ALTER TABLE ${self()} ADD PRIMARY KEY (metric_code) NOT ENFORCED;
}