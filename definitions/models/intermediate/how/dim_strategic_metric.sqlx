    "#_Orders_NULL_REGION"              ,"UNKNOWN REGION"   ,"#_Orders"     ,"Count Orders without assigned region"
    "#_Delivers_MIENBAC"                ,"MIENBAC"          ,"#_Delivers"   ,"Count Orders has status DELIVERED OR COMPLETED in MIENBAC region "
    "#_Delivers_MIENTRUNG"              ,"MIENTRUNG"        ,"#_Delivers"   ,"Same Orders but MIENTRUNG region"
