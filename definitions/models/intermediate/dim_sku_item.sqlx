config {
    type: "table",
    description: " PIC: dong.le",
    name: "dim_sku_item",
    tags: ["0h00"],
    columns: {
       sku_fc_code: "primary-key, concatenation of sku and fc code"
    }
}

WITH cte_sku AS (
  SELECT
    product_id,
    seller_code,
    item_code,
    sku,
    STRING(codes) AS location_code
  FROM silver_buymed_vn.marketplace_prd_product_v2_sku_merge s,
  UNNEST(JSON_EXTRACT_ARRAY(s.location_codes)) codes
),

cte_sku_sr_code AS (
  SELECT
    a.*,
    CASE
      WHEN LENGTH(a.location_code) = 2 THEN b.sales_region_code
      WHEN a.location_code IN ("MIENBAC", "MIENTRUNG", "MIENNAM") THEN a.location_code
    END AS sales_region_code
  FROM cte_sku a
  LEFT JOIN gold_buymed_vn2.dim_fc_service_area b
  ON a.location_code = b.service_area_code
  WHERE a.location_code NOT IN ("MN_ADM", "MB_ADM")

  UNION ALL

  SELECT
    a.*,
    "MIENTRUNG" AS sales_region_code
  FROM cte_sku a
  WHERE a.location_code IN ("MN_ADM", "MB_ADM")

  UNION ALL

  SELECT
    a.*,
    CASE
      WHEN a.location_code = "MN_ADM" THEN "MIENNAM"
      WHEN a.location_code = "MB_ADM" THEN "MIENBAC"
    END AS sales_region_code
  FROM cte_sku a
  WHERE a.location_code IN ("MN_ADM", "MB_ADM")
),

cte_sku_ranked AS (
  SELECT 
    CONCAT(s.sku, "_", f.fc_code) AS sku_fc_code,
    s.sku,
    s.sales_region_code,
    f.fc_code,
    s.product_id,
    ROW_NUMBER() OVER (PARTITION BY s.sku, s.sales_region_code ORDER BY s.product_id) AS row_num
  FROM cte_sku_sr_code s
  JOIN ${ref("dim_fc")} f on s.sales_region_code = f.sales_region_code
  WHERE s.sales_region_code IS NOT NULL
)

-- cte_sku_fc AS (
--   SELECT

-- )

SELECT
    sku_fc_code,
    sku,
    sales_region_code,
    fc_code,
    product_id
FROM
    cte_sku_ranked
WHERE
    row_num = 1
