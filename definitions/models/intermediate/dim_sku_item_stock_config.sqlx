config {
    type: "view",
    description: "Source: seller_prd_purchasing_initial_stock_draft_unique | PIC: dong.le",
    name: "dim_sku_item_stock_config",
    columns: {
      sku_code: "unique identifier for SKU",
      fc_code: "warehouse code",
      initial_stock: "origin_initial_stock",
      sku_leadtime: "leadtime extracted from extra_props",
      sku_stockday: "stock_day extracted from extra_props",
    }
}

WITH
  dedup_stock_draft_unique AS ${dedup.dedup(
  source.silver + `.seller_prd_purchasing_initial_stock_draft_unique`,
  "sku, warehouse_code, origin_initial_stock, extra_props"
)}

SELECT
  a.sku as sku_code,
  a.warehouse_code as fc_code,
  a.origin_initial_stock as initial_stock,
  json_value(a.extra_props, "$.leadtime") as sku_leadtime,
  json_value(a.extra_props, "$.stock_day") as sku_stockday
FROM dedup_stock_draft_unique a
LEFT JOIN ${ref("dim_sku")} b ON a.sku = b.sku_code