config {
    type: "view",
    description: `Churn Customer: Khách hàng tháng trước có mua ít nhất 1 đơn không tính đơn Cancel. Tháng kế tiếp không mua
    PIC: Huong.Dang`
}

SELECT
  customer_id,
  year_month
FROM
  ${ref('agg_customer_profiling')}
WHERE
  (has_purchase = false
  AND previous_month_purchase = true)
