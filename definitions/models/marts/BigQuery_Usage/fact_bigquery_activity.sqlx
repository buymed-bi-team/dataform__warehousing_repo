config {
    type: "incremental", // view, table , incremental
    name: "fact_bigquery_activity",
    description: `PIC: <minh.luu> , model_type: incremental ; schedule: every 1h`,
    columns:{
    },
    tags: ["bq_job"],
    bigquery: { /* except view */
        partitionBy: "DATE(execution_time)",
        clusterBy: ["user_email","state","job_id"]
    },
    columns: {
        base_key : `Unique Key, which is generated by concat of job_id, user_email, creation_time`,
        job_id : `Job Indentify`,
        job_type : `is enum of (EXTRACT, LOAD, QUERY,COPY) `,
        priority : ``,
        state : ``,
        statement_type: ``,
        query : `SQL script`,
        total_bytes_processed : `in Byte, to convert to GB please multiply with  dim_bq_user table, byte_to_MB column`,
        total_bytes_billed : `in Byte, to convert to GB please multiply with  dim_bq_user table, byte_to_MB column`,
        execution_time : `creation time of script or execution_time of script, in UTC. It also is the partition column `,
        execution_time_vn : `creation time of script or execution_time of script, in VN timezone. Note that: this isn’t partition column, use execution_time instead`,
        user_email: `is full email address of user/account is responsible for this job. It also is foreign key to dim_bq_user`,
    }
}

pre_operations {
    DECLARE execution_time_checkpoint TIMESTAMP;
    ${when(
        incremental(),
        `
        SET execution_time_checkpoint = (SELECT max(execution_time) - INTERVAL 2 HOUR FROM ${self()});
        DELETE FROM ${self()} WHERE execution_time >= execution_time_checkpoint;`,
        `SET execution_time_checkpoint = CURRENT_TIMESTAMP() - INTERVAL 15 DAY`
    )}
}

SELECT 
    base_key,
    job_id,
    job_type,
    priority,
    state,
    statement_type,
    query,
    
    total_bytes_processed,
    total_bytes_billed,
    
    execution_time + INTERVAL 7 HOUR AS execution_time_vn,
    execution_time,
    user_email,
    

    label.* except(base_key)
    

    
FROM ${ref('base_information_schema_job')} base 
LEFT JOIN ${ref('int_bq_label_and_table')} label USING ( base_key )

WHERE execution_time >= execution_time_checkpoint

