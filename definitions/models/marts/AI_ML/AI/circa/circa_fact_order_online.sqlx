config {
    type: 'table',
    schema: "buymed_innovation",
    description: `All online orders of Circa.`,
    tags: ['AI_CIRCA', "custom_1h_past10"]
}


SELECT 
   o.* EXCEPT (status, deliver_status, pos_status, price, total_price)
    -- , price AS or
    , SUM(oi.quantity * oi.price) AS revenue
    , SUM(oi.origin_price * oi.quantity) AS gmv
    , o.o2o_status AS status
    , o.delivery_tags
    , o.distance_km
    , oi.product_id
    , oi.product_name
    , oi.unit
    , oi.price AS unit_price
    , oi.quantity
    , oi.origin_price
    , is_deal1k
    , deal_name
    , campaign_name
FROM ${ref("gold_buymed_vn2", "circa_online_order_item")} AS oi
    LEFT JOIN ${ref("gold_buymed_vn2", "circa_online_order")} AS o USING(order_code)
    GROUP BY ALL


