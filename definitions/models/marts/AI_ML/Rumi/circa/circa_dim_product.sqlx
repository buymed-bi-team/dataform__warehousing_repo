config {
    type: 'view',
    schema: "buymed_innovation",
    description: `Product of Circa COS.`,
    tags: ['AI_CIRCA']
}

SELECT 
    product_id
  , product_name
  , NULLIF(product_category, "Thuốc (Chưa phân loại)") AS product_category
  , cat2
  , cat3
  , cat4
  , volumes
  , a.unit
  , manufacture_name
  , product_id AS product_id_key
  , is_allstore AS is_essential
  , is_allstore
  , brand
  ,  web_status AS status_online
  ,  sell_area_online 
FROM ${ref('gold_buymed_vn2', 'circa_dim_master_product')} AS a
QUALIFY ROW_NUMBER() OVER(PARTITION BY product_id) = 1