-- dim_competitor_price
CREATE OR REPLACE VIEW `rumi_buymed_circa.circa_dim_competitor_price`
AS (SELECT * FROM  ${ref("buymed_innovation", "thuocsi_vn_agg_competitor_price")}
    WHERE LOWER(competitor_name) IN ('longchau', 'pharmacity')
);

