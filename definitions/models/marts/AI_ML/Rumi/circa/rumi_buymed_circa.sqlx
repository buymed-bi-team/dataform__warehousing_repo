config {
    type:"operations",
    tags: ["AI_CIRCA"]
}

-- fact_order

CREATE OR REPLACE VIEW `rumi_buymed_circa.circa_fact_order`
AS (SELECT * EXCEPT(order_completed_at), DATETIME(order_completed_at) AS order_completed_at FROM  ${ref("buymed_innovation", "circa_fact_order")});


