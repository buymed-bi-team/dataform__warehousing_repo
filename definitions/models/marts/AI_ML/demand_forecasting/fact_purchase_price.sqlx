config {
    type: "table",
    description: "PIC: huong.dang, schedule 6:00am daily",
    schema: "gold_ml",
    tags: ["6h00"]
}

SELECT
  date,
  code as sku_code,
  product_id,
  MIN(purchase_price) as purchase_price
FROM
  ${ref('staging_sku_purchase_price_history')}
WHERE
  seller_code ="MEDX" AND purchase_price > 1000
GROUP BY 1,2,3
ORDER BY 2
