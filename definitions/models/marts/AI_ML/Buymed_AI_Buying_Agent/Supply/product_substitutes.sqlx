config {
    type: 'incremental',
    schema: "buying_agent_input",
    tags: ["AI_Buying_Agent"]
}

SELECT
    a.product_id
    , substitute_id AS substitute_product_id
    , CASE
        WHEN b.brand = c.brand AND d.ingredient_id = e.ingredient_id AND d.volume = e.volume AND b.volumes <> c.volumes
            THEN "PACK_SIZE_VARIANT"
        WHEN b.brand = c.brand  THEN "SAME_BRAND_VARIANT"
        ELSE "SAME_ACTIVE_GENERIC "
    END AS relation_type
    , IF(is_manual_add, "CURATED", "RULE_DERIVED") AS source
    , CURRENT_DATE("+7") AS snapshot_date
FROM platinum_buymed_vn.marketplace_prd_product_v2_substitute_product AS a
    LEFT JOIN ${ref("dim_product")} AS b ON a.product_id = b.product_id
    LEFT JOIN ${ref("dim_product")} AS c ON a.substitute_id = c.product_id
    LEFT JOIN ${ref("dim_product_ingredient")} AS d ON a.product_id = d.product_id AND d.ingredient_level = 1
    LEFT JOIN ${ref("dim_product_ingredient")} AS e ON a.substitute_id = e.product_id AND e.ingredient_level = 1

post_operations {
    IF NOT EXISTS (
        SELECT 1
        FROM buying_agent_input.INFORMATION_SCHEMA.TABLE_CONSTRAINTS
        WHERE table_name = 'product_substitutes'
        AND constraint_type = 'PRIMARY KEY'
    ) THEN

    ALTER TABLE ${self()} 
        ADD PRIMARY KEY (product_id, substitute_product_id, snapshot_date) NOT ENFORCED;
    END IF;
}