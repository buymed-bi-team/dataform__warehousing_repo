config {
    type: 'table',
    schema: "buymed_circa_recommendation",
    description: `All active product of web Circa.`,
    tags: [ "custom_1h_past10"]
}

WITH base_unit_selection AS (
    SELECT 
         product_id
        ,client_id
        ,base_unit
        ,ROW_NUMBER() OVER (
            PARTITION BY product_id, client_id
            ORDER BY COUNT(*) DESC
        ) AS rn
    FROM lakehouse-prod-394907.gold_buymed_vn2.cos_product_convert_base_unit
    GROUP BY ALL
)
,base_unit AS (
    SELECT
         a.*
    FROM `lakehouse-prod-394907.gold_buymed_vn2.cos_product_convert_base_unit` a
    LEFT JOIN base_unit_selection b
        ON a.product_id = b.product_id
        AND a.client_id = b.client_id
        AND a.base_unit = b.base_unit
    WHERE b.rn = 1
         AND a.client_id = 1
), base_data AS (
SELECT 
         DATETIME_ADD(e.created_time, INTERVAL 7 hour) AS eventTime
       , o.code AS order_code
       , e.customer_phone
       , i.product_id
       , i.unit
       , convert_rate
       , i.quantity 
       , i.quantity * COALESCE(cv.convert_rate,1) AS base_quantity
       , CASE
        WHEN i.order_apply_combo_id IS NOT NULL
         AND i.order_apply_combo_id <> ''
        THEN ROUND(
            SAFE_DIVIDE(
                (c.combo_price - c.discount_amount)
                * c.quantity
                * SAFE_DIVIDE(
                    i.system_price * i.quantity
                    ,SUM(i.system_price * i.quantity)
                        OVER (PARTITION BY i.order_apply_combo_id)
                )
                ,i.quantity
            )
        )
        ELSE unit_price
    END AS unit_price
FROM `buymed_circa_v2.order_order` o 
LEFT JOIN buymed_circa_v2.order_order_item i ON o.id  = i.order_id
LEFT JOIN `platinum_buymed_vn.circa_online_prd_order_order` e ON o.reference_order_in_platform = e.order_code
LEFT JOIN buymed_circa_v2.order_order_apply_combo c ON i.order_apply_combo_id = c.id
LEFT JOIN buymed_circa_v2.product_retail_unit cv ON LOWER(i.unit) = LOWER(cv.unit) AND o.client_id = cv.client_id AND i.product_id = cv.product_id 
WHERE o.type = 'ONLINE'
     AND o.status IN ('COMPLETED', 'COMPLETED_SHIPPING')
     )
     SELECT "purchase-complete" AS eventType
           , customer_phone AS visitorID
           , eventTime
           , SUM(quantity* unit_price) AS GMV
           , 'VND' AS currencyCode
           , i.product_id
           , SAFE_DIVIDE( base_quantity , cv.convert_rate) AS quantity
     FROM base_data i
     LEFT JOIN base_unit cv  ON cv.product_id = i.product_id
                        AND cv.convert_unit = i.unit
                       
     GROUP BY ALL
