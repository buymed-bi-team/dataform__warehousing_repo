config {
    type: 'table',
    schema: "buymed_circa_recommendation",
    description: `All active product of web Circa.`,
    tags: [ "custom_1h_past10"]
}

WITH base_data AS (
  SELECT t.product_id
    , t.unit
    , CAST(JSON_value(t.extra_props, '$.reserved_quantity') AS INT64)                              AS quantity
    , t.order_code
    , t.total_price
    , b.customer_phone
    , b.created_time
  FROM lakehouse-prod-394907.platinum_buymed_vn.circa_online_prd_order_order_item t
  LEFT JOIN `platinum_buymed_vn.circa_online_prd_order_order` b ON t.order_code = b.order_code
  WHERE b.status = 'DELIVERED' 
), final AS (
SELECT
    a.* 
  ,a.quantity * cv.convert_rate AS base_quantity
  ,cv.base_unit
FROM base_data a
LEFT JOIN buymed_circa_v2.product_retail_unit cv ON a.product_id = cv.product_id AND lower(a.unit) = lower(cv.unit)
WHERE quantity > 0
)
SELECT  "purchase-complete" AS eventType
           , customer_phone AS visitorID
           , created_time AS eventTime
           , SUM(total_price) AS GMV
           , 'VND' AS currencyCode
           , i.product_id
          -- , i.unit
          -- , cv.convert_rate
          -- , base_quantity
           , ROUND(SAFE_DIVIDE(i.base_quantity, cv.convert_rate)) AS quantity
FROM final i
LEFT JOIN (
            SELECT distinct a.product_id, b.convert_rate FROM `buymed_circa_recommendation.circa_dim_product` a 
            LEFT JOIN buymed_circa_v2.product_retail_unit b ON a.product_id = b.product_id AND lower(a.unit) = lower(b.unit) AND b.client_id = 1
     )  cv ON   cv.product_id = i.product_id      
-- WHERE order_code = 'DH015973'
GROUP BY ALL