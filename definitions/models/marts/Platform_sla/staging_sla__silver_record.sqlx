  [ "seller_prd_core_pic", "1", "1" ]  , 
  [ "platform_insider_prd_communication_web_push_campaign", "1", "1" ]  , 
  [ "platform_insider_prd_communication_app_push_session", "1", "1" ]  , 
  [ "marketplace_prd_product_v2_sku", "1", "1" ]  , 
  [ "warehouse_prd_inventory_audit_session_task_item", "1", "1" ]  , 
  [ "marketplace_prd_promotion_user_promotion", "1", "1" ]  , 
  [ "delivery_prd_transporting_shipping_order", "1", "1" ]  , 
  [ "marketplace_prd_order_v2_order_item", "1", "1" ]  , 
  [ "seller_prd_wis_return_order", "1", "1" ]  , 
  [ "pim_prd_product_product_retail_price", "1", "1" ]  , 
  [ "platform_insider_prd_communication_webhook_app_push_tracking", "1", "1" ]  
    ]
}

WITH top_silver_layer AS (
  -- The most event table
${
    table_lst.map(
        a => `
        SELECT 
            "${a[0]}" table_name,
            mg_id,
            ${a[1] === "1" ? `created_time` : `CAST(NULL AS TIMESTAMP)`} created_time,
            ${a[2] === "1" ? `last_updated_time` : `CAST(NULL AS TIMESTAMP)`} last_updated_time, 
            synced_at, 
            ingest_time
        FROM silver_buymed_vn.${a[0]} 
        WHERE ingest_time >= "2025-05-27"
        `
    ).join("UNION ALL")
}
)

  -- SELECT 
  --   "_All" table_name,
  --   mg_id , created_time ,
  --   COALESCE(last_updated_time, silver_buymed_vn.MONGOID_TIMESTAMP(mg_id), created_time  ) last_updated_time, 
  --   synced_at, ingest_time 
  -- FROM top_silver_layer
  -- UNION ALL 
  SELECT 
    table_name,

    mg_id  || CAST(UNIX_MICROS(created_time) AS STRING) mg_id,
    COALESCE(last_updated_time, created_time, silver_buymed_vn.MONGOID_TIMESTAMP(mg_id)  ) last_updated_time, 
    synced_at, ingest_time 
  FROM top_silver_layer
