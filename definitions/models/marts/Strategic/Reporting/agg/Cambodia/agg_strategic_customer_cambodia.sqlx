config {
    type: "view",
    description: "PIC: huong.dang",
    tags:['STRATEGIC-REPORTING'],
}

SELECT 
    CURRENT_DATETIME("+7") AS refresh_time,
    dc.eom as date,
    "CAMBODIA" AS location,
    CAST(NULL AS STRING) AS channel,
     CAST(NULL AS STRING) AS supplier_class,
    'CUSTOMER_ACTIVE_ENTERPRISE' AS measure,
    COUNT(distinct IF(active_customer <> 0, customer_id,NULL)) value

FROM lakehouse-prod-394907.gold_buymed_cam.dim_customer_profiling dcp 
LEFT JOIN lakehouse-prod-394907.gold_buymed_cam.dim_calendar dc ON dcp.som = dc.som 
GROUP BY 1,2,3,4,5

UNION ALL 

SELECT 
    CURRENT_DATETIME("+7") AS refresh_time,
    dc.eom as date,
    "CAMBODIA" AS location,
    CAST(NULL AS STRING) AS channel,
    CAST(NULL AS STRING) AS supplier_class,
    'CUSTOMER_NEW_ENTERPRISE' AS measure,
    COUNT(distinct IF(new_customer <> 0, customer_id,NULL)) value

FROM lakehouse-prod-394907.gold_buymed_cam.dim_customer_profiling dcp 
LEFT JOIN lakehouse-prod-394907.gold_buymed_cam.dim_calendar dc ON dcp.som = dc.som 
GROUP BY 1,2,3,4,5

UNION ALL 

SELECT 
    CURRENT_DATETIME("+7") AS refresh_time,
    dc.eom as date,
    "CAMBODIA" AS location,
    CAST(NULL AS STRING) AS channel,
    CAST(NULL AS STRING) AS supplier_class,
    'CUSTOMER_REACQUIRED_ENTERPRISE' AS measure,
    COUNT(distinct IF(reacquire_customer <> 0, customer_id,NULL)) value

FROM lakehouse-prod-394907.gold_buymed_cam.dim_customer_profiling dcp 
LEFT JOIN lakehouse-prod-394907.gold_buymed_cam.dim_calendar dc ON dcp.som = dc.som 
GROUP BY 1,2,3,4,5

UNION ALL 

SELECT 
    CURRENT_DATETIME("+7") AS refresh_time,
    dc.eom as date,
    "CAMBODIA" AS location,
    CAST(NULL AS STRING) AS channel,
    CAST(NULL AS STRING) AS supplier_class,
    'CUSTOMER_REPEAT_ENTERPRISE' AS measure,
    COUNT(distinct IF(repeat_customer <> 0, customer_id,NULL)) value

FROM lakehouse-prod-394907.gold_buymed_cam.dim_customer_profiling dcp 
LEFT JOIN lakehouse-prod-394907.gold_buymed_cam.dim_calendar dc ON dcp.som = dc.som 
GROUP BY 1,2,3,4,5