config {
    type:"table",
    description: `PIC: Huong.Dang; Schedule: 0h00 daily
    Source;
        ${source.ref}.agg_strategic_gmv-before-cancel
        ${source.ref}.agg_strategic_gmv-after-cancel_cancel
        ${source.ref}.agg_strategic_gmv-fulfilled
        ${source.ref}.agg_strategic_gmv-unff
        ${source.ref}.agg_strategic_gmv-return
        ${source.ref}.agg_strategic_gmv-backlog`,
    columns: {
        date: "NonNull |",
        location: "Nullable |",
        channel: "Nullable |",
        measure: "NonNull |",
        value: "Nullable |"
    },
    tags: ("0h00")
}

-- Optimized base calendar with date filtering
WITH base_calendar AS (
  SELECT 
    eom,
    date
  FROM ${ref(`dim_calendar`)}
  WHERE date >= "2023-01-01"),

ois AS ( -- FOR DO
    -- actually, it just exclude 36 order, so if you query raw, don't need this, the error is very small, but in agg_general, dataform take all fact_strategic, so I will include it
    -- I just exclude the orders that is contains all test item
    SELECT 
        order_id,
        STRING_AGG(DISTINCT supplier_class) supplier_class
    FROM ${ref(`fact_strategic_sale_order_item_single`)} ois 
    GROUP BY 1
), 

-- Pre-filter and pre-aggregate order items with partition pruning
filtered_orders AS (
  SELECT 
    fs.order_id,
    fs.created_time,
    fs.confirmation_time, -- for tender
    fs.listed_price,
    fs.commercial_type,
    fs.sales_price,
    fs.demand_quantity,
    fs.order_status,
    fs.sale_order_code,
    fs.outbound_quantity,
    fs.returned_quantity,
    fs.supplier_class,
    doc.order_channel,
    
    CASE
      WHEN dosr.sales_region_code LIKE "MIENNAM" THEN "SOUTHERN"
      WHEN dosr.sales_region_code LIKE "MIENTRUNG" THEN "CENTRAL"
      WHEN dosr.sales_region_code LIKE "MIENBAC" THEN "NORTHERN"
      ELSE "GMV_VN_REGION_UNKNOWN" 
    END AS location
  FROM ${ref(`fact_strategic_sale_order_item_single`)} fs 
  INNER JOIN base_calendar bc ON DATE(fs.created_time) = bc.date
  LEFT JOIN ${ref(`dim_order_channel`)} doc ON doc.order_id = fs.order_id 
  LEFT JOIN ${ref(`dim_order_sales_region`)} dosr ON fs.order_id = dosr.order_id
  WHERE doc.order_channel NOT LIKE "CONSIGNMENT-RECOGNITION"
    AND fs.supplier_class NOT LIKE "TECH"
    AND doc.order_channel IS NOT NULL

),

-- Order metrics
order_metrics AS (
  SELECT
    DATE(created_time) as order_date,
    location,
    CASE
      WHEN order_channel IN ("MARKETPLACE","CONSIGNMENT") THEN "MARKETPLACE"
      ELSE order_channel
    END AS channel,
    -- supplier_class,
    SUM(sales_price * demand_quantity) as gmv_before_cancel,
    SUM(IF(order_status LIKE "CANCEL" AND sale_order_code is null, (sales_price * demand_quantity ),0 )) as cancel_before_ffm,
    SUM(IF(order_status LIKE "CANCEL", (sales_price * demand_quantity), 0)) as cancel,
    SUM(IF(order_status LIKE "CANCEL" AND sale_order_code is not null, (sales_price * demand_quantity ),0 )) as cancel_after_ffm,
    SUM(IF(order_status NOT LIKE "CANCEL",(outbound_quantity - returned_quantity) * sales_price, 0)) as fulfilled_amount,
    SUM(IF(order_status NOT LIKE "CANCEL" , returned_quantity, 0) * sales_price) as returned_amount,
    SUM(IF(order_status NOT LIKE "CANCEL" AND order_status not in ("DELIVERING","DELIVERED","COMPLETED"),  (demand_quantity - outbound_quantity ) ,0 ) * sales_price) as gmv_backlog,
    SUM((listed_price - sales_price) * demand_quantity) as commercial_amount,
    SUM(IF(commercial_type = "DEAL", (listed_price - sales_price) * demand_quantity, 0)) as commercial_deal_amount,
    SUM(IF(commercial_type = "CAMPAIGN", (listed_price - sales_price) * demand_quantity, 0)) as commercial_campaign_amount,
    SUM(IF(commercial_type = "COMBO",(listed_price - sales_price) * demand_quantity, 0)) as commercial_combo_amount,
    SUM(IF(order_status NOT LIKE "CANCEL" AND order_status in ("DELIVERING","DELIVERED","COMPLETED"),(demand_quantity - outbound_quantity ) ,0 ) * sales_price) as gmv_unff,
    SUM(listed_price * demand_quantity) as gmv_with_listed_price,
    SUM(IF(order_status NOT LIKE "CANCEL" , returned_quantity, 0) * sales_price) as gmv_return,
    COUNT(DISTINCT order_id) as so_count,
    SUM(demand_quantity) as item_sold
  FROM filtered_orders
  WHERE order_channel NOT LIKE "TENDER"
  GROUP BY 1, 2, 3

  UNION ALL 
---Group by seller_class
   SELECT
    DATE(created_time) as order_date,
    location,
    CASE -- seller_class
    WHEN supplier_class = "INTERNAL" then "MEDX"
    ELSE "SELLER_CENTER" END AS channel, 
    SUM(sales_price * demand_quantity) as gmv_before_cancel,
    SUM(IF(order_status LIKE "CANCEL" AND sale_order_code is null, (sales_price * demand_quantity ),0 )) as cancel_before_ffm,
    SUM(IF(order_status LIKE "CANCEL", (sales_price * demand_quantity), 0)) as cancel,
    SUM(IF(order_status LIKE "CANCEL" AND sale_order_code is not null, (sales_price * demand_quantity ),0 )) as cancel_after_ffm,
    SUM(IF(order_status NOT LIKE "CANCEL",(outbound_quantity - returned_quantity) * sales_price, 0)) as fulfilled_amount,
    SUM(IF(order_status NOT LIKE "CANCEL" , returned_quantity, 0) * sales_price) as returned_amount,
    SUM(IF(order_status NOT LIKE "CANCEL" AND order_status not in ("DELIVERING","DELIVERED","COMPLETED"),  (demand_quantity - outbound_quantity ) ,0 ) * sales_price) as gmv_backlog,
    SUM((listed_price - sales_price) * demand_quantity) as commercial_amount,
    SUM(IF(commercial_type = "DEAL", (listed_price - sales_price) * demand_quantity, 0)) as commercial_deal_amount,
    SUM(IF(commercial_type = "CAMPAIGN", (listed_price - sales_price) * demand_quantity, 0)) as commercial_campaign_amount,
    SUM(IF(commercial_type = "COMBO",(listed_price - sales_price) * demand_quantity, 0)) as commercial_combo_amount,
    SUM(IF(order_status NOT LIKE "CANCEL" AND order_status in ("DELIVERING","DELIVERED","COMPLETED"),(demand_quantity - outbound_quantity ) ,0 ) * sales_price) as gmv_unff,
    SUM(listed_price * demand_quantity) as gmv_with_listed_price,
    SUM(IF(order_status NOT LIKE "CANCEL" , returned_quantity, 0) * sales_price) as gmv_return,
    COUNT(DISTINCT order_id) as so_count,
    SUM(demand_quantity) as item_sold
  FROM filtered_orders
  WHERE order_channel NOT LIKE "TENDER"
  GROUP BY 1, 2, 3

  UNION ALL

  SELECT 
    DATE(confirmation_time) as order_date,
    location,
    "TENDER" AS channel,
    -- supplier_class,
    SUM(sales_price * demand_quantity) as gmv_before_cancel,
    SUM(IF(order_status LIKE "CANCEL" AND sale_order_code is null, (sales_price * demand_quantity ),0 )) as cancel_before_ffm,
    SUM(IF(order_status LIKE "CANCEL", (sales_price * demand_quantity), 0)) as cancel,
    SUM(IF(order_status LIKE "CANCEL" AND sale_order_code is not null, (sales_price * demand_quantity ),0 )) as cancel_after_ffm,
    SUM(IF(order_status NOT LIKE "CANCEL",(outbound_quantity - returned_quantity) * sales_price, 0)) as fulfilled_amount,
    SUM(IF(order_status NOT LIKE "CANCEL" , returned_quantity, 0) * sales_price) as returned_amount,
    SUM(IF(order_status NOT LIKE "CANCEL" AND order_status not in ("DELIVERING","DELIVERED","COMPLETED"),  (demand_quantity - outbound_quantity ) ,0 ) * sales_price) as gmv_backlog,
    SUM((listed_price - sales_price) * demand_quantity) as commercial_amount,
    SUM(IF(commercial_type = "DEAL", (listed_price - sales_price) * demand_quantity, 0)) as commercial_deal_amount,
    SUM(IF(commercial_type = "CAMPAIGN", (listed_price - sales_price) * demand_quantity, 0)) as commercial_campaign_amount,
    SUM(IF(commercial_type = "COMBO",(listed_price - sales_price) * demand_quantity, 0)) as commercial_combo_amount,
    SUM(IF(order_status NOT LIKE "CANCEL" AND order_status in ("DELIVERING","DELIVERED","COMPLETED"),(demand_quantity - outbound_quantity ) ,0 ) * sales_price) as gmv_unff, 
    SUM(listed_price * demand_quantity) as gmv_with_listed_price,
    SUM(IF(order_status NOT LIKE "CANCEL" , returned_quantity, 0) * sales_price) as gmv_return,
    COUNT(DISTINCT order_id) as so_count,
    SUM(demand_quantity) as item_sold
  FROM filtered_orders
  WHERE order_channel LIKE "TENDER"
  AND order_status NOT LIKE "WAIT_TO_CONFIRM"
  GROUP BY 1, 2, 3

),

-- Delivery metrics
delivery_metrics AS (
  SELECT 
    DATE(do.created_time) as delivery_date,
    CASE
      WHEN dosr.sales_region_code LIKE "MIENNAM" THEN "SOUTHERN"
      WHEN dosr.sales_region_code LIKE "MIENTRUNG" THEN "CENTRAL"
      WHEN dosr.sales_region_code LIKE "MIENBAC" THEN "NORTHERN"
      ELSE "GMV_VN_REGION_UNKNOWN" 
    END AS location,
    CASE
      WHEN doc.order_channel IN ("MARKETPLACE","CONSIGNMENT") THEN "MARKETPLACE"
      ELSE doc.order_channel
    END AS channel,
    -- supplier_class,
    COUNT(DISTINCT do.delivery_order_code) as do_count
  FROM ${ref(`fact_strategic_delivery_order`)} do 
  INNER JOIN base_calendar bc ON DATE(do.created_time) = bc.date
  INNER JOIN ois ON do.order_id = ois.order_id
  LEFT JOIN ${ref(`dim_order_channel`)} doc ON doc.order_id = do.order_id 
  LEFT JOIN ${ref(`dim_order_sales_region`)} dosr ON do.order_id = dosr.order_id 
  WHERE ois.supplier_class NOT LIKE "TECH"
    AND doc.order_channel IS NOT NULL
    AND doc.order_channel NOT IN ("TENDER", "CONSIGNMENT-RECOGNITION")
  GROUP BY 1, 2, 3

  UNION ALL 

  SELECT 
    DATE(do.confirmation_time) as delivery_date,
    CASE
      WHEN dosr.sales_region_code LIKE "MIENNAM" THEN "SOUTHERN"
      WHEN dosr.sales_region_code LIKE "MIENTRUNG" THEN "CENTRAL"
      WHEN dosr.sales_region_code LIKE "MIENBAC" THEN "NORTHERN"
      ELSE "GMV_VN_REGION_UNKNOWN" 
    END AS location,
    CASE
      WHEN doc.order_channel IN ("MARKETPLACE","CONSIGNMENT") THEN "MARKETPLACE"
      ELSE doc.order_channel
    END AS channel,
    -- supplier_class,
    COUNT(DISTINCT do.delivery_order_code) as do_count
  FROM ${ref(`fact_strategic_delivery_order`)} do 
  INNER JOIN base_calendar bc ON DATE(do.confirmation_time) = bc.date
  INNER JOIN ois ON do.order_id = ois.order_id
  LEFT JOIN ${ref(`dim_order_channel`)} doc ON doc.order_id = do.order_id 
  LEFT JOIN ${ref(`dim_order_sales_region`)} dosr ON do.order_id = dosr.order_id 
  WHERE ois.supplier_class NOT LIKE "TECH"
    AND doc.order_channel IS NOT NULL
    AND doc.order_channel LIKE "TENDER"
  GROUP BY 1, 2, 3
)


SELECT 
  CURRENT_DATETIME("+7") AS refresh_time,
  c.eom as date,
  m.location,
  m.channel,
  measure,
--   supplier_class,
  value
  
FROM order_metrics m
CROSS JOIN UNNEST([
  STRUCT("GMV_BEFORE_CANCEL" as measure, gmv_before_cancel as value),
  STRUCT("GMV_AFTER_CANCEL" as measure, (gmv_before_cancel - cancel_before_ffm) as value),
  STRUCT("CANCEL" as measure, cancel as value ),
  STRUCT("CANCEL_AFTER_FFM" as measure, cancel_after_ffm as value),
  STRUCT("CANCEL_BEFORE_FFM" as measure, cancel_before_ffm as value),
  STRUCT("GMV_FULFILLED" as measure, fulfilled_amount as value),
  STRUCT("SO" as measure, so_count as value),
  STRUCT("NMV" as measure, (cancel_after_ffm + fulfilled_amount +  gmv_backlog + returned_amount) as value),
  STRUCT("COMMERCIAL_AMOUNT" as measure, commercial_amount as value),
  STRUCT("COMMERCIAL_DEAL_AMOUNT" as measure, commercial_deal_amount as value),
  STRUCT("COMMERCIAL_CAMPAIGN_AMOUNT" as measure, commercial_campaign_amount as value),
  STRUCT("COMMERCIAL_COMBO_AMOUNT" as measure, commercial_combo_amount as value),
  STRUCT("GMV_UNFF" as measure, gmv_unff as value),
  STRUCT("GMV_WITH_LISTED_PRICE" as measure, gmv_with_listed_price as value),
  STRUCT("ITEM_SOLD" as measure, item_sold as value),
  STRUCT("GMV_BACKLOG" as measure, gmv_backlog as value),
  STRUCT("GMV_RETURN" as measure, gmv_return as value)
]) metrics
JOIN base_calendar c 
  ON DATE(m.order_date) = c.date

UNION ALL

SELECT 
  CURRENT_DATETIME("+7") AS refresh_time,
  c.eom as date,
  d.location,
  d.channel,
  'DO' as measure,
--   d.supplier_class,
  d.do_count as value
FROM delivery_metrics d
JOIN base_calendar c 
  ON DATE(d.delivery_date) = c.date

UNION ALL 

SELECT * 
FROM ${ref(`agg_strategic_customer`)}
WHERE date >= "2023-01-01"


UNION ALL

 -- Inventory cut off by last day of month

SELECT *
FROM ${ref(`agg_inventory_cutoff`)}

