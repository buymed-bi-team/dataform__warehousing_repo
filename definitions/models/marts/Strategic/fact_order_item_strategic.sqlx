config {
    type: "table",
    description: `PIC: minh.luu, schedule: 0h00 daily
    Source
        ${source.ref}.fact_bill`,
    columns: {
        order_id: "NonNull",
        product_id: "Nullable",
        created_time: "NonNull | Timezone in +7",
        outbound_time: "Nullable | from bill | Timezone in +7 ",
        outbound_quantity: "Nullable | Retrieve from accounting system | the quantity of products have be shipped from warehouse",
        price: "Nullable",
        outbound_amount: "Nullable | Retrieve from  accounting system | outbound_quatity * price for each product"
    },
    assertions: {
        nonNull: ('order_id')
    },
    tags: ('0h00'),
    bigquery: {
        partitionBy: "DATE(order_created_time)"
    }
}


WITH o AS ( 
    SELECT 
        order_id,
        status,
        ${utils.ToTimezone(`outbound_date`)} as outbound_time,
        created_time as order_created_time
        
    FROM
        ${source.platinum}.marketplace_prd_order_v2_order
    -- WHERE 
    --     created_date > ${event_checkpoint_date}
)
, oi AS (
    SELECT 
        order_id,
        product_id,
        seller_code,
        -- sku,
        outbound_quantity,
        quantity AS demand_quantity,
        price
    FROM 
        ${source.platinum}.marketplace_prd_order_v2_order_item
    -- WHERE
    --     created_date > ${event_checkpoint_date}
)
, bill as (
    SELECT 
        distinct
        order_id,
        ${utils.ToTimezone(`created_time`)} as bill_created_time,
    FROM
        ${source.platinum}.accounting_prd_core_bill 
)
SELECT
    o.order_id,
    oi.product_id,
    oi.seller_code as supplier_code,
    -- oi.sku,
    o.outbound_time,
    oi.outbound_quantity,
    oi.demand_quantity, 
    oi.price,
    CASE 
        WHEN do.order_channel = "CONSIGNMENT" then 0
        WHEN o.status <> "CANCEL" and o.status <> "CANCELLED" and do.order_channel <> "CONSIGNMENT-RECOGNITION" then demand_quantity * price
        ELSE NULL
    END AS gmv ,
    -- vat
    (oi.outbound_quantity * oi.price ) AS outbound_amount,
    
    bill.bill_created_time,
    o.order_created_time


FROM oi
LEFT JOIN o ON o.order_id = oi.order_id
LEFT JOIN bill ON bill.order_id = oi.order_id
LEFT JOIN ${ref(`dim_order`)} do ON do.order_id = bill.order_id
 

post_operations {
    ALTER TABLE ${self()} 
    ADD FOREIGN KEY (order_id) references ${ref(`dim_order`)}(order_id) NOT ENFORCED,
    ADD FOREIGN KEY (product_id) references ${ref(`dim_product`)}(product_id) NOT ENFORCED;

}