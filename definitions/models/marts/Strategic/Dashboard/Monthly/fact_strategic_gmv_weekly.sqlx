config {
  type: "view",
  dependencies: ["fact_order", "dim_calendar"],
  tags: ["STRATEGIC-DASHBOARDING"]
}

WITH cte_agg as (
SELECT 
  c.year_week
  , sum(gmv) as gmv
FROM gold_buymed_vn2.fact_order as o
LEFT JOIN ${ref("dim_calendar")} as c on DATE(o.created_at) = c.Date
WHERE
  -- TIMESTAMP_TRUNC(created_at, MONTH) = TIMESTAMP("2024-04-01") 
  c.aging_month = 0
GROUP BY 1
)

SELECT
  year_week,
  metric,
  performance
FROM
  cte_agg,
  UNNEST([
    STRUCT('GMV-WEEKLY' AS metric, gmv AS performance)
  ]) AS record