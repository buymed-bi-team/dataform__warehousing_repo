config {
  type: "view",
  tags: ["Stream", "STRATEGIC"]
}

SELECT 
  CAST(FORMAT_DATE('%Y-%m', current_timestamp) AS STRING) AS year_month
  , "SALES" as metric
  , SUM(SAFE_CAST(a.value as INT64)) as target
FROM  ${source.collector}.data_prd AS a
WHERE 
  a.submit_id = (
    SELECT max(submit_id)
    FROM ${source.collector}.data_prd as a
    WHERE
      a.object= 'KPI_Growth'
      AND type = "SALES_OTC"
  )