config {
  type: "view",
  tags: ["STRATEGIC-DASHBOARDING"]
}

WITH cte_agg AS (
SELECT
  SUM(new_customer) AS target
FROM ${ref('dim_customer_profiling')} 
WHERE
    som = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH), MONTH)
)

SELECT 
    CAST(FORMAT_DATE('%Y-%m', current_timestamp) AS STRING) AS year_month
    , "NC" AS metric
    , a.target
FROM cte_agg AS a