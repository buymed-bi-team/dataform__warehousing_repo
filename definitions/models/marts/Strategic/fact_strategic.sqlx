config {
    type: "table",
    description: `PIC: minh.luu, model_type: view, schedule: daily
    Source
        ${source.ref}.agg_strategic_monthly_GMV`,
    columns: {
        source: "NonNull | view name",
        date: "NonNull | ",
        metric_code : "NonNull | ",
        value : "NonNull | "
    },
    tags: ['0h00']
}

js {
    const source_list = [
        'agg_strategic_monthly_GMV',
        'agg_strategic_monthly_GMV_by_SalesRegion',

        // 'agg_strategic_orders',
        // 'agg_strategic_item_sold',

        'agg_strategic_outbound_item',
        'agg_strategic_outbound_orders',
        'agg_strategic_outbound_value',
        // 'agg_strategic_fulfilled_value',
        // 'agg_strategic_unfulfilled_value',
        // 'agg_strategic_return_value',
        // 'agg_strategic_cancel_value'
    ]
}

${
    source_list.map((source,i) =>`
SELECT
    "${source}" as source,
    date, 
    metric_code,
    value
FROM
    ${ref(source)}
WHERE date > "2021-01-01"
${i < source_list.length - 1 ? 'UNION ALL':''}
`
    ).join('')
}

post_operations {
    ALTER TABLE ${self()} 
        ADD FOREIGN KEY (date) references ${ref(`dim_calendar`)}(date) NOT ENFORCED,
        ADD FOREIGN KEY (metric_code) references ${ref(`dim_strategic_metric`)}(metric_code) NOT ENFORCED;
}