config {
    type:"table",
    description: `PIC: Huong.Dang; Schedule: 0h00 daily`,
    tags: ("0h00")
}


WITH base_calendar AS (
  SELECT 
    eom,
    date
  FROM ${ref(`dim_calendar`)}
  WHERE date >= "2023-01-01")

SELECT a.* 
FROM ${ref(`agg_strategic_customer_cambodia`)} as a
INNER JOIN base_calendar c ON DATE(c.date) = a.date