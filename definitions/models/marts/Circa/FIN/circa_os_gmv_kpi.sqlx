config {
    type: "table",
    description: `PIC: Ha.Lekim`,
    tags: ["gold_custom_20m"]
}
WITH
  dim_calendar AS (
  SELECT
    DISTINCT month,
    week,
    date
  FROM  `lakehouse-prod-394907.gold_buymed_vn2.dim_circa_os_gmv_kpi`
  WHERE  channel = 'OFFLINE' ),
  gmv AS (
  SELECT
    pos_code,
    pos_name,
    order_code,
    dim_calendar.date,
    dim_calendar.month,
    dim_calendar.week,
    SUM(gmv - deal - voucher_circa) AS net_sale
  FROM  ${ref("gold_buymed_vn2", "circa_fact_net_margin")} f
  LEFT JOIN  dim_calendar
  ON f.completed_date = dim_calendar.date
  WHERE  completed_date >= "2026-01-01"
    AND channel = 'OFFLINE'
    AND pos_type = 'COS'
    AND ((completed_date < "2026-08-01" AND affiliate_tag <> 'AFFILIATE_FS') 
      OR completed_date >= "2026-08-01")
  GROUP BY ALL),
  return AS (
  SELECT
    pos_code,
    pos_name,
    order_code,
    dim_calendar.date,
    dim_calendar.month,
    dim_calendar.week,
    COALESCE(SUM(return_amount),0) AS return_amount
  FROM ${ref("gold_buymed_vn2", "circa_fact_net_margin")} f
  LEFT JOIN dim_calendar
  ON f.completed_return_date = dim_calendar.date
  WHERE
    completed_return_date >= "2026-01-01"
    AND channel = 'OFFLINE'
    AND pos_type = 'COS'
  GROUP BY ALL ),
  target_by_date AS (
  SELECT
    month,
    week,
    date,
    pos_code,
    pos_name,
    TARGET,
    final_target AS custom_week_target,
  FROM ${ref("gold_buymed_vn2", "dim_circa_os_gmv_kpi")} 
  WHERE channel = 'OFFLINE' )
    -- BY MONTH
    ,
  month_tb AS (
  SELECT
    'MONTH' AS date_type,
    t.month AS start_date,
    t.pos_code,
    t.pos_name,
    TARGET,
    net_sale - COALESCE(return_amount,0) AS net_revenue,
    net_sale,
    return_amount,
  FROM (
    SELECT
      month,
      pos_code,
      pos_name,
      SUM(TARGET) TARGET
    FROM target_by_date
    GROUP BY ALL) t
  LEFT JOIN (
    SELECT
      g.month,
      g.pos_code,
      SUM(net_sale) net_sale,
      SUM(return_amount) return_amount
    FROM gmv g
    LEFT JOIN return r
    ON g.month = r.month
    AND g.pos_code = r.pos_code
    AND g.order_code = r.order_code
    GROUP BY ALL ) f
  ON t.month = f.month
  AND t.pos_code = f.pos_code )
    -- BY WEEK
    ,
  week_tb AS (
  SELECT
    'WEEK' AS date_type,
    t.week AS start_date,
    t.pos_code,
    t.pos_name,
    TARGET,
    net_sale - COALESCE(return_amount,0) AS net_revenue,
    net_sale,
    return_amount,
  FROM (
    SELECT
      week,
      pos_code,
      pos_name,
      SUM(custom_week_target) TARGET
    FROM target_by_date
    GROUP BY ALL) t
  LEFT JOIN (
    SELECT
      g.week,
      g.pos_code,
      SUM(net_sale) net_sale,
      SUM(return_amount) return_amount
    FROM gmv g
    LEFT JOIN return r
    ON g.week = r.week
    AND g.pos_code = r.pos_code
    AND g.order_code = r.order_code
    GROUP BY ALL ) f
  ON t.week = f.week
  AND t.pos_code = f.pos_code ),
  -- by day
  day_tb AS (
  SELECT
    'DAY' AS date_type,
    t.date AS start_date,
    t.pos_code,
    t.pos_name,
    TARGET,
    net_sale - COALESCE(return_amount,0) AS net_revenue,
    net_sale,
    return_amount,
  FROM (
    SELECT
      date,
      pos_code,
      pos_name,
      SUM(TARGET) TARGET
    FROM target_by_date
    GROUP BY ALL) t
  LEFT JOIN (
    SELECT
      g.date,
      g.pos_code,
      SUM(net_sale) net_sale,
      SUM(return_amount) return_amount
    FROM gmv g
    LEFT JOIN return r
    ON g.date = r.date
    AND g.pos_code = r.pos_code
    AND g.order_code = r.order_code
    GROUP BY ALL ) f
  ON t.date = f.date
  AND t.pos_code = f.pos_code )
SELECT * FROM month_tb
UNION ALL
SELECT * FROM week_tb
UNION ALL
SELECT * FROM day_tb

