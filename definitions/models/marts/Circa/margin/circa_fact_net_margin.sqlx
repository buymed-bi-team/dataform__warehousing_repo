config {
    type: "table",
    description: `circa_fact_net_margin
                  PIC: huyen.ngo & ha.lekim; 
                  model_type: Table ;
                  schedule: At minute 30 every hour`,
    tags:  ["gold_custom_20m"],
    name: "circa_fact_net_margin",
    columns: {
    }
    
    ,bigquery: {
        partitionBy: "completed_date"
    }
}

WITH final AS (
    SELECT
      completed_date,
      completed_hour,
      pos_id,
      client_id,
      order_code,
      status,
      channel,
      product_id,
      sum(gmv) gmv,
      sum(cogs_circa) cogs_circa,
      sum(cogs_buymed) cogs_buymed,
      COALESCE(SUM(gmv),0) - COALESCE(SUM(cogs_circa), 0) AS profit_circa,
      COALESCE(SUM(gmv),0) - COALESCE(SUM(cogs_buymed), 0) AS profit_buymed,
      COALESCE(SUM(voucher_discount), 0) + COALESCE(SUM(total_loyalty_discount_amount), 0) + COALESCE(SUM(cogs_mkt_circa), 0) + COALESCE(SUM(deal_1k_amount), 0) + COALESCE(SUM(external_discount_amount), 0) AS voucher_circa,
      COALESCE(SUM(voucher_discount), 0) + COALESCE(SUM(total_loyalty_discount_amount), 0) + COALESCE(SUM(cogs_mkt_buymed), 0) + COALESCE(SUM(deal_1k_amount), 0) + COALESCE(SUM(external_discount_amount), 0) AS voucher_buymed,
      COALESCE(SUM(discount_deal), 0) AS deal,
      COALESCE(SUM(gmv),0) 
        - COALESCE(SUM(cogs_circa), 0) 
        - (COALESCE(SUM(voucher_discount), 0) + COALESCE(SUM(total_loyalty_discount_amount), 0) + COALESCE(SUM(cogs_mkt_circa), 0) + COALESCE(SUM(deal_1k_amount), 0)+ COALESCE(SUM(external_discount_amount), 0)) 
        - COALESCE(SUM(discount_deal), 0) AS net_profit_circa,
      COALESCE(SUM(gmv),0) 
        - COALESCE(SUM(cogs_buymed), 0) 
        - (COALESCE(SUM(voucher_discount), 0) + COALESCE(SUM(total_loyalty_discount_amount), 0) + COALESCE(SUM(cogs_mkt_buymed), 0) + COALESCE(SUM(deal_1k_amount), 0)+ COALESCE(SUM(external_discount_amount), 0)) 
        - COALESCE(SUM(discount_deal), 0) AS net_profit_buymed
    FROM
      ${ref("gold_buymed_vn2", "fact_circa_margin_item")}
    WHERE
      order_code IS NOT NULL
    GROUP BY
      ALL )
  SELECT
    a.completed_date,
    a.completed_hour,
    a.client_id,
    p.code AS pos_code,
    p.name AS pos_name,
  IF
    (p.type = 'FS', 'FS', 'COS') AS pos_type,
    a.order_code,
    a.status,
    a.channel,
    a.product_id,
    a.gmv,
    a.cogs_circa,
    a.cogs_buymed,
    a.profit_circa AS gross_profit_circa,
    a.profit_buymed AS gross_profit_buymed,
    SAFE_DIVIDE(a.profit_circa, a.gmv) AS gross_margin_circa,
    SAFE_DIVIDE(a.profit_buymed, a.gmv) AS gross_margin_buymed,
    a.voucher_circa,
    a.voucher_buymed,
    a.deal,
    a.net_profit_circa,
    a.net_profit_buymed,
    SAFE_DIVIDE(a.net_profit_circa, a.gmv) AS net_margin_circa,
    SAFE_DIVIDE(a.net_profit_buymed, a.gmv) AS net_margin_buymed,
    CONCAT(a.client_id, "_", a.product_id) AS product_id_key,
    CONCAT(a.order_code, CONCAT(a.client_id, "_", a.product_id)) AS order_product_unit_key,
    TIMESTAMP_ADD(CURRENT_TIMESTAMP(), INTERVAL 7 HOUR) AS refresh_at
  FROM
    final AS a
  LEFT JOIN
    ${ref("gold_buymed_vn2", "circa_pos_profile")} AS p ON a.pos_id = p.id
   WHERE a.client_id NOT IN (5,6,7)