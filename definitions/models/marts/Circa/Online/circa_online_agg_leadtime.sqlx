
config {
    type: "table",
    description: `PIC: huyen.ngo; model_type: Table ;schedule: `,
    tags:["custom_1h_past20"],
    name: "circa_online_agg_leadtime"
}

WITH events AS (
  SELECT DISTINCT
      order_code
    , event_name
    , REGEXP_EXTRACT(event_name, r'^([^/]+)') AS ev_code
    , action_time
    , note
  FROM `lakehouse-prod-394907.platinum_buymed_vn.circa_online_prd_order_order_event`
  WHERE created_date >= '2026-07-01'
    AND order_code IS NOT NULL
)
-- POS được assign cuối cùng = POS chốt nhận đơn
, final_pos AS (
  SELECT
      order_code
    , action_time                                                AS t_final_pos_assign
    , SAFE_CAST(SPLIT(event_name, '/')[SAFE_OFFSET(1)] AS INT64) AS final_store_id
    , TRIM(SPLIT(note, ',')[SAFE_OFFSET(0)])                     AS final_store_name
    --, SPLIT(event_name, '/')[SAFE_OFFSET(2)]                     AS final_pos_external_code
  FROM events
  WHERE ev_code = 'CREATE_POS_ORDER'
  QUALIFY ROW_NUMBER() OVER (PARTITION BY order_code ORDER BY action_time DESC) = 1
)
, agg AS (
  SELECT
      order_code
    , MIN(IF(ev_code = 'CREATE_ORDER', action_time, NULL)) AS t_created -- thời gian tạo đơn
      -- Đơn prepaid không có CONFIRM_ORDER -> dùng PROCESS_ORDER (sau RECEIVE_PAYMENT)
    , COALESCE(MIN(IF(ev_code = 'CONFIRM_ORDER', action_time, NULL)),
               MIN(IF(event_name = 'PROCESS_ORDER', action_time, NULL))) AS t_confirm -- thời gian confirm đơn
    , MIN(IF(ev_code = 'CREATE_POS_ORDER', action_time, NULL)) AS t_first_pos_assign -- pos_assign
    , MIN(IF(ev_code = 'OPS_RESET_STORE', action_time, NULL))  AS t_first_reset -- lần reset đầu tiên
    , MIN(IF(ev_code = 'BOOK_3PL', action_time, NULL))         AS t_book -- book deliver
    , MIN(IF(ev_code IN ('3PL_ORDER_DELIVERING', '3PL_ORDER_PICKED'), action_time, NULL)) AS t_pickup -- xế tới pickup 
    , MAX(IF(ev_code IN ('3PL_ORDER_DELIVERED', 'DELIVERED_FROM_DELIVERING', 'DELIVERED_WITH_DELIVERING_EVENT'), action_time, NULL)) AS t_delivered -- deliver thành công
    , MIN(IF(ev_code IN ('OPS_CANCEL_ORDER', 'SYSTEM_CANCEL_ORDER'), action_time, NULL)) AS t_cancel -- hệ thống cancel
    , COUNTIF(ev_code = 'WAIT_FOR_PAYMENT') > 0                    AS is_prepaid -- có repaid ko
    , COUNTIF(ev_code = 'WAIT_TO_CONFIRM') > 0                     AS is_manual_confirm
    , COUNTIF(ev_code = 'CREATE_POS_ORDER')                        AS n_pos_assign
    , COUNTIF(ev_code = 'OPS_RESET_STORE')                         AS n_reset_store
    , COUNTIF(event_name = 'PROCESS_ORDER/WAIT_FOR_PURCHASE') > 0  AS has_wait_for_purchase -- phải đợi mua hàng
    , COUNTIF(ev_code = 'BOOK_3PL_FAILED')                         AS n_book_failed
    , COUNTIF(ev_code = '3PL_ORDER_PICK_FAIL')                     AS n_pick_fail
    , COUNTIF(ev_code = 'CANCEL_SHIPPING_ORDER')                   AS n_cancel_shipping
    , COUNTIF(ev_code = '3PL_ORDER_FAIL_TO_DELIVER')               AS n_fail_to_deliver
    , COUNTIF(ev_code = 'RESET_FAILED_DELIVERY')                   AS n_reset_failed_delivery
  FROM events
  GROUP BY order_code
)
-- High-water mark (NULL-safe): mỗi mốc >= mốc trước để stage không bị âm
, hw1 AS (
  SELECT 
    a.*
  , p.* EXCEPT(order_code)
  , GREATEST(a.t_created, a.t_confirm) AS m1
  FROM agg a
  LEFT JOIN final_pos p USING (order_code)
  WHERE DATE(a.t_created, 'Asia/Ho_Chi_Minh') >= '2026-09-01'
)
    , hw2 AS (SELECT *, GREATEST(COALESCE(m1, t_created), t_final_pos_assign)        AS m2 FROM hw1)
    , hw3 AS (SELECT *, GREATEST(COALESCE(m2, m1, t_created), t_book)                 AS m3 FROM hw2)
    , hw4 AS (SELECT *, GREATEST(COALESCE(m3, m2, m1, t_created), t_pickup)           AS m4 FROM hw3)
    , hw5 AS (SELECT *, GREATEST(COALESCE(m4, m3, m2, m1, t_created), t_delivered)    AS m5 FROM hw4)

SELECT
     order_code
  , DATE(t_created, 'Asia/Ho_Chi_Minh') AS order_created_date
  , final_store_id
  , final_store_name
  , CASE
      WHEN t_cancel IS NULL OR t_delivered IS NOT NULL                        THEN NULL
      WHEN t_pickup IS NOT NULL AND t_cancel >= t_pickup                      THEN 'S5'
      WHEN t_book   IS NOT NULL AND t_cancel >= t_book                        THEN 'S4'
      WHEN t_final_pos_assign IS NOT NULL AND t_cancel >= t_final_pos_assign  THEN 'S3'
      WHEN t_confirm IS NOT NULL AND t_cancel >= t_confirm                    THEN 'S2'
     ELSE 'S1'
    END AS cancel_at_stage
  , is_prepaid
  , is_manual_confirm
  , n_pos_assign
  , n_reset_store
  , (n_reset_store > 0 OR n_pos_assign > 1) AS has_reset
  , has_wait_for_purchase
  , n_book_failed, n_pick_fail
  , n_cancel_shipping
  , n_fail_to_deliver
  , n_reset_failed_delivery
  , DATETIME(t_created,          'Asia/Ho_Chi_Minh') AS t_created
  , DATETIME(t_confirm,          'Asia/Ho_Chi_Minh') AS t_confirm
  , DATETIME(t_first_pos_assign, 'Asia/Ho_Chi_Minh') AS t_first_pos_assign
  , DATETIME(t_first_reset,      'Asia/Ho_Chi_Minh') AS t_first_reset
  , DATETIME(t_final_pos_assign, 'Asia/Ho_Chi_Minh') AS t_final_pos_assign
  , DATETIME(t_book,             'Asia/Ho_Chi_Minh') AS t_book_driver
  , DATETIME(t_pickup,           'Asia/Ho_Chi_Minh') AS t_driver_pickup
  , DATETIME(t_delivered,        'Asia/Ho_Chi_Minh') AS t_delivered
  , DATETIME(t_cancel,           'Asia/Ho_Chi_Minh') AS t_cancel
  -- Stage durations (phút)
  , ROUND(TIMESTAMP_DIFF(m1, t_created, SECOND) / 60, 2)                        AS s1_create_to_confirm_min
  , ROUND(TIMESTAMP_DIFF(m2, m1, SECOND) / 60, 2)                               AS s2_confirm_to_final_pos_min
  , ROUND(TIMESTAMP_DIFF(m3, m2, SECOND) / 60, 2)                               AS s3_final_pos_to_book_min
  , ROUND(TIMESTAMP_DIFF(m4, m3, SECOND) / 60, 2)                               AS s4_book_to_pickup_min
  , ROUND(TIMESTAMP_DIFF(m5, m4, SECOND) / 60, 2)                               AS s5_pickup_to_delivered_min
  , ROUND(TIMESTAMP_DIFF(m5, COALESCE(m3, m2, m1, t_created), SECOND) / 60, 2)  AS s45_book_to_delivered_min
  , ROUND(TIMESTAMP_DIFF(m5, t_created, SECOND) / 60, 2)                        AS e2e_min
FROM hw5
ORDER BY t_created
