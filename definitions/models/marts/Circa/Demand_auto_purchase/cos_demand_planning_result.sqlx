config {
    type: "table",
    description: `Circa OS -- Chi tiết kết quả phiên dự báo mua hàng 
                  PIC: huyen.ngo;
                  model_type: Table;
                  schedule: At 7h00 and 10h30 `,
    tags: ["7h15", "10h30"],
    name: "cos_demand_planning_result",
    columns: {
        
    },bigquery: {
        partitionBy: "date(created_at)"
    }
}

SELECT  TIMESTAMP_ADD(CURRENT_TIMESTAMP(), INTERVAL 7 HOUR) AS transformed_at
        ,i.session_id
        ,DATETIME_ADD(o.created_at, INTERVAL 7 HOUR) AS created_at
        ,o.code
        ,o.status
        ,pos_id
        ,product_id
        ,abc_class
        ,store_mode
        -- chỉ số cửa hàng
        ,total_days --tổng số ngày
        ,DATE(DATETIME_ADD(i.open_date, INTERVAL 7 HOUR)) AS open_date -- ngày mở cửa
        ,DATE(DATETIME_ADD(i.effective_open_date, INTERVAL 7 HOUR)) AS effective_open_date -- ngày có hiệu lực
        ,DATE(DATETIME_ADD(i.last_sale_date, INTERVAL 7 HOUR)) AS last_sale_date -- ngày bán cuối cùng
        -- ,total_quantity AS `tổng số lượng bán`
        -- ,total_orders AS `tổng số đơn`
        -- ,days_with_orders AS `số ngày có bán`
        ,current_stock AS `tồn hiện tại`
        ,safety_stock AS `tồn an toàn`
        ,target_stock AS `tồn mục tiêu`
        ,daily_avg_demand AS `nhu cầu trung bình ngày`
        ,quantity_to_buy AS `số lượng cần mua`
        ,inventory_status AS inventory_status
        ,CASE inventory_status
            WHEN 'DEAD_STOCK' THEN 'Hàng tồn kho chết'
            WHEN 'HEALTHY' THEN 'Đủ hàng'
            WHEN 'NOISE_STOCK' THEN 'Hàng nhiễu'
            WHEN 'NO_SALES_NO_STOCK' THEN 'Không bán không tồn'
            WHEN 'OUT_OF_STOCK' THEN 'Hết hàng'
            WHEN 'OVERSTOCK' THEN 'Tồn cao'
            WHEN 'SLOW_MOVING' THEN 'Luân chuyển chậm'
            WHEN 'X_CLASS_OVERSTOCK' THEN 'Tồn cao (X)'
            ELSE inventory_status
        END AS `trạng thái tồn`
        --,keep_stock AS `tồn giữ lại`
       -- ,available_quantity_for_transfer AS `số lượng có thể chuyển`
        ,purchase_unit -- đơn vị mua
        ,unit_convert_rate
        --,is_hub -- có phải hub ko 
        --,allow_give_transfer -- 
        ,CONCAT(i.product_id, "_", i.client_id) AS product_client_id
 FROM ${source.circa_os}.demand_planning_demand_planning_session o 
 LEFT JOIN ${source.circa_os}.demand_planning_demand_planning_result i ON o.id = i.session_id -- Danh sách nhu cầu
 WHERE DATE(TIMESTAMP_ADD(o.created_at, INTERVAL 7 HOUR))  >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)

--  WHERE o.code = 'DEMAND_SESSION_83'
--  and product_id = 216272
--       and poS_id = 'ef29a397-72d8-40c3-9602-e1cbbc5d1da1'