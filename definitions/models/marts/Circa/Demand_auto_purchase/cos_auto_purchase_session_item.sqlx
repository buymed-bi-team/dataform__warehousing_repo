config {
    type: "table",
    description: `Circa OS auto_purchase_session_item
                  PIC: huyen.ngo;
                  model_type: Table;
                  schedule: At minute 10 every hour`,
    tags: ["custom_1h_past20"],
    name: "cos_auto_purchase_session_item",
    columns: {
        
    }
}

WITH sales_price AS (
           SELECT DISTINCT product_id
                          , unit
                          , sale_price
           FROM ${ref('gold_buymed_vn2','cos_dim_price')}
           WHERE seller_code = 'CIRCA'
)
SELECT DISTINCT TIMESTAMP_ADD(CURRENT_TIMESTAMP(), INTERVAL 7 HOUR) AS transformed_at
      ,session_id
      , DATE(DATETIME_ADD(o.created_at, INTERVAL 7 HOUR)) as created_date
      , i.product_id
      , JSON_VALUE(demand_source, '$[0].type') AS type_rpo -- Nguồn mua hàng (RPO, Online,FORECAST )
      , JSON_VALUE(demand_source, '$[0].codes[0]') AS rpo_code -- Phiếu RPO 
      ,i.pos_id
      ,pos.name as pos_name
      ,i.status AS product_status
      ,failure_reason
      ,CASE
            WHEN failure_reason = 'SEARCH_FAILED'      THEN 'Lỗi tìm kiếm'
            WHEN failure_reason = 'NO_SKU_MATCH'       THEN 'Không khớp SKU'
            WHEN failure_reason = 'NOT_LISTED'         THEN 'Không còn bán'
            WHEN failure_reason = 'EXPIRY_BELOW_FLOOR' THEN 'Hạn dùng dưới sàn'
            WHEN failure_reason = 'ADD_TO_CART_FAILED' THEN 'Lỗi thêm giỏ'
            WHEN failure_reason = 'NOT_PROCESSED'      THEN 'Chưa được xử lý trong phiên'
            WHEN failure_reason = 'PRICE_EXCEEDED'     THEN 'Giá vượt trần'
            WHEN failure_reason = 'EXPIRY_NO_COVER'    THEN 'Không bán kịp trước hạn'
            WHEN failure_reason = 'OUT_OF_STOCK'       THEN 'Hết hàng'
            WHEN failure_reason = 'CHECKOUT_FAILED'    THEN 'Lỗi đặt hàng'
            WHEN failure_reason = 'REPLACED_BY_SUBSTITUTE'    THEN 'Đã mua bằng hàng thay thế'
            WHEN failure_reason = 'NOT_IN_CART'    THEN 'Không có trong giỏ khi đặt'
            WHEN failure_reason = 'PAYMENT_FAILED'    THEN 'Không đủ số dư thanh toán'
            WHEN failure_reason IS NULL                THEN NULL
            ELSE failure_reason
        END AS failure_reason_vn
      ,i.found_unit_price --  giá tìm thấy
      ,i.max_allowed_unit_price -- giá tối đa 
      ,channel
      ,unit_id
      ,i.unit
      ,requested_quantity -- Số lượng yêu cầu
      ,unit_price
      ,actual_quantity -- số lượng thực tế
      ,i.vendor_id
      ,i.vendor_name
      ,buymed_sku
      ,is_price_exceeded
      ,price_compare_type
      ,i.actual_total_amount -- tổng tiền thực tế
      ,actual_unit_price -- giá thực tế
      ,pr.sale_price -- giá bán
      ,i.discount_amount
      ,JSON_VALUE(applied_vouchers, '$[0]') AS applied_voucher
      ,purchase_order_id
      ,p.code AS  po_code
      ,sale_order_number AS so_code
FROM ${source.circa_os}.order_auto_purchase_session_item i 
LEFT JOIN ${source.circa_os}.order_auto_purchase_session o ON i.session_id = o.id 
LEFT JOIN sales_price pr ON i.product_id = pr.product_id AND LOWER(i.unit) = LOWER (pr.unit)
LEFT JOIN ${source.circa_os}.order_purchase_order p ON i.purchase_order_id = p.id AND o.client_id = p.client_id 
LEFT JOIN ${source.ref}.circa_pos_profile pos ON i.pos_id = pos.id 
