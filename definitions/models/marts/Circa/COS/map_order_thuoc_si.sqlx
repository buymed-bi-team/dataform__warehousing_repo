             when p.id is null and (o.customer_name = 'Circa Rainbow' or o.customer_name = 'CIRCA RAINBOW') then '1b294ac9-ab33-46d7-97b8-840441918613'
             when p.id is null and o.customer_name = 'Circa Eco Green' then 'ec523737-4c3f-4296-ae6f-f081544ac4de'
             when p.id is null and o.customer_name = 'Circa Celadon' then '164538d8-6baa-4401-9f8f-9fbb50e8fa96'
             when p.id is null and (o.customer_name = 'Circa Ehome 3'or o.customer_name = 'CIRCA EHOME') then 'efff4c29-2b1f-415b-803e-be26de02acf4'
             when p.id is null and (o.customer_name = 'Circa Nam Việt' or o.customer_name = 'CIRCA NAM VIET') then '674741b7-ad96-4aa1-bc19-54bbc2f9031f'
