             when p.id is null and o.customer_name = 'CIRCA CITYLAND' then '55388c70-30fe-4c80-b119-92b24a1aa1bf'
             when p.id is null and o.customer_name = 'CIRCA BEVERLY' then 'f2b46d1a-d5c9-45b8-8e90-4390babd87cb'
             when p.id is null and o.customer_name = 'CIRCA TAM AN' then '94c6f221-5015-47da-b1ea-887fa75ccc3a'
             when p.id is null and o.customer_name = 'KHO TỔNG HUB LÝ THƯỜNG KIỆT' then '9dd83081-9919-4bc3-84bd-f5dfece10049'
             when p.id is null and o.customer_name = 'CIRCA BELVITA' then '98f26020-1df8-4bc7-bdec-b958823447cf'
             when p.id is null and o.customer_id = 407640 and o.customer_name = 'Chị Tình - Circa Mira' then '9b37d4ec-b0ea-4e1a-9c6d-292c8e450b25'
             when p.id is null and o.customer_id = 407640 and o.customer_name = 'Chị Nhi - Tâm An - Store Manager' then '94c6f221-5015-47da-b1ea-887fa75ccc3a'
             when p.id is null and o.customer_id = 407640 and o.customer_name = 'Chị An - Cityland - Store Manager' then '55388c70-30fe-4c80-b119-92b24a1aa1bf'
             when p.id is null and o.customer_id = 407640 and o.customer_name = 'Chị Dung - Medora - Store Manager' then '73dcf891-f4a1-42c5-bea4-115412f1018d'
             when p.id is null and o.customer_id = 407640 and o.customer_name = 'Chị Dung - Tâm Việt - Store Manager' then '265ed9b9-1e48-4390-8321-42c95529072e'
             when p.id is null and o.customer_id = 407640 and o.customer_name = 'Chị Ngân - Symphony - Store Manager' then 'faeb1575-3ba0-4684-9ea9-621d6c3fc606'
             when p.id is null and o.customer_id = 407640 and o.customer_name = 'Chị Lệ - Medly - Store Manager' then 'bd0a5c91-c25f-4d49-92b4-7fe5ea174a5f'
             when p.id is null and o.customer_id = 407640 and o.customer_name = 'Chị Minh - La Astoria - Store Manager' then '61437f95-55ba-44b6-a994-99f2d9209c79'
             when p.id is null and o.customer_id = 409603 and o.customer_name = 'Chị Ngân - Symphony - Store Manager' then 'faeb1575-3ba0-4684-9ea9-621d6c3fc606'
             when p.id is null and o.customer_id = 409603 and o.customer_name = 'Chị Lệ - Medly - Store Manager' then 'bd0a5c91-c25f-4d49-92b4-7fe5ea174a5f'
             when SPLIT(o.note,'-')[OFFSET(0)] = 'POS0018' then 'a3e26e59-5a08-4beb-ae01-5e23a34bab74'
             else ''
            end as pos_id
       ,SPLIT(o.note,'-')[OFFSET(0)] AS pos_code
       ,o.customer_name
       ,customer_id
       ,o.tags as order_tag
       ,date(o.created_at) as created_date
       ,o.order_status 
       ,order_type
       ,o.so_code
       ,o.so_status
       ,o.gmv
       ,actual_sales_amount
       ,invoice_amount
       --,po.po_code
       --,po.po_status
from ${source.ref}.fact_order o
left join ${source.ref}.dim_customer c using (customer_id)
left join lakehouse-prod-394907.gold_buymed_vn2.os_map_idthuocsi map on o.customer_id = map.id_thuocisi
left join lakehouse-prod-394907.gold_buymed_vn2.circa_pos_profile p on map.pos_code = p.code
--left join ${source.ref}.cos_purchase_order po on SAFE_CAST(o.order_id as string) = po.order_id
where (REGEXP_CONTAINS(TO_JSON_STRING(customer_tags), r'\"CIRCACOS\"')  OR REGEXP_CONTAINS(TO_JSON_STRING(customer_tags), r'\"CIRCA_FS\"'))
       and date(o.created_at)>"2024-10-01"
       and o.order_status <> 'CANCEL'
       -- and customer_id <> 352665 -- Tech-Trúc Trần
       -- and customer_id <> 409603 -- Circa Marketing Hà Nội
       -- and customer_id <> 407640 -- Circa Marketing
       -- and customer_id <> 409156 -- Nhà thuốc Circa Admin
       -- --408981: master HN 
       -- --392301: master HCM