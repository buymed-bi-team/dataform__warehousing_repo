
config {
    type: "table",
    description: `PIC: huyen.ngo; model_type: Table ;schedule: At 10h30`
    /*Source:
      ${source.silver}.marketplace_prd_order_v2_order_item
      ${source.silver}.marketplace_prd_order_v2_order ,custom_2h_past5*/,
    name: "cos_sku_oos_sup",
    columns: {/*
        order_id: "NonNull |" + docs.order_id,
        customer_id: "NonNull | The unique identifier for each customer"*/
        
    }
}
 
with sum_qty_current as (
  select distinct
    product_id
    ,pos_id
    ,sum(on_hand_quantity) as total_quantity
  from `${source.ref}.cos_fact_inventory`
  group by all
  having total_quantity = 0
), zero_inventory_dates as (
  select distinct 
     a.product_id
    ,pos_id
    ,a.cutoff_date_index 
    ,sum(on_hand_qty) as total_qty
  from ${source.circa_os}.inventory_location_detail_historical_cut_off a
  left join ${source.circa_os}.inventory_location as b on a.location_id = b.id
  where a.product_id in (select distinct product_id from sum_qty_current)
        and b.pos_id in (select distinct pos_id from sum_qty_current)
        and a.client_id = 1 
        and b.client_id = 1
  group by all
), ranked_zero_dates as (
  select *
        ,row_number() over (partition by product_id, pos_id order by cutoff_date_index) as rn
  from zero_inventory_dates
  where total_qty = 0
)
, zero_and_stable_inventory as (
  select z.product_id
        ,z.pos_id
        ,z.cutoff_date_index as zero_start_date
  from ranked_zero_dates z
  where z.rn = 1
    and not exists (
      select 1
      from zero_inventory_dates z2
      where z2.product_id = z.product_id
        and z2.pos_id = z.pos_id
        and z2.cutoff_date_index > z.cutoff_date_index
        and z2.total_qty > 0
    )
)
select distinct
  a.product_id
  ,a.pos_id
  ,min(zero_start_date) as last_zero_date
  ,st.sku_status_by_pos
  ,date_diff(current_date(), min(zero_start_date), day) as days_since_zero
from zero_and_stable_inventory a
left join ${source.ref}.cos_sku_status st on a.product_id = st.product_id and  a.pos_id = st.pos_id
where st.sku_status_by_pos ='OOS'
group by all
union all
Select distinct 
 s.product_id
 ,pos_id
 ,DATE(th.created_time)
 ,s.sku_status_by_pos
,date_diff(current_date(), date(th.created_time), day) as days_since_zero
from ${source.ref}.cos_sku_status s
left join (Select distinct product_id,created_time
                        , row_number() over (partition by product_id order by created_time desc) as rn
                          from ${source.ref}.adhoc_pm_master_sku p
                         left join ${source.ref}.staging_sku_status_history t on p.sku_code = t.sku) th on s.product_id = th.product_id
where s.sku_status_by_pos not in (Select distinct sku_status_by_pos from ${source.ref}.cos_sku_status  where sku_status_by_pos = 'OOS' or sku_status_by_pos = 'NORMAL'   )
and created_time >= '2024-05-01'
and rn = 1


