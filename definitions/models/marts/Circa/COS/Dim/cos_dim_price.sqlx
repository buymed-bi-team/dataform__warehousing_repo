config {
    type: "table",
    description: `Tracking price for Circa OS
             PIC: huyen.ngo; model_type: Table ;schedule: At minute 15 past hour`,
    tags: ["custom_1h_past15"],
    name: "cos_dim_price",
}
-- Lấy full unit 
WITH product_base_unit AS (
    SELECT DISTINCT o.product_id
                   ,o.unit AS convert_unit
                   ,o.base_unit
                   ,o.convert_rate
                   ,o.sale_allowed
                   ,o.status
    FROM buymed_circa_v2.product_master_retail_unit o 
    --WHERE status = 'ACTIVE'

)
-- performance
,count_ord AS (
    SELECT DISTINCT oi.product_id
                   ,oi.seller_code
                   ,MAX(o.created_date) AS latest_ord
                   ,COUNT(DISTINCT o.order_id) AS no_ord
                   ,SUM(quantity * unit_price_before_discount) AS GMV
                   ,COUNT(CASE WHEN o.created_date >= CURRENT_DATE() - INTERVAL 1 MONTH THEN  o.order_id END) AS no_ord_L1M
                   ,SUM(CASE WHEN o.created_date >= CURRENT_DATE() - INTERVAL 1 MONTH THEN quantity * unit_price_before_discount END ) AS  GMV_L1M
    FROM gold_buymed_vn2.cos_fact_order o
    LEFT JOIN gold_buymed_vn2.cos_fact_order_item oi ON o.order_id = oi.order_id
    WHERE status LIKE "%COMPLETE%"
         AND o.client_id = 1 
    GROUP BY ALL
)
-- tồn kho
,inventory AS (
    SELECT DISTINCT a.product_id
                   ,SUM(a.on_hand_quantity) AS on_hand_quantity
                   ,seller_code
                   ,sku_code
    FROM gold_buymed_vn2.cos_fact_inventory a
    LEFT JOIN gold_buymed_vn2.circa_pos_profile p ON a.pos_id = p.id
    WHERE a.client_id = 1
          AND p.actual_status <> "Inactive"
    GROUP BY ALL
)
