config {
    type: "table",
    description: `PIC: huyen.ngo; 
                  model_type: Table ;
                  schedule: At minute 10 every hour.Circa OS Transaction order`,
    tags: ["custom_1h_past10"],
    name: "cos_fact_order",
    columns: {
        order_id: "NonNull |" + docs.order_id
       
    },
    bigquery: {
        partitionBy: "date(created_at)"
    }
}

WITH base_data AS (
SELECT DISTINCT
     o.id AS order_id
    ,o.pos_id
    ,p.code as pos_code
    ,o.entity_id
    ,o.code AS order_code
    ,o.total_amount
    --,actual_total_item_amount
    ,o.total_item_amount
    ,SUM(COALESCE(loyalty_discount_amount,0 ) + COALESCE (o.discount_amount, 0)) AS discount_amount
    ,o.created_by
    ,o.updated_by
    ,en.name
    ,o.status
    ,o.note
    ,o.type
    ,o.source_type
    ,delivery_type
    ,channel
    ,DATE(DATETIME_ADD(o.created_at, INTERVAL 7 HOUR)) AS created_date
    ,DATETIME_ADD(o.created_at, INTERVAL 7 HOUR) AS created_at
    ,fulfillment_status
    ,reference_order_in_platform
    ,o.origin_order_id
    ,DATETIME_ADD(o.end_pick_at, INTERVAL 7 HOUR) AS end_pick_at
    ,COALESCE(
         DATETIME_ADD(o.completed_at, INTERVAL 7 HOUR)
        ,DATETIME_ADD(o.updated_at, INTERVAL 7 HOUR)
     ) AS completed_at
    ,COALESCE(
         DATE(DATETIME_ADD(o.completed_at, INTERVAL 7 HOUR))
        ,DATE(DATETIME_ADD(o.updated_at, INTERVAL 7 HOUR))
     ) AS completed_date
    ,DATETIME_ADD(delivery_scheduled_time, INTERVAL 7 HOUR) AS delivery_scheduled_time
    ,DATETIME_ADD(pre_order_scheduled_time, INTERVAL 7 HOUR) AS pre_order_scheduled_time
    ,CAST(pre_order_required AS STRING) AS pre_order_required
    ,o.medicine_cutting_fee
    ,STRING_AGG(rt.return_codes, ',') AS return_codes
    ,CASE
        WHEN rt.return_codes IS NULL THEN 'NORMAL'
        ELSE 'RETURN'
     END AS order_type
     ,g.gift_id
     ,gift_item_type
     ,gift_code
     ,o.delivery_amount
    ,o.client_id
    ,o.payment_method
FROM ${source.circa_os}.order_order o
LEFT JOIN ${source.ref}.cos_return_completed rt ON o.code = rt.order_code
LEFT JOIN ${source.ref}.circa_pos_profile p ON o.pos_id = p.id AND o.client_id = p.client_id
LEFT JOIN (SELECT * FROM ${source.circa_os}.order_order_gift
      QUALIFY ROW_NUMBER() OVER (PARTITION BY order_code, gift_id,gift_code, pos_id ORDER BY created_at DESC) = 1) g ON o.code = g.order_code
LEFT JOIN ${source.circa_os}.entity_entity en ON o.created_by = en.id AND o.client_id = en.client_id 
WHERE o.type <> 'RETURN'
  AND o.status <> 'PENDING'
  AND p.id IS NOT NULL
GROUP BY ALL
), map_inf AS (
SELECT  TIMESTAMP_ADD(CURRENT_TIMESTAMP(), INTERVAL 7 HOUR) AS transformed_at
       ,o.* except (created_date, payment_method, created_at)
       ,CASE WHEN o.type = 'ONLINE' THEN i.created_date
             ELSE o.created_date END AS created_date
       ,CASE WHEN o.type = 'ONLINE' THEN i.created_time
             ELSE o.created_at END AS created_at
       ,i.receiver_name
       ,i.receiver_full_address
       ,i.district_name
       ,i.province_name
       ,CASE
           WHEN o.order_type = 'RETURN' then 'True'
           ELSE 'False' END AS is_returned
       ,CASE WHEN o.channel = 'O2O' THEN i.customer_phone ELSE e.phone_number END AS customer_phone
       ,CASE WHEN o.channel = 'O2O' THEN i.customer_name ELSE e.name END AS customer_name
       ,CASE WHEN o.channel = 'O2O' THEN i.payment_method 
                ELSE o.payment_method END AS first_payment_method
        ,CASE WHEN o.channel = 'O2O' AND is_split_payment = 'true' THEN i.secondary_pay_method 
              ELSE NULL END AS secondary_pay_method
        ,CASE WHEN o.channel = 'O2O' AND is_split_payment = 'true' THEN i.secondary_pay_amount 
        ELSE NULL END AS secondary_pay_amount
       ,e.title
       ,concat(o.pos_code, "_", FORMAT_DATE('%Y-%m', o.completed_date)) as target_id
       ,concat(FORMAT_DATE('%Y-%m', coalesce(o.completed_date,o.created_date)), "_", o.pos_code,"_", n.email) as  ym_emp_pos
       ,concat(FORMAT_DATE('%Y-%m', coalesce(o.completed_date,o.created_date)), "_", n.email) as  ym_emp
       ,concat(o.pos_code,"_", o.updated_by) as emp_pos_id  
       ,concat(o.updated_by,"_", o.client_id) as updated_by_client_id
FROM base_data o
LEFT JOIN ${source.ref}.circa_online_order i ON o.reference_order_in_platform = i.order_code
LEFT JOIN ${source.circa_os}.entity_customer e ON o.entity_id = e.id 
LEFT JOIN ${source.circa_os}.entity_entity n ON o.updated_by = n.id AND o.client_id = n.client_id
), clean_phone AS (
SELECT
   DISTINCT order_code
  ,CASE
    WHEN last_number IS NULL THEN NULL
    WHEN STARTS_WITH(last_number, '84') THEN CONCAT('0', SUBSTR(last_number, 3))
    WHEN LENGTH(last_number) = 9 THEN CONCAT('0', last_number)
    WHEN LENGTH(last_number) = 10 AND STARTS_WITH(last_number, '0') THEN last_number
    ELSE last_number
  END AS customer_phone_cleaned
FROM (
  SELECT DISTINCT order_code
    ,ARRAY_REVERSE(REGEXP_EXTRACT_ALL(customer_phone, r'[0-9]{6,11}'))[SAFE_OFFSET(0)] AS last_number
  FROM map_inf
  WHERE
  -- client_id = 1
    --AND status IN ('COMPLETED', 'COPMPLETE_SHIPPING')
    customer_phone IS NOT NULL
    AND customer_phone <> ""
    AND REGEXP_REPLACE(customer_phone, '0','') <> ""
) t
)

SELECT a.*
       ,b.customer_phone_cleaned
        ,CASE
             WHEN customer_phone_cleaned IS NULL THEN TRUE
             WHEN status NOT IN ('COMPLETED', 'COMPLETE_SHIPPING') THEN FALSE
             WHEN COUNTIF(status IN ('COMPLETED', 'COMPLETE_SHIPPING')) OVER (
                 PARTITION BY customer_phone_cleaned
                 ORDER BY created_at
             ) = 1 THEN TRUE
             ELSE FALSE
             END AS is_first_order
        ,CASE
             WHEN customer_phone_cleaned IS NULL THEN TRUE
             WHEN status NOT IN ('COMPLETED', 'COMPLETE_SHIPPING') THEN FALSE
             WHEN COUNTIF(status IN ('COMPLETED', 'COMPLETE_SHIPPING')) OVER (
                 PARTITION BY customer_phone_cleaned
                 ORDER BY created_at, a.order_code, type
             ) = 1 THEN TRUE
             ELSE FALSE
         END AS is_first_channel_order
        ,CASE
             WHEN customer_phone_cleaned IS NULL THEN TRUE
             WHEN status NOT IN ('COMPLETED', 'COMPLETE_SHIPPING') THEN FALSE
             WHEN COUNTIF(status IN ('COMPLETED', 'COMPLETE_SHIPPING')) OVER (
                 PARTITION BY customer_phone_cleaned
                 ORDER BY created_at, a.order_code, pos_id
             ) = 1 THEN TRUE
             ELSE FALSE
          END AS is_first_pos_order
FROM map_inf a
LEFT JOIN clean_phone b ON a.order_code = b.order_code 



-- where status in ('COMPLETED', 'COMPLETED_SHIPPING')
--       and client_id <> 1
--gmv = Giá bán * sản phẩm + bất kì phí nào khác (hiện tại có phí cắt liều) - những đơn return hoặc return 1 phần  = total_item_amount + medicine_cutting_fee - return