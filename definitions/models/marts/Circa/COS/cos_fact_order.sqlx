config {
    type: "table",
    description: `Last 13 month| PIC: tu.dang; model_type: Table ;schedule: At minute 5 past hour 6, 8, 10, 12, 14, 16, 18, 20 and 22`
    /*Source:
      ${source.silver}.marketplace_prd_order_v2_order_item
      ${source.silver}.marketplace_prd_order_v2_order ,custom_2h_past5*/,
    tags: ["custom_2h_past5"],
    name: "cos_fact_order",
    columns: {
        order_id: "NonNull |" + docs.order_id,
        customer_id: "NonNull | The unique identifier for each customer"
        
    },
    bigquery: {
        partitionBy: "date(created_at)"
    }
}



select id as order_id,
       pos_id,
       entity_id,
       code as order_code,
       status,
       note, type,
       source_type, 
       delivery_type, 
       channel,
       date(DATETIME_ADD(created_at, INTERVAL 7 HOUR)) as created_date,
       DATETIME_ADD(created_at, INTERVAL 7 HOUR) as created_at,
       fulfillment_status,
       date(DATETIME_ADD(completed_at, INTERVAL 7 HOUR))  as completed_date,medicine_cutting_fee
       
from ${source.circa_os}.order_order