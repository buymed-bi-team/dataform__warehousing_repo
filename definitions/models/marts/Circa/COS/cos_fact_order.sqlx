config {
    type: "table",
    description: `Last 13 month| PIC: huyen.nguyenthu; model_type: Table ;schedule: At minute 5 every hour`
    /*Source:
      ${source.silver}.marketplace_prd_order_v2_order_item
      ${source.silver}.marketplace_prd_order_v2_order ,custom_2h_past5*/,
    tags: ["custom_1h_past5"],
    name: "cos_fact_order",
    columns: {
        order_id: "NonNull |" + docs.order_id,
        customer_id: "NonNull | The unique identifier for each customer"
        
    },
    bigquery: {
        partitionBy: "date(created_at)"
    }
}

with return_cancel as (
    select o.code
    from ${source.circa}.order_order o
    left join ${source.circa}.entity_pos_profile p on o.pos_id = p.id
    where pos_id in ("b6c40920-af79-4fb0-bdc4-9965ddb885d2", "e737c882-e90c-4fd2-8a4f-ac6afd248a33")
    AND o.type = 'RETURN' and o.status = 'CANCELED'

    union all

    select c.code
    from ${source.circa_os}.order_order c
    left join ${source.circa_os}.entity_pos_profile p on c.pos_id = p.id
    where c.type = 'RETURN' and c.status = 'CANCELED'
),

cte_fs as
    (select o.id as order_id,
       pos_id, p.code as pos_code,
       entity_id,
       o.code as order_code,
       o.total_amount,
       o.total_item_amount,       
       o.created_by,
       en.name,
       o.status,
       o.note, o.type,
       o.source_type,
       delivery_type,
       channel,
       date(DATETIME_ADD(o.created_at, INTERVAL 7 HOUR)) as created_date,
       DATETIME_ADD(o.created_at, INTERVAL 7 HOUR) as created_at,
       fulfillment_status,
       date(DATETIME_ADD(completed_at, INTERVAL 7 HOUR))  as completed_date,
       medicine_cutting_fee,
       STRING_AGG(CAST(return_id as string)) as return_codes
from ${source.circa}.order_order o
left join UNNEST(JSON_VALUE_ARRAY(order_return_codes)) AS return_id
left join ${source.circa}.entity_pos_profile p on o.pos_id = p.id
left join ${source.circa}.entity_entity en on o.updated_by = en.id
where pos_id in ("b6c40920-af79-4fb0-bdc4-9965ddb885d2", "e737c882-e90c-4fd2-8a4f-ac6afd248a33")
    AND o.type <> 'RETURN'
group by all),

cte_os as
    (select o.id as order_id,
       pos_id, p.code as pos_code,
       entity_id,
       o.code as order_code,
       o.total_amount,
       o.total_item_amount,
       o.created_by,
       en.name,
       o.status,
       o.note, o.type,
       o.source_type,
       delivery_type,
       channel,
       date(DATETIME_ADD(o.created_at, INTERVAL 7 HOUR)) as created_date,
       DATETIME_ADD(o.created_at, INTERVAL 7 HOUR) as created_at,
       fulfillment_status,
       date(DATETIME_ADD(completed_at, INTERVAL 7 HOUR))  as completed_date,
       medicine_cutting_fee,
       STRING_AGG(CAST(return_id as string)) as return_codes
from ${source.circa_os}.order_order o
left join UNNEST(JSON_VALUE_ARRAY(order_return_codes)) AS return_id
left join ${source.circa_os}.entity_pos_profile p on o.pos_id = p.id
left join ${source.circa_os}.entity_entity en on o.updated_by = en.id
where o.type <> 'RETURN'
group by all)

select
    *
    , CASE
        WHEN return_codes IS NULL OR return_codes in (select * from return_cancel) THEN "NORMAL"
        ELSE "RETURN"
    END AS order_type
from cte_fs

union all

select
    *
    , CASE
        WHEN return_codes IS NULL OR return_codes in (select * from return_cancel) THEN "NORMAL"
        ELSE "RETURN"
    END AS order_type
from cte_os