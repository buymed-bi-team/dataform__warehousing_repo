config {
    type: "table",
    //disabled: true,
    description: `Last 13 month| PIC: huyen.nguyenthu; model_type: Table ;schedule: At minute 5 past hour 6, 8, 10, 12, 14, 16, 18, 20 and 22`,
    tags: ["custom_2h_past5"],
    name: "circa_pos_profile"
}

select p.*
       ,s.* except (status)
       ,case when p.code = 'POS0010' then 'Active'
       else s.status end as actual_status
from ${source.circa_os}.entity_pos_profile p 
left join ( Select * from  ${source.external}.circa_store_status where store_format like '%Circa%') s on p.code = s.pos_code
where type in ('CIRCA', 'FS')
    and code not in ('POS0006','POS0024','POS0030','POS0001','POS0047','POS0020','POS0020')
   