config {
    type: "table",
    description: `PIC: huyen.ngo; model_type: Table ;schedule: At minute 15 past hour`,
    tags: ["custom_2h_past15"],
    name: "cos_product_loss_by_order",
    columns: {
        
    },
    bigquery: {
        partitionBy: "date(created_at)"
    }
}

WITH t AS  (
SELECT DISTINCT 
       p.name AS pos_name
       , o.pos_id
       , DATE(DATETIME_ADD(o.created_at, INTERVAL 7 HOUR))                        AS created_date
       , DATETIME_ADD(o.created_at, INTERVAL 7 HOUR)                               AS created_at
     --  , DATE(DATETIME_ADD(o.date_time, INTERVAL 7 HOUR)  )                      AS date_time
       , DATETIME_ADD(o.finish_date, INTERVAL 7 HOUR)                              AS finish_date
       , o.id 
       , o.unit 
       , o.unit_id 
       , o.product_id 
       , CASE  
             WHEN o.product_name IS NULL OR o.product_name = ''  
             THEN td.product_name  
             ELSE o.product_name  
         END                                                                      AS product_name
       , thuocsi_product_status 
       , td.thuocsi_has_stock 
       , td.thuocsi_unit 
       , td.thuocsi_quantity  
       , CASE  
             WHEN td.product_category IS NULL  
             THEN 'Khác'  
             ELSE td.product_category  
         END                                                                      AS product_category
       , o.unit_price 
       , SUM(unfulfilled_quantity) AS quantity 
       , SUM(o.unit_price * o.quantity) AS total_amount 
       , o.client_id 
       ,CASE  
            WHEN ls.product_id IS NOT NULL  
            THEN TRUE 
            ELSE FALSE 
        END                                                                       AS is_essential
        ,td.on_hand_quantity
       ,CONCAT(o.product_id, "_", o.client_id)                                    AS product_client_id
      , o.order_id
      , i.code AS order_code
      , o.status AS demand_status
      , i.status AS order_status
FROM ${source.circa_os}.order_order_item_demand  o
LEFT JOIN ${source.ref}.circa_pos_profile p ON o.pos_id = p.id 
LEFT JOIN ${source.ref}.cos_dim_product td ON o.product_id = td.product_id AND o.client_id = td.client_id
LEFT JOIN (SELECT DISTINCT product_id from ${source.ref}.cos_product_essential WHERE status = 'ACTIVE') ls ON o.product_id = ls.product_id 
LEFT JOIN ${source.circa_os}.order_order i ON o.order_id = i.id AND o.client_id = i.client_id
WHERE p.id IS NOT NULL
      AND o.client_id NOT IN (5,6,7)
      AND unfulfilled_quantity > 0 
GROUP BY ALL
), base_data_competitor AS (
    SELECT
          SAFE_CAST(JSON_EXTRACT_SCALAR(a.extra_props.product_id) AS INT64) AS product_id
        , JSON_EXTRACT_SCALAR(a.extra_props.unit) AS unit
        , JSON_EXTRACT_SCALAR(a.extra_props.source) AS comp_name
        , SAFE_CAST(JSON_EXTRACT_SCALAR(a.extra_props.conversion_rate) AS FLOAT64)
            * SAFE_CAST(JSON_EXTRACT_SCALAR(a.extra_props.market_price) AS INT64) AS comp_price
        , a.created_date
        , a.last_updated_time
    FROM `platinum_buymed_vn.marketplace_prd_product_v2_product_market_price` a
    WHERE 1 = 1
        AND JSON_EXTRACT_SCALAR(a.extra_props.source) IN ('LongChau', 'Pharmacity')
        AND JSON_EXTRACT_SCALAR(a.extra_props.product_id) IS NOT NULL
        AND JSON_EXTRACT_SCALAR(a.extra_props.qc) IN ('QC', 'QC done')
        AND LOWER(JSON_EXTRACT_SCALAR(a.extra_props.market_name)) NOT LIKE '%[ngưng bán]%'
        AND LOWER(JSON_EXTRACT_SCALAR(a.extra_props.market_name)) NOT LIKE '%[chờ hàng]%'
        AND DATE(a.last_updated_time + INTERVAL 7 HOUR)
            >= CURRENT_DATE('Asia/Ho_Chi_Minh') - 3
        AND SAFE_CAST(JSON_EXTRACT_SCALAR(a.extra_props.conversion_rate) AS FLOAT64)
            * SAFE_CAST(JSON_EXTRACT_SCALAR(a.extra_props.market_price) AS INT64) >= 1000
)
, market AS (
    SELECT
          a.product_id
        , a.comp_name
        , a.comp_price
    FROM base_data_competitor a
    LEFT JOIN `platinum_buymed_vn.marketplace_prd_product_v2_product` b
        ON a.product_id = b.product_id
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY a.product_id, a.comp_name
        ORDER BY a.last_updated_time DESC
    ) = 1
), competitor AS (
SELECT
      product_id
    , MIN(a.comp_price) AS min_comp
    , COUNT(comp_name) AS no_competitor
    , STRING_AGG(comp_name, ', ') AS competitors
FROM market a
-- WHERE product_id = 1110
GROUP BY ALL
)
SELECT t.* except (total_amount, unit_price)
       ,t.total_amount AS origin_amount
       ,p.final_sale_price
       ,CASE WHEN p.product_id IS NOT NULL AND final_sale_price > 0 THEN final_sale_price
             ELSE unit_price END AS price
       ,CASE WHEN p.product_id IS NOT NULL AND final_sale_price > 0 THEN quantity * final_sale_price
             ELSE t.total_amount END AS total_amount
      , min_comp
      , c.no_competitor
      , c.competitors
FROM t
LEFT JOIN (Select * from  ${source.ref}.cos_adhoc_pos_product_client WHERE seller_code = 'CIRCA') p  ON t.product_id = p.product_id AND lower(t.unit) = lower(p.unit)
LEFT JOIN competitor c ON t.product_id = c.product_id

