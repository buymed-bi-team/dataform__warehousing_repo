}

Select   
   trial_period
  --,case when dat_time is not null then cast(dat_time as date) else null end as date_time
  ,dat_time as date_time
  ,case when product_id is not null and product_id <> 'New' then cast(product_id as int64)  else null end as product_id
  ,concat(product_id,'_',1) as product_client_id
  ,product_name 
  from buymed_external.purchase_top_trending
  where product_id is not null and  product_id <> 'New'
