config {
    type: "table", 
    description: 
        `PIC: huyen.ngo; 
        Current inventory
        Type: Table; 
        Refresh Schedule: At minute 10 past hour 7, 10, 13, 16 and 19;
        Source: 
        `,
    tags: ["adhoc-office"],
    columns: {
    }}
with inventory as (
    Select distinct
        a.product_id
        ,a.sku_code
        ,a.lot_date
        ,case
            when tax_rate <= 0 then 0 else tax_rate
        end as tax_rate
        ,a.on_hand_qty AS on_hand_quantity
        ,a.location_id
        ,doc_code,a.cost_price_include_tax
        ,product_id || "_" || lot_date as product_lot_date
        ,product_id || "_" || lot_date || "_" || tax_rate || "_" || a.client_id as product_lot_date_vat_client_id
        ,a.client_id
        ,pos_id
    from ${source.circa_os}.inventory_location_detail as a
    where doc_code is not null
          and deleted_at is null
)
,_all as (
select distinct
     a.product_id
    ,a.sku_code
    ,a.lot_date
    ,a.tax_rate
    ,doc_code
    ,a.cost_price_include_tax
    ,a.location_id
    ,product_lot_date
    ,a.product_lot_date_vat_client_id
    ,SUM(a.on_hand_quantity) AS on_hand_quantity
    ,b.pos_id
    ,location_type
    ,b.name as location_name
    ,a.client_id
from inventory as a
left join ${source.ref}.circa_pos_profile p on a.client_id = p.client_id  and a.pos_id = p.id
left join ${source.circa_os}.inventory_location as b on a.location_id = b.id  and b.pos_id = p.id and p.client_id = b.client_id
where p.id is not null
group by all
)
Select i.*
       ,concat(i.product_id, "_", i.client_id) as product_client_id
       ,eo.name as owner_name
       ,o.sale_order_number as SO_code
       ,o.distributor_id
from  _all i 
left join ${source.circa_os}.order_purchase_order o on i.doc_code = o.code and i.client_id = o.client_id
left join ${source.circa_os}.entity_owner eo on o.owner_id = eo.id and i.client_id = eo.client_id