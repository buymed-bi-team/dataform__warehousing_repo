config {
    type: "table",
    description: `Circa OS Transaction order item detail 
                  PIC: huyen.ngo; 
                  model_type: Table ;
                  schedule: At minute 20 every hour`,
    tags:  ["custom_1h_past23"],
    name: "cos_fact_order_item",
    columns: {
    
    }
    
    ,bigquery: {
        partitionBy: "created_date"
    }
}



WITH base_unit_selection AS (
    SELECT DISTINCT
         product_id
        ,client_id
        ,base_unit
        ,ROW_NUMBER() OVER (PARTITION BY product_id, client_id ORDER BY COUNT(*) DESC) AS rn
    FROM ${source.ref}.cos_product_convert_base_unit
    GROUP BY product_id, client_id, base_unit
)
,base_unit AS (
    SELECT a.*
    FROM ${source.ref}.cos_product_convert_base_unit a
    LEFT JOIN base_unit_selection b 
        ON a.product_id = b.product_id
        AND a.client_id = b.client_id
        AND a.base_unit = b.base_unit
    WHERE b.rn = 1
)
,cte_os AS (
    SELECT DISTINCT
         COALESCE(DATE(DATETIME_ADD(o.completed_at, INTERVAL 7 HOUR)), DATE(DATETIME_ADD(o.updated_at, INTERVAL 7 HOUR))) AS completed_date
        ,DATE(DATETIME_ADD(o.created_at, INTERVAL 7 HOUR)) AS created_date
        ,oi.order_id
        ,oi.product_id
        ,oi.sku_code
        ,al.item_ref_id
         ,COALESCE(
                CASE 
                    WHEN oi.product_id = 1 THEN oi.quantity
                    ELSE ROUND(
                        oi.quantity * (
                            al.base_quantity / NULLIF(SUM(al.base_quantity) OVER (PARTITION BY oi.id), 0)
                        ),
                        6
                    )
                END,
                oi.quantity      
                  ) AS quantity
        ,oi.unit
        ,oi.unit_price
        ,CASE WHEN o.channel = 'O2O' THEN  ol.origin_price - ol.price ELSE oi.discount_amount END AS discount_amount
        ,CASE WHEN o.channel <> 'O2O' THEN (oi.discount_amount + oi.unit_price) 
              ELSE ol.origin_price END AS unit_price_before_discount
        ,system_price
        --,oi.discount_amount + oi.unit_price AS unit_price_before_discount
        ,oi.lot_date
         ,CASE 
               WHEN oi.product_id = 1 THEN 1
               ELSE ROUND(
                   COALESCE(
                       oi.quantity * cv.convert_rate * (
                           al.base_quantity / NULLIF(SUM(al.base_quantity) OVER (PARTITION BY oi.id), 0)
                       ),
                       oi.quantity * cv.convert_rate
                   ),
                   6
               )
            END AS base_quantity
        ,oi.tax_rate
        ,oi.product_id || '_' || oi.lot_date || '_'  || o.client_id AS product_lot_date_vat_client_id
        ,oi.sku_code || '_' || oi.lot_date || '_' || oi.tax_rate AS sku_lotdate_vat
        ,al.cost_price_include_tax AS base_unit_cost_price
        ,eo.name AS owner_name
        ,po.code AS po_code
        ,po.sale_order_number
        ,po.fulfillment_method
        ,po.distributor_id
        ,e.name AS employee_name
        ,oi.order_apply_combo_id
        ,CASE WHEN o.channel <> 'O2O' THEN oi.promotion_event_code
              ELSE ol.deal_code END AS promotion_event_code
        , CASE WHEN o.channel <> 'O2O' THEN d.deal_name
               ELSE ol.deal_name END AS deal_name
        ,CASE WHEN o.channel <> 'O2O' THEN d.campaign_code
                ELSE ol.campaign_code END AS campaign_code
        ,CASE WHEN o.channel <> 'O2O' THEN d.campaign_name
               ELSE ol.campaign_name END AS campaign_name
        ,o.client_id
        ,gift_code
        ,tag_list
        ,CASE WHEN tag_list like '%deal_1000%' AND unit_price = 1000 THEN TRUE ELSE FALSE END AS is_deal1k 
        ,al.location_detail_id
    FROM ${source.circa_os}.order_order o
    LEFT JOIN ${source.circa_os}.order_order_item oi ON o.id = oi.order_id
    LEFT JOIN base_unit cv ON o.client_id = cv.client_id AND oi.product_id = cv.product_id AND oi.unit = cv.convert_unit
    LEFT JOIN ${source.circa_os}.inventory_allocation al ON oi.id = al.item_ref_id AND o.client_id = al.client_id AND o.code = ref_number
    LEFT JOIN ${source.circa_os}.inventory_location_detail ld ON al.location_detail_id = ld.id AND o.client_id = ld.client_id
    LEFT JOIN ${source.circa_os}.order_purchase_order po ON ld.doc_code = po.code AND o.client_id = po.client_id
    LEFT JOIN ${source.circa_os}.entity_owner eo ON po.owner_id = eo.id AND eo.client_id = o.client_id
    LEFT JOIN ${source.circa_os}.entity_entity e ON o.updated_by = e.id AND o.client_id = e.client_id
    LEFT JOIN (SELECT DISTINCT deal_code, deal_name ,campaign_code ,campaign_name, client_id FROM ${source.ref}.dim_promotion_event_circa ) d ON oi.promotion_event_code = d.deal_code AND o.client_id = d.client_id -- AND o.pos_id = d.pos_id
    LEFT JOIN ${source.ref}.circa_online_order_item ol ON o.reference_order_in_platform = ol.order_code AND oi.product_id = ol.product_id AND oi.unit = ol.unit --AND oi.lot_date = ol.lot_date AND oi.sku_code = ol.sku_code
    WHERE o.status NOT IN ('PENDING', 'CANCELED')
)
,order_item_with_total AS (
    SELECT 
         i.*
        ,CONCAT(i.product_id, "_", i.client_id) AS product_client_id
        ,SUM(i.quantity) OVER (PARTITION BY i.order_id, i.product_id, i.order_id, i.product_id,lot_date,sku_code, unit) AS total_quantity
    FROM cte_os i
)
,return_data AS (
    SELECT 
         rt.order_id
        ,rt.product_id
        ,rt.unit
        ,rt.lot_date
        ,rt.sku_code
        ,rt.quantity AS rt_quantity
        ,rt.base_quantity AS rt_base_quantity
    FROM ${source.ref}.cos_return_completed_detail rt
)
,final AS (
    SELECT 
         o.*
        ,rd.rt_quantity * (o.quantity / o.total_quantity) AS qty_rt
        ,rd.rt_base_quantity * (o.quantity / o.total_quantity) AS base_qty_rt
    FROM order_item_with_total o
    LEFT JOIN return_data rd 
        ON o.order_id = rd.order_id 
        AND o.product_id = rd.product_id 
        AND o.unit = rd.unit 
        AND o.lot_date = rd.lot_date
        AND o.sku_code = rd.sku_code
)
SELECT DISTINCT
     TIMESTAMP_ADD(CURRENT_TIMESTAMP(), INTERVAL 7 HOUR) AS transformed_at
    ,fo.order_code
    ,i.*
    ,base_unit_cost_price * convert_rate AS unit_cost_price
    ,convert_rate
FROM final i
LEFT JOIN ${ref('cos_fact_order')} fo ON i.order_id = fo.order_id
LEFT JOIN base_unit cv ON cv.product_id = i.product_id AND cv.convert_unit = i.unit AND i.client_id = cv.client_id
WHERE fo.order_id IS NOT NULL

